{{!--
  Sync Calendar — main template (PR 2: read + write).

  Receives the view-model from SyncCalendarApplication._prepareContext().
  Top-level mode branches:
    - degraded: Calendaria missing / incompatible / no active calendar
    - viewMode=year:  3-pane year overview (month cards in center)
    - viewMode=month: 3-pane month day-grid (day cells in center)
  Right-pane (rail-right) renders the day inspector OR the note form
  depending on `formView`.

  Actions are wired via data-action="..." attributes that ApplicationV2
  binds to the actions map in DEFAULT_OPTIONS. Form-field inputs use
  data-form-field="..." attributes that the application's #wireFormInputs
  hook (in _onRender) listens to.

  Single-root wrapper (`<div class="sync-calendar-root">`) is required:
  ApplicationV2's `_parsePartHTML` rejects any PARTS template that emits
  more than one root HTML element across any branch of any conditional
  ("Template part 'body' must render a single HTML element"). The
  `else` branch below has three siblings (header + main + footer) and
  must be wrapped. See F-PR3-4 in `.ai.md` and the CI guard at
  `tools/test-template-roots.mjs`.
--}}

<div class="sync-calendar-root">
{{#if degraded}}
  <section class="sync-calendar-degraded">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <p>{{localize degradedReason}}</p>
    {{#if calendariaVersion}}
      <p class="meta">{{localize "CHRONICLE.SyncCalendar.CalendariaVersion"}}: {{calendariaVersion}}</p>
    {{/if}}
    <button type="button" class="footer-tool" data-action="copy-diagnostics"
            title="{{localize "CHRONICLE.SyncCalendar.Diagnostics.Hint"}}">
      <i class="fa-solid fa-bug"></i> {{localize "CHRONICLE.SyncCalendar.Diagnostics.Button"}}
    </button>
    {{#if importBanner}}
      {{!-- Import banner shown even in degraded state if Chronicle has no calendar --}}
      <div class="import-banner">
        {{#if (eq importBanner.state "probing")}}
          <p class="import-probing">{{localize "CHRONICLE.SyncCalendar.Import.Probing"}}</p>
        {{else if (eq importBanner.state "absent")}}
          <h3>{{localize "CHRONICLE.SyncCalendar.Import.HeaderAbsent"}}</h3>
          <p class="import-hint">{{localize "CHRONICLE.SyncCalendar.Import.HintAbsent"}}</p>
          {{#if importBanner.calendars.length}}
            <ul class="import-calendar-list">
              {{#each importBanner.calendars as |cal|}}
                <li class="import-calendar-row">
                  <div class="import-cal-summary">
                    <span class="import-cal-name">{{cal.name}}</span>
                    <span class="import-cal-stats">{{cal.daysPerYear}} {{localize "CHRONICLE.SyncCalendar.DaysSuffix"}} · {{cal.monthCount}} mo · {{cal.weekdayCount}} wk · {{cal.moonCount}} moons</span>
                    {{#if cal.skipNotice}}<span class="import-cal-skips">{{cal.skipNotice}}</span>{{/if}}
                  </div>
                  <button type="button" class="import-btn"
                          data-action="import-calendar"
                          data-calendar-id="{{cal.id}}"
                          {{#if cal.busy}}disabled{{/if}}>
                    {{#if cal.busy}}
                      <i class="fa-solid fa-circle-notch fa-spin"></i> {{localize "CHRONICLE.SyncCalendar.Import.InProgress"}}
                    {{else}}
                      <i class="fa-solid fa-download"></i> {{localize "CHRONICLE.SyncCalendar.Import.Button"}}
                    {{/if}}
                  </button>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="import-empty">{{localize "CHRONICLE.SyncCalendar.Import.NoCalendariaCalendars"}}</p>
          {{/if}}
        {{else if (eq importBanner.state "no-create-api")}}
          <p class="import-too-old"><i class="fa-solid fa-circle-info"></i> {{localize "CHRONICLE.SyncCalendar.Import.ChronicleTooOld"}}</p>
        {{else if (eq importBanner.state "unreachable")}}
          <p class="import-unreachable"><i class="fa-solid fa-plug-circle-xmark"></i> {{localize "CHRONICLE.SyncCalendar.Import.Unreachable"}}</p>
        {{else if (eq importBanner.state "auth")}}
          <p class="import-auth"><i class="fa-solid fa-key"></i> {{localize "CHRONICLE.SyncCalendar.Import.NotAuthorized"}}</p>
        {{/if}}
        {{#if importBanner.lastResult}}
          <p class="import-last-result {{#if importBanner.lastResult.ok}}ok{{else}}err{{/if}}">
            {{localize importBanner.lastResult.key}}
            {{#if importBanner.lastResult.detail}} — {{importBanner.lastResult.detail}}{{/if}}
          </p>
        {{/if}}
        <button type="button" class="import-recheck" data-action="recheck-chronicle">
          <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.SyncCalendar.Import.Recheck"}}
        </button>
      </div>
    {{/if}}
  </section>
{{else}}
  <header class="sync-calendar-header">
    <div class="title-block">
      <h2 class="cal-name">{{cal.name}}</h2>
      {{#if cal.description}}
        <p class="cal-description">{{cal.description}}</p>
      {{/if}}
    </div>
    <div class="header-meta">
      <span class="meta-pill">
        <i class="fa-solid fa-calendar-day"></i>
        {{localize "CHRONICLE.SyncCalendar.SelectedDate"}}:
        {{selectedDate.day}} {{dayDetail.monthName}}, {{selectedDate.year}}
      </span>
      {{#if dayDetail.season}}
        <span class="meta-pill" style="border-color: {{dayDetail.season.color}};">
          <i class="fa-solid fa-leaf"></i> {{dayDetail.season.name}}
        </span>
      {{/if}}
      {{#if findingTotal}}
        <span class="meta-pill warn">
          <i class="fa-solid fa-circle-exclamation"></i>
          {{findingTotal}} {{localize "CHRONICLE.SyncCalendar.Findings.Pill"}}
        </span>
      {{/if}}
      {{#if (eq viewMode "month")}}
        <button type="button" class="header-action" data-action="back-to-year">
          <i class="fa-solid fa-arrow-left"></i>
          {{localize "CHRONICLE.SyncCalendar.BackToYear"}}
        </button>
      {{/if}}
      <button type="button" class="header-action" data-action="jump-today">
        <i class="fa-solid fa-bullseye"></i>
        {{localize "CHRONICLE.SyncCalendar.JumpToday"}}
      </button>
    </div>
  </header>

  {{#if importBanner}}
    {{!-- Non-degraded but Chronicle still has no calendar — surface the
         import banner above the main grid so the editor stays usable
         for browsing while the operator decides which calendar to import. --}}
    <section class="import-banner import-banner-inline">
      {{#if (eq importBanner.state "probing")}}
        <p class="import-probing">{{localize "CHRONICLE.SyncCalendar.Import.Probing"}}</p>
      {{else if (eq importBanner.state "absent")}}
        <h3>{{localize "CHRONICLE.SyncCalendar.Import.HeaderAbsent"}}</h3>
        <p class="import-hint">{{localize "CHRONICLE.SyncCalendar.Import.HintAbsent"}}</p>
        {{#if importBanner.calendars.length}}
          <ul class="import-calendar-list">
            {{#each importBanner.calendars as |cal|}}
              <li class="import-calendar-row">
                <div class="import-cal-summary">
                  <span class="import-cal-name">{{cal.name}}</span>
                  <span class="import-cal-stats">{{cal.daysPerYear}} {{localize "CHRONICLE.SyncCalendar.DaysSuffix"}} · {{cal.monthCount}} mo · {{cal.weekdayCount}} wk · {{cal.moonCount}} moons</span>
                  {{#if cal.skipNotice}}<span class="import-cal-skips">{{cal.skipNotice}}</span>{{/if}}
                </div>
                <button type="button" class="import-btn"
                        data-action="import-calendar"
                        data-calendar-id="{{cal.id}}"
                        {{#if cal.busy}}disabled{{/if}}>
                  {{#if cal.busy}}
                    <i class="fa-solid fa-circle-notch fa-spin"></i> {{localize "CHRONICLE.SyncCalendar.Import.InProgress"}}
                  {{else}}
                    <i class="fa-solid fa-download"></i> {{localize "CHRONICLE.SyncCalendar.Import.Button"}}
                  {{/if}}
                </button>
              </li>
            {{/each}}
          </ul>
        {{/if}}
      {{else if (eq importBanner.state "no-create-api")}}
        <p class="import-too-old"><i class="fa-solid fa-circle-info"></i> {{localize "CHRONICLE.SyncCalendar.Import.ChronicleTooOld"}}</p>
      {{else if (eq importBanner.state "unreachable")}}
        <p class="import-unreachable"><i class="fa-solid fa-plug-circle-xmark"></i> {{localize "CHRONICLE.SyncCalendar.Import.Unreachable"}}</p>
      {{else if (eq importBanner.state "auth")}}
        <p class="import-auth"><i class="fa-solid fa-key"></i> {{localize "CHRONICLE.SyncCalendar.Import.NotAuthorized"}}</p>
      {{/if}}
      {{#if importBanner.lastResult}}
        <p class="import-last-result {{#if importBanner.lastResult.ok}}ok{{else}}err{{/if}}">
          {{localize importBanner.lastResult.key}}
          {{#if importBanner.lastResult.detail}} — {{importBanner.lastResult.detail}}{{/if}}
        </p>
      {{/if}}
    </section>
  {{/if}}

  <main class="sync-calendar-grid">

    {{!-- LEFT RAIL: year navigator + structure summary + validation panel --}}
    <aside class="rail rail-left">
      <section class="rail-section">
        <h3>{{localize "CHRONICLE.SyncCalendar.Rail.Year"}}</h3>
        <div class="year-nav">
          <span class="year-current">{{localize "CHRONICLE.SyncCalendar.YearLabel"}} {{selectedDate.year}}</span>
        </div>
        <ol class="month-nav">
          {{#each yearOverview as |m|}}
            <li class="{{#if m.isSelected}}selected{{/if}}">
              <button type="button"
                      data-action="goto-month"
                      data-month="{{m.ordinal}}"
                      title="{{m.name}}">
                <span class="month-ord">{{m.ordinal}}</span>
                <span class="month-name">{{m.name}}</span>
                {{#if m.noteCount}}<span class="badge">{{m.noteCount}}</span>{{/if}}
                {{#if m.festivalCount}}<span class="badge festival">★ {{m.festivalCount}}</span>{{/if}}
              </button>
            </li>
          {{/each}}
        </ol>
      </section>

      <section class="rail-section">
        <h3>{{localize "CHRONICLE.SyncCalendar.Rail.Structure"}}</h3>
        <ul class="structure-list">
          <li><button type="button" data-action="focus-target" data-focus="months">    {{localize "CHRONICLE.SyncCalendar.Structure.Months"}}    <span class="count">{{structureCounts.months}}</span></button></li>
          <li><button type="button" data-action="focus-target" data-focus="weekdays">  {{localize "CHRONICLE.SyncCalendar.Structure.Weekdays"}}  <span class="count">{{structureCounts.weekdays}}</span></button></li>
          <li><button type="button" data-action="focus-target" data-focus="seasons">   {{localize "CHRONICLE.SyncCalendar.Structure.Seasons"}}   <span class="count">{{structureCounts.seasons}}</span></button></li>
          <li><button type="button" data-action="focus-target" data-focus="moons">     {{localize "CHRONICLE.SyncCalendar.Structure.Moons"}}     <span class="count">{{structureCounts.moons}}</span></button></li>
          <li><button type="button" data-action="focus-target" data-focus="eras">      {{localize "CHRONICLE.SyncCalendar.Structure.Eras"}}      <span class="count">{{structureCounts.eras}}</span></button></li>
          <li><button type="button" data-action="focus-target" data-focus="festivals"> {{localize "CHRONICLE.SyncCalendar.Structure.Festivals"}} <span class="count {{#unless structureCounts.festivals}}empty{{/unless}}">{{structureCounts.festivals}}</span></button></li>
          <li><button type="button" data-action="focus-target" data-focus="cycles">    {{localize "CHRONICLE.SyncCalendar.Structure.Cycles"}}    <span class="count {{#unless structureCounts.cycles}}empty{{/unless}}">{{structureCounts.cycles}}</span></button></li>
          <li><button type="button" data-action="focus-target" data-focus="weather">   {{localize "CHRONICLE.SyncCalendar.Structure.WeatherZones"}} <span class="count {{#unless structureCounts.weatherZones}}empty{{/unless}}">{{structureCounts.weatherZones}}</span></button></li>
        </ul>
        <p class="rail-meta">{{localize "CHRONICLE.SyncCalendar.Structure.ReadOnlyHint"}}</p>
      </section>

      <section class="rail-section">
        <h3>
          {{localize "CHRONICLE.SyncCalendar.Rail.Validation"}}
          {{#if findingTotal}}<span class="badge warn">{{findingTotal}}</span>{{/if}}
        </h3>
        {{#if findingTotal}}
          <ul class="findings">
            {{#each findings as |f|}}
              <li class="finding {{f.severityClass}}">
                <button type="button" data-action="focus-target" data-focus="{{f.focusTarget}}" class="finding-button">
                  <span class="finding-icon" aria-hidden="true">
                    {{#if (eq f.severity "error")}}<i class="fa-solid fa-circle-xmark"></i>{{/if}}
                    {{#if (eq f.severity "warning")}}<i class="fa-solid fa-triangle-exclamation"></i>{{/if}}
                    {{#if (eq f.severity "info")}}<i class="fa-solid fa-circle-info"></i>{{/if}}
                  </span>
                  <span class="finding-body">
                    <span class="finding-message">{{f.message}}</span>
                    {{#if f.fixHint}}<span class="finding-hint">{{f.fixHint}}</span>{{/if}}
                    <span class="finding-code">{{f.code}}</span>
                  </span>
                </button>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="rail-meta empty-state">{{localize "CHRONICLE.SyncCalendar.Findings.None"}}</p>
        {{/if}}
      </section>
    </aside>

    {{!-- CENTER: year overview OR month day-grid --}}
    <section class="pane pane-center">
      {{#if (eq viewMode "month")}}
        {{!-- MONTH VIEW: day-grid (click + drag-select) --}}
        <div class="pane-title-row">
          <h3>{{monthDetail.monthName}} ({{monthDetail.daysInMonth}} {{localize "CHRONICLE.SyncCalendar.DaysSuffix"}})</h3>
          <span class="pane-meta">{{localize "CHRONICLE.SyncCalendar.MonthViewHint"}}</span>
        </div>
        <div class="month-grid">
          {{#each monthDetail.days as |d|}}
            <button type="button"
                    class="day-cell {{#if d.isSelected}}selected{{/if}} {{#if d.isFestival}}festival{{/if}} {{#if d.noteCount}}has-notes{{/if}}"
                    data-action="select-day"
                    data-day="{{d.day}}"
                    title="{{d.day}}">
              <span class="day-number">{{d.day}}</span>
              {{#if d.noteCount}}<span class="day-note-count">{{d.noteCount}}</span>{{/if}}
              {{#if d.isFestival}}<span class="day-festival">★</span>{{/if}}
            </button>
          {{/each}}
        </div>
        {{#if moonStrip}}
          <div class="moon-strip-block">
            <h4 class="moon-strip-heading">
              <i class="fa-solid fa-moon"></i> {{localize "CHRONICLE.SyncCalendar.MoonStrip.Heading"}}
            </h4>
            {{#each moonStrip.moons as |m|}}
              <div class="moon-strip-row" title="{{m.name}}">
                <span class="moon-strip-label" style="color: {{m.color}};">{{m.name}}{{#if m.isRandomized}} <i class="fa-solid fa-dice" title="{{localize "CHRONICLE.SyncCalendar.MoonStrip.RandomizedTooltip"}}"></i>{{/if}}</span>
                <div class="moon-strip" data-strip-days="{{monthDetail.daysInMonth}}" data-moon-index="{{m.index}}">
                  {{#each m.days as |d|}}
                    <span class="moon-day {{#if d.isFull}}is-full{{/if}} {{#if d.isNew}}is-new{{/if}}"
                          title="{{../m.name}} — day {{d.day}}: {{d.phaseName}}"
                          style="background:{{../m.color}}; opacity:{{d.position}};"></span>
                  {{/each}}
                </div>
              </div>
            {{/each}}
            {{#if moonStrip.convergenceDays.length}}
              <p class="moon-strip-convergence">
                <i class="fa-solid fa-star"></i>
                {{localize "CHRONICLE.SyncCalendar.MoonStrip.ConvergenceLabel"}}
                {{#each moonStrip.convergenceDays as |d|}}{{d}}{{#unless @last}}, {{/unless}}{{/each}}
              </p>
            {{/if}}
            <p class="moon-strip-hint">{{localize "CHRONICLE.SyncCalendar.MoonStrip.ClickHint"}}</p>
          </div>
        {{/if}}
        <p class="pane-footnote">{{localize "CHRONICLE.SyncCalendar.MonthViewFootnote"}}</p>
      {{else}}
        {{!-- YEAR VIEW: month cards --}}
        <div class="pane-title-row">
          <h3>{{localize "CHRONICLE.SyncCalendar.YearOverview"}}</h3>
          <span class="pane-meta">{{localize "CHRONICLE.SyncCalendar.YearOverviewHint"}}</span>
        </div>
        <div class="year-grid">
          {{#each yearOverview as |m|}}
            <article class="year-month {{#if m.isSelected}}selected{{/if}}">
              <header class="month-header">
                <span class="month-ord">{{m.ordinal}}.</span>
                <span class="month-name">{{m.name}}</span>
                {{#if m.abbreviation}}<span class="month-abbr">{{m.abbreviation}}</span>{{/if}}
              </header>
              <div class="month-meta">
                <span>{{m.days}} {{localize "CHRONICLE.SyncCalendar.DaysSuffix"}}</span>
                {{#if m.noteCount}}<span class="badge">{{m.noteCount}} {{localize "CHRONICLE.SyncCalendar.NotesSuffix"}}</span>{{/if}}
                {{#if m.festivalCount}}<span class="badge festival">★ {{m.festivalCount}}</span>{{/if}}
              </div>
              <button type="button" class="month-select"
                      data-action="goto-month"
                      data-month="{{m.ordinal}}">
                {{localize "CHRONICLE.SyncCalendar.ViewMonth"}}
              </button>
            </article>
          {{/each}}
        </div>
        <p class="pane-footnote">{{localize "CHRONICLE.SyncCalendar.YearOverviewFootnote"}}</p>
      {{/if}}
    </section>

    {{!-- RIGHT: day inspector OR note form --}}
    <aside class="rail rail-right">
      {{#if formView}}
        <section class="rail-section note-form" aria-label="Event form">
          <h3>
            {{#if (eq formView.mode "edit")}}
              {{localize "CHRONICLE.SyncCalendar.NoteForm.HeaderEdit"}}
            {{else}}
              {{localize "CHRONICLE.SyncCalendar.NoteForm.HeaderAdd"}}
            {{/if}}
          </h3>

          {{#if formView.errors.length}}
            <ul class="form-errors">
              {{#each formView.errors as |e|}}
                <li><i class="fa-solid fa-circle-exclamation"></i> {{localize e}}</li>
              {{/each}}
            </ul>
          {{/if}}

          <label class="form-row">
            <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Name"}}</span>
            <input type="text"
                   data-form-field="name"
                   value="{{formView.data.name}}"
                   placeholder="{{localize "CHRONICLE.SyncCalendar.NoteForm.NamePlaceholder"}}"
                   {{#if formView.busy}}disabled{{/if}} />
          </label>

          <label class="form-row">
            <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Content"}}</span>
            <textarea data-form-field="content"
                      rows="4"
                      placeholder="{{localize "CHRONICLE.SyncCalendar.NoteForm.ContentPlaceholder"}}"
                      {{#if formView.busy}}disabled{{/if}}>{{formView.data.content}}</textarea>
          </label>

          <fieldset class="form-fieldset">
            <legend>{{localize "CHRONICLE.SyncCalendar.NoteForm.StartDate"}}</legend>
            <div class="form-row inline">
              <label>
                <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Year"}}</span>
                <input type="number" data-form-field="year"  value="{{formView.data.year}}"  {{#if formView.busy}}disabled{{/if}} />
              </label>
              <label>
                <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Month"}}</span>
                <input type="number" data-form-field="month" value="{{formView.data.month}}" min="1" {{#if formView.busy}}disabled{{/if}} />
              </label>
              <label>
                <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Day"}}</span>
                <input type="number" data-form-field="day"   value="{{formView.data.day}}"   min="1" {{#if formView.busy}}disabled{{/if}} />
              </label>
            </div>
          </fieldset>

          <fieldset class="form-fieldset">
            <legend>{{localize "CHRONICLE.SyncCalendar.NoteForm.EndDate"}}</legend>
            <p class="form-hint">{{localize "CHRONICLE.SyncCalendar.NoteForm.EndDateHint"}}</p>
            <div class="form-row inline">
              <label>
                <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Year"}}</span>
                <input type="number" data-form-field="endYear"  value="{{formView.data.endYear}}"  {{#if formView.busy}}disabled{{/if}} />
              </label>
              <label>
                <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Month"}}</span>
                <input type="number" data-form-field="endMonth" value="{{formView.data.endMonth}}" min="1" {{#if formView.busy}}disabled{{/if}} />
              </label>
              <label>
                <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Day"}}</span>
                <input type="number" data-form-field="endDay"   value="{{formView.data.endDay}}"   min="1" {{#if formView.busy}}disabled{{/if}} />
              </label>
            </div>
          </fieldset>

          <label class="form-row checkbox-row">
            <input type="checkbox"
                   data-form-field="allDay"
                   {{#if formView.data.allDay}}checked{{/if}}
                   {{#if formView.busy}}disabled{{/if}} />
            <span>{{localize "CHRONICLE.SyncCalendar.NoteForm.AllDay"}}</span>
          </label>

          {{#unless formView.data.allDay}}
            <fieldset class="form-fieldset">
              <legend>{{localize "CHRONICLE.SyncCalendar.NoteForm.Time"}}</legend>
              <div class="form-row inline">
                <label>
                  <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Hour"}}</span>
                  <input type="number" data-form-field="hour"   value="{{formView.data.hour}}"   min="0" max="23" {{#if formView.busy}}disabled{{/if}} />
                </label>
                <label>
                  <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Minute"}}</span>
                  <input type="number" data-form-field="minute" value="{{formView.data.minute}}" min="0" max="59" {{#if formView.busy}}disabled{{/if}} />
                </label>
                <label>
                  <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.EndHour"}}</span>
                  <input type="number" data-form-field="endHour"   value="{{formView.data.endHour}}"   min="0" max="23" {{#if formView.busy}}disabled{{/if}} />
                </label>
                <label>
                  <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.EndMinute"}}</span>
                  <input type="number" data-form-field="endMinute" value="{{formView.data.endMinute}}" min="0" max="59" {{#if formView.busy}}disabled{{/if}} />
                </label>
              </div>
            </fieldset>
          {{/unless}}

          <label class="form-row">
            <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Visibility"}}</span>
            <select data-form-field="visibility" {{#if formView.busy}}disabled{{/if}}>
              {{#each formView.visibilityOptions as |o|}}
                <option value="{{o.value}}" {{#if (eq ../formView.data.visibility o.value)}}selected{{/if}}>{{localize o.labelKey}}</option>
              {{/each}}
            </select>
          </label>

          <label class="form-row">
            <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.DisplayStyle"}}</span>
            <select data-form-field="displayStyle" {{#if formView.busy}}disabled{{/if}}>
              {{#each formView.displayStyleOptions as |o|}}
                <option value="{{o.value}}" {{#if (eq ../formView.data.displayStyle o.value)}}selected{{/if}}>{{localize o.labelKey}}</option>
              {{/each}}
            </select>
          </label>

          <label class="form-row">
            <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Icon"}}</span>
            <input type="text" data-form-field="icon" value="{{formView.data.icon}}"
                   placeholder="fas fa-star" {{#if formView.busy}}disabled{{/if}} />
          </label>

          <label class="form-row">
            <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Color"}}</span>
            <input type="text" data-form-field="color" value="{{formView.data.color}}"
                   placeholder="#abcdef" {{#if formView.busy}}disabled{{/if}} />
          </label>

          <label class="form-row">
            <span class="form-label">{{localize "CHRONICLE.SyncCalendar.NoteForm.Categories"}}</span>
            <input type="text" data-form-field="categories"
                   value="{{formView.categoriesText}}"
                   placeholder="{{localize "CHRONICLE.SyncCalendar.NoteForm.CategoriesPlaceholder"}}"
                   {{#if formView.busy}}disabled{{/if}} />
            <p class="form-hint">{{localize "CHRONICLE.SyncCalendar.NoteForm.CategoriesHint"}}</p>
          </label>

          <fieldset class="form-fieldset recurrence-fieldset">
            <legend>{{localize "CHRONICLE.SyncCalendar.Recurrence.Legend"}}</legend>
            <p class="form-hint">{{localize "CHRONICLE.SyncCalendar.Recurrence.Hint"}}</p>
            {{#if formView.recurrence.hasTree}}
              <div class="recurrence-summary">
                <span class="recurrence-summary-label">{{localize "CHRONICLE.SyncCalendar.Recurrence.CurrentSummaryLabel"}}</span>
                <code>{{formView.recurrence.summary}}</code>
              </div>
              {{#if formView.recurrence.errors.length}}
                <ul class="form-errors">
                  {{#each formView.recurrence.errors as |e|}}<li><i class="fa-solid fa-circle-exclamation"></i> {{localize e}}</li>{{/each}}
                </ul>
              {{/if}}
              <button type="button" class="recurrence-clear" data-action="clear-recurrence" {{#if formView.busy}}disabled{{/if}}>
                <i class="fa-solid fa-eraser"></i> {{localize "CHRONICLE.SyncCalendar.Recurrence.Clear"}}
              </button>
            {{else}}
              <p class="recurrence-empty">{{localize "CHRONICLE.SyncCalendar.Recurrence.NoneSelected"}}</p>
            {{/if}}
            <div class="recurrence-presets">
              {{#each formView.recurrence.presets as |p|}}
                <button type="button" class="recurrence-preset-btn"
                        data-action="apply-recurrence-preset"
                        data-preset="{{p.id}}"
                        data-params="{{json p.paramsTemplate}}"
                        {{#if ../formView.busy}}disabled{{/if}}>
                  {{localize p.labelKey}}{{#if p.extraLabel}} — {{p.extraLabel}}{{/if}}
                </button>
              {{/each}}
            </div>
            <p class="recurrence-advanced-hint">{{localize "CHRONICLE.SyncCalendar.Recurrence.AdvancedHint"}}</p>
          </fieldset>

          <div class="form-actions">
            <button type="button" class="form-save" data-action="save-event" {{#if formView.busy}}disabled{{/if}}>
              <i class="fa-solid fa-floppy-disk"></i>
              {{#if (eq formView.mode "edit")}}{{localize "CHRONICLE.SyncCalendar.NoteForm.Save"}}{{else}}{{localize "CHRONICLE.SyncCalendar.NoteForm.Create"}}{{/if}}
            </button>
            <button type="button" class="form-cancel" data-action="cancel-form" {{#if formView.busy}}disabled{{/if}}>
              {{localize "CHRONICLE.SyncCalendar.NoteForm.Cancel"}}
            </button>
            {{#if (eq formView.mode "edit")}}
              <button type="button" class="form-delete" data-action="delete-event" data-note-id="{{formView.noteId}}" {{#if formView.busy}}disabled{{/if}}>
                <i class="fa-solid fa-trash"></i>
                {{localize "CHRONICLE.SyncCalendar.NoteForm.Delete"}}
              </button>
            {{/if}}
          </div>
        </section>
      {{else}}
        <section class="rail-section">
          <h3>{{localize "CHRONICLE.SyncCalendar.Rail.SelectedDay"}}</h3>
          <p class="day-headline">
            {{dayDetail.day}} {{dayDetail.monthName}}, {{dayDetail.year}}
          </p>

          <div class="day-block">
            <h4>{{localize "CHRONICLE.SyncCalendar.Day.Events"}} ({{dayDetail.notes.length}})</h4>
            {{#if dayDetail.notes.length}}
              <ul class="event-list">
                {{#each dayDetail.notes as |n|}}
                  <li class="event-row">
                    {{#if n.icon}}<i class="event-icon {{n.icon}}" aria-hidden="true"></i>{{/if}}
                    <span class="event-name" {{#if n.color}}style="border-left-color: {{n.color}};"{{/if}}>{{n.name}}</span>
                    {{#if n.visibility}}<span class="event-visibility">{{n.visibility}}</span>{{/if}}
                    {{#if n.id}}
                      <button type="button" class="event-edit-btn" data-action="edit-event" data-note-id="{{n.id}}" title="{{localize "CHRONICLE.SyncCalendar.NoteForm.EditTooltip"}}">
                        <i class="fa-solid fa-pen"></i>
                      </button>
                    {{/if}}
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p class="rail-meta empty-state">{{localize "CHRONICLE.SyncCalendar.Day.NoEvents"}}</p>
            {{/if}}
            <button type="button" class="add-event-btn" data-action="add-event">
              <i class="fa-solid fa-plus"></i>
              {{localize "CHRONICLE.SyncCalendar.AddEvent.Label"}}
            </button>
          </div>

          <div class="day-block">
            <h4>{{localize "CHRONICLE.SyncCalendar.Day.Moons"}}</h4>
            {{#if dayDetail.moonPhases.length}}
              <ul class="moon-list">
                {{#each dayDetail.moonPhases as |p|}}
                  <li class="moon-row" {{#if p.color}}style="border-left-color: {{p.color}};"{{/if}}>
                    <span class="moon-name">{{p.moonName}}</span>
                    <span class="moon-phase">{{p.phaseName}}</span>
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p class="rail-meta empty-state">{{localize "CHRONICLE.SyncCalendar.Day.NoMoons"}}</p>
            {{/if}}
          </div>

          <div class="day-block">
            <h4>{{localize "CHRONICLE.SyncCalendar.Day.Weather"}}</h4>
            {{#if dayDetail.weather}}
              <div class="weather-row">
                {{#if dayDetail.weather.icon}}<i class="weather-icon {{dayDetail.weather.icon}}" aria-hidden="true"></i>{{/if}}
                <span class="weather-label">{{dayDetail.weather.label}}</span>
                {{#if dayDetail.weather.temperature}}<span class="weather-temp">{{dayDetail.weather.temperature}}°C</span>{{/if}}
              </div>
              {{#if dayDetail.weather.description}}
                <p class="weather-description">{{dayDetail.weather.description}}</p>
              {{/if}}
            {{else}}
              <p class="rail-meta empty-state">{{localize "CHRONICLE.SyncCalendar.Day.NoWeather"}}</p>
            {{/if}}
          </div>
        </section>
      {{/if}}
    </aside>

  </main>

  <footer class="sync-calendar-footer">
    <div class="footer-toolbar">
      <button type="button" class="footer-tool" data-action="copy-diagnostics"
              title="{{localize "CHRONICLE.SyncCalendar.Diagnostics.Hint"}}">
        <i class="fa-solid fa-bug"></i> {{localize "CHRONICLE.SyncCalendar.Diagnostics.Button"}}
      </button>
      <button type="button" class="footer-tool sync-toggle {{#if syncToggle.excluded}}is-off{{else}}is-on{{/if}}"
              data-action="toggle-calendar-sync"
              title="{{localize "CHRONICLE.SyncCalendar.SyncToggle.Hint"}}">
        {{#if syncToggle.excluded}}
          <i class="fa-solid fa-toggle-off"></i> {{localize "CHRONICLE.SyncCalendar.SyncToggle.LabelOff"}}
        {{else}}
          <i class="fa-solid fa-toggle-on"></i> {{localize "CHRONICLE.SyncCalendar.SyncToggle.LabelOn"}}
        {{/if}}
      </button>
      <button type="button" class="footer-tool danger" data-action="cleanup-calendar-notes"
              title="{{localize "CHRONICLE.SyncCalendar.Cleanup.Hint"}}">
        <i class="fa-solid fa-broom"></i> {{localize "CHRONICLE.SyncCalendar.Cleanup.Button"}}
      </button>
    </div>
    <div class="footer-meta-group">
      <span class="footer-meta">{{localize "CHRONICLE.SyncCalendar.Footer.PR3"}}</span>
      {{#if calendariaVersion}}
        <span class="footer-meta">Calendaria v{{calendariaVersion}}</span>
      {{/if}}
      <span class="footer-meta">schema v{{schemaVersion}}</span>
    </div>
  </footer>
{{/if}}
</div>
