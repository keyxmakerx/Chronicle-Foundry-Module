{{!-- Chronicle Sync's Settings section; also shown on its own before a campaign is connected. --}}
<form class="cs-settings" data-settings-form autocomplete="off">
  <div class="cs-seg cs-settings-seg" role="tablist" aria-label="{{localize "CHRONICLE.Dashboard.Rail.Settings"}}">
    {{#each tabs}}
    <button type="button" role="tab" data-subtab="settings:{{id}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i>{{label}}</button>
    {{/each}}
  </div>

  <div class="cs-panels">
    <section class="cs-panel cs-pane" role="tabpanel" data-subpane="settings:connection">
      <div class="cs-conn">
        <i class="fa-solid fa-globe" aria-hidden="true"></i>
        <div class="cs-conn-who">
          {{#if view.apiUrl}}<b>{{view.apiUrl}}</b>{{else}}<b>{{localize "CHRONICLE.SettingsWindow.NotSetUp"}}</b>{{/if}}
        </div>
        {{#if connected}}
        <span class="cs-pill ok"><span class="cs-dot"></span>{{localize "CHRONICLE.SettingsWindow.Connected"}}</span>
        {{/if}}
      </div>

      <div class="cs-field">
        <label for="cs-connect-line">{{localize "CHRONICLE.SettingsWindow.ConnectLine"}}</label>
        <div class="cs-ctl">
          <input id="cs-connect-line" name="connectLine" type="password" autocomplete="off" spellcheck="false">
          <p class="cs-hint">{{localize "CHRONICLE.SettingsWindow.ConnectLineHint"}}</p>
        </div>
      </div>

      <details class="cs-by-hand">
        <summary><i class="fa-solid fa-chevron-right" aria-hidden="true"></i>{{localize "CHRONICLE.SettingsWindow.ByHand"}}</summary>
        <div class="cs-field">
          <label for="cs-api-url">{{localize "CHRONICLE.SettingsWindow.Address"}}</label>
          <div class="cs-ctl"><input id="cs-api-url" name="apiUrl" type="url" value="{{view.apiUrl}}" placeholder="https://chronicle.example.com" spellcheck="false"></div>
        </div>
        <div class="cs-field">
          <label for="cs-api-key">{{localize "CHRONICLE.SettingsWindow.ApiKey"}}</label>
          <div class="cs-ctl">
            <input id="cs-api-key" name="apiKey" type="password" autocomplete="off" spellcheck="false">
            <p class="cs-hint">{{#if view.hasKey}}{{localize "CHRONICLE.SettingsWindow.ApiKeySaved"}} {{/if}}{{localize "CHRONICLE.SettingsWindow.ApiKeyHint"}}</p>
          </div>
        </div>
        <div class="cs-field">
          <label for="cs-campaign">{{localize "CHRONICLE.SettingsWindow.Campaign"}}</label>
          <div class="cs-ctl"><input id="cs-campaign" name="campaignId" type="text" value="{{view.campaignId}}" spellcheck="false"></div>
        </div>
      </details>

      <div class="cs-field">
        <span class="cs-lab">{{localize "CHRONICLE.SettingsWindow.CheckItWorks"}}</span>
        <div class="cs-ctl">
          <div><button type="button" data-action="testConnection"><i class="fa-solid fa-plug-circle-check" aria-hidden="true"></i>{{localize "CHRONICLE.SettingsWindow.TestConnection"}}</button></div>
          <ul class="cs-steps" data-steps aria-live="polite"></ul>
        </div>
      </div>

      {{!-- On the first-run screen the wizard follows the connection on its own. --}}
      {{#unless firstRun}}
      <div class="cs-field">
        <span class="cs-lab">{{localize "CHRONICLE.SettingsWindow.StartImport"}}</span>
        <div class="cs-ctl">
          <div><button type="button" data-action="startImport"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>{{localize "CHRONICLE.Wizard.OpenWizard"}}</button></div>
          <p class="cs-hint">{{localize "CHRONICLE.Wizard.Hint"}}</p>
        </div>
      </div>
      {{/unless}}
    </section>

    <section class="cs-panel cs-pane" role="tabpanel" data-subpane="settings:sync">
      <div class="cs-field cs-inline">
        <label for="cs-sync-enabled">{{localize "CHRONICLE.SettingsWindow.SyncOn"}}</label>
        <div class="cs-ctl cs-row">
          <span class="cs-switch"><input id="cs-sync-enabled" name="syncEnabled" type="checkbox" {{#if view.syncEnabled}}checked{{/if}}><i aria-hidden="true"></i></span>
          <p class="cs-hint">{{localize "CHRONICLE.SettingsWindow.SyncOnHint"}}</p>
        </div>
      </div>
      <h3 class="cs-group">{{localize "CHRONICLE.SettingsWindow.WhatComesAcross"}}</h3>
      {{#each parts}}
      <div class="cs-part {{#unless on}}is-off{{/unless}}" data-part="{{part}}">
        <span class="cs-part-icon"><i class="fa-solid {{icon}}" aria-hidden="true"></i></span>
        <label class="cs-part-name" for="cs-part-{{part}}">{{name}}<small>{{hint}}</small></label>
        <span class="cs-switch"><input id="cs-part-{{part}}" name="part.{{part}}.on" type="checkbox" {{#if on}}checked{{/if}}><i aria-hidden="true"></i></span>
        <fieldset class="cs-dir">
          <legend>{{../labels.direction}}</legend>
          {{#each directions}}
          <label class="cs-dir-opt"><input type="radio" name="part.{{../part}}.direction" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>
          {{/each}}
        </fieldset>
      </div>
      {{/each}}
      {{!-- Creatures come from Chronicle only, so there is no direction to pick. --}}
      <div class="cs-part {{#unless view.syncCreatures}}is-off{{/unless}}" data-part="creatures">
        <span class="cs-part-icon"><i class="fa-solid fa-dragon" aria-hidden="true"></i></span>
        <label class="cs-part-name" for="cs-part-creatures">{{localize "CHRONICLE.SettingsWindow.Creatures.Name"}}<small>{{localize "CHRONICLE.SettingsWindow.Creatures.Hint"}}</small></label>
        <span class="cs-switch"><input id="cs-part-creatures" name="syncCreatures" type="checkbox" {{#if view.syncCreatures}}checked{{/if}}><i aria-hidden="true"></i></span>
      </div>
      {{#if pageTypes.length}}
      <div class="cs-field">
        <label for="cs-page-type">{{localize "CHRONICLE.SettingsWindow.NewPageType"}}</label>
        <div class="cs-ctl">
          <select id="cs-page-type" name="journalCreateTypeId">
            {{#each pageTypes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
          <p class="cs-hint">{{localize "CHRONICLE.SettingsWindow.NewPageTypeHint"}}</p>
        </div>
      </div>
      {{/if}}
    </section>

    <section class="cs-panel cs-pane" role="tabpanel" data-subpane="settings:calendar">
      <h3 class="cs-group">{{localize "CHRONICLE.SettingsWindow.TellMe"}}</h3>
      {{#each announce}}
      <div class="cs-field cs-inline">
        <label for="cs-{{key}}">{{label}}</label>
        <div class="cs-ctl cs-row">
          <span class="cs-switch"><input id="cs-{{key}}" name="{{key}}" type="checkbox" {{#if on}}checked{{/if}}><i aria-hidden="true"></i></span>
          <p class="cs-hint">{{hint}}</p>
        </div>
      </div>
      {{/each}}
    </section>

    <section class="cs-panel cs-pane" role="tabpanel" data-subpane="settings:players">
      <h3 class="cs-group">{{localize "CHRONICLE.SettingsWindow.NewJournals"}}</h3>
      <div class="cs-field">
        <label for="cs-ownership">{{localize "CHRONICLE.SettingsWindow.PlayersCan"}}</label>
        <div class="cs-ctl">
          <select id="cs-ownership" name="defaultOwnership">
            {{#each ownership}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>
      <div class="cs-field cs-inline">
        <label for="cs-sync-permissions">{{localize "CHRONICLE.SettingsWindow.SyncPermissions"}}</label>
        <div class="cs-ctl cs-row">
          <span class="cs-switch"><input id="cs-sync-permissions" name="syncPermissions" type="checkbox" {{#if view.syncPermissions}}checked{{/if}}><i aria-hidden="true"></i></span>
          <p class="cs-hint">{{localize "CHRONICLE.SettingsWindow.SyncPermissionsHint"}}</p>
        </div>
      </div>
      <div class="cs-field cs-inline">
        <label for="cs-dm-only">{{localize "CHRONICLE.SettingsWindow.DmOnlyHidden"}}</label>
        <div class="cs-ctl cs-row">
          <span class="cs-switch"><input id="cs-dm-only" name="dmOnlyHidden" type="checkbox" {{#if view.dmOnlyHidden}}checked{{/if}}><i aria-hidden="true"></i></span>
        </div>
      </div>
      <h3 class="cs-group">{{localize "CHRONICLE.SettingsWindow.LinkPlayers"}}</h3>
      <p class="cs-hint cs-group-hint">{{localize "CHRONICLE.SettingsWindow.LinkPlayersHint"}}</p>
      {{#if members.length}}
      <ul class="cs-members">
        {{#each members}}
        <li class="cs-member {{#unless matched}}is-unlinked{{/unless}}">
          <span class="cs-member-who">
            <b>{{name}}</b>
            {{#if role}}<small>{{role}}</small>{{/if}}
          </span>
          {{#if claimUnmapped}}
          <span class="cs-pill warn"><i class="fa-solid fa-user-lock" aria-hidden="true"></i>{{localize "CHRONICLE.SettingsWindow.MemberOwnsCharacter"}}</span>
          {{else if matched}}
          <span class="cs-pill ok"><span class="cs-dot"></span>{{localize "CHRONICLE.SettingsWindow.MemberLinked"}}</span>
          {{else}}
          <span class="cs-pill warn"><span class="cs-dot"></span>{{localize "CHRONICLE.SettingsWindow.MemberNotLinked"}}</span>
          {{/if}}
          <select data-member-key="{{key}}" aria-label="{{localize "CHRONICLE.SettingsWindow.MemberFoundryUser" name=name}}">
            {{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{#if id}}{{name}}{{else}}{{localize "CHRONICLE.SettingsWindow.MemberNotLinked"}}{{/if}}</option>{{/each}}
          </select>
        </li>
        {{/each}}
      </ul>
      {{else}}
      <div class="cs-state">
        <i class="fa-solid fa-users-slash" aria-hidden="true"></i>
        <b>{{localize "CHRONICLE.SettingsWindow.NoMembers"}}</b>
      </div>
      {{/if}}
      <div class="cs-row-end">
        <button type="button" data-action="refreshMembers"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>{{localize "CHRONICLE.SettingsWindow.RefreshMembers"}}</button>
      </div>
    </section>

    <section class="cs-panel cs-pane" role="tabpanel" data-subpane="settings:advanced">
      <div class="cs-field">
        <label for="cs-conflict">{{localize "CHRONICLE.SettingsWindow.WhenBoth"}}</label>
        <div class="cs-ctl">
          <select id="cs-conflict" name="conflictResolution">
            {{#each conflict}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>
      <div class="cs-field cs-inline">
        <label for="cs-auto-sync">{{localize "CHRONICLE.SettingsWindow.AutoSync"}}</label>
        <div class="cs-ctl cs-row">
          <span class="cs-switch"><input id="cs-auto-sync" name="autoSync" type="checkbox" {{#if view.autoSync}}checked{{/if}}><i aria-hidden="true"></i></span>
          <p class="cs-hint">{{localize "CHRONICLE.SettingsWindow.AutoSyncHint"}}</p>
        </div>
      </div>
      <div class="cs-field">
        <label for="cs-excluded-tags">{{localize "CHRONICLE.SettingsWindow.ExcludeTags"}}</label>
        <div class="cs-ctl">
          <input id="cs-excluded-tags" name="excludedTags" type="text" value="{{view.excludedTags}}" placeholder="{{localize "CHRONICLE.SettingsWindow.NothingLeftOut"}}">
          <p class="cs-hint">{{localize "CHRONICLE.SettingsWindow.ExcludeTagsHint"}}</p>
        </div>
      </div>
      <div class="cs-field">
        <label for="cs-excluded-names">{{localize "CHRONICLE.SettingsWindow.ExcludeNames"}}</label>
        <div class="cs-ctl"><input id="cs-excluded-names" name="excludedNamePattern" type="text" value="{{view.excludedNamePattern}}" placeholder="{{localize "CHRONICLE.SettingsWindow.NothingLeftOut"}}"></div>
      </div>
      <div class="cs-field cs-inline">
        <label for="cs-skip-sanitize">{{localize "CHRONICLE.SettingsWindow.SkipSanitize"}}</label>
        <div class="cs-ctl cs-row">
          <span class="cs-switch"><input id="cs-skip-sanitize" name="skipIncomingSanitization" type="checkbox" {{#if view.skipIncomingSanitization}}checked{{/if}}><i aria-hidden="true"></i></span>
          <p class="cs-hint">{{localize "CHRONICLE.SettingsWindow.SkipSanitizeHint"}}</p>
        </div>
      </div>
    </section>
  </div>

  <footer class="cs-foot">
    <button type="reset">{{localize "CHRONICLE.SettingsWindow.Undo"}}</button>
    <button type="submit" class="cs-primary"><i class="fa-solid fa-check" aria-hidden="true"></i>{{localize "CHRONICLE.SettingsWindow.Save"}}</button>
  </footer>
</form>
