{{!-- Gilded monster boxes, left and right of the picture. Play: the Stamina
dial with the winded point and the temporary figure, the villain actions used
this fight as numbered coins (marks the Director sets; they clear when the
fight ends), Malice for the Director only with the mark and the words, the
combat facts and conditions, then the five characteristics as gold
medallions. Inputs and buttons keep Draw Steel's names, data-source="false"
and actions. Edit: Draw Steel's own stat editors. --}}
<section class="cs-hero-stats stats cs-npc-stats cs-gc-stats{{#unless isPlay}} cs-gc-stats-edit{{/unless}}">
  {{#if isPlay}}
  <div class="cs-gc-left">
    <div class="cs-gc-dial cs-gn-stam" data-band="{{npc.chronicle.stamina.band}}">
      <svg class="cs-gc-dial-art" viewBox="0 0 300 170" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="cs-gc-npc-gold-{{document.id}}" x1="0" y1="0" x2="1" y2="1">
            <stop class="cs-gc-s0" offset="0"/><stop class="cs-gc-s1" offset="0.35"/><stop class="cs-gc-s2" offset="0.6"/><stop class="cs-gc-s3" offset="1"/>
          </linearGradient>
          {{!-- The patina creeps along the whole arc but shows only through a mask shaped like the fill. --}}
          <mask id="cs-gc-npc-tmask-{{document.id}}" maskUnits="userSpaceOnUse" x="0" y="0" width="300" height="170">
            <path class="cs-gn-tmask" d="M30 150A120 120 0 0 1 270 150" pathLength="100" stroke-dasharray="{{npc.chronicle.stamina.fill}} 100"/>
          </mask>
        </defs>
        <g class="cs-gc-rays" stroke="url(#cs-gc-npc-gold-{{document.id}})"><path d="M150 150L290.0 150.0"/><path d="M150 150L288.3 128.1"/><path d="M150 150L283.1 106.7"/><path d="M150 150L274.7 86.4"/><path d="M150 150L263.3 67.7"/><path d="M150 150L249.0 51.0"/><path d="M150 150L232.3 36.7"/><path d="M150 150L213.6 25.3"/><path d="M150 150L193.3 16.9"/><path d="M150 150L171.9 11.7"/><path d="M150 150L150.0 10.0"/><path d="M150 150L128.1 11.7"/><path d="M150 150L106.7 16.9"/><path d="M150 150L86.4 25.3"/><path d="M150 150L67.7 36.7"/><path d="M150 150L51.0 51.0"/><path d="M150 150L36.7 67.7"/><path d="M150 150L25.3 86.4"/><path d="M150 150L16.9 106.7"/><path d="M150 150L11.7 128.1"/><path d="M150 150L10.0 150.0"/></g>
        <path class="cs-gc-track" d="M30 150A120 120 0 0 1 270 150"/>
        <path class="cs-gc-fill" stroke="url(#cs-gc-npc-gold-{{document.id}})" d="M30 150A120 120 0 0 1 270 150" pathLength="100" stroke-dasharray="{{npc.chronicle.stamina.fill}} 100"/>
        <path class="cs-gn-tarnish" d="M30 150A120 120 0 0 1 270 150" pathLength="100" mask="url(#cs-gc-npc-tmask-{{document.id}})"/>
        <path class="cs-gc-base" stroke="url(#cs-gc-npc-gold-{{document.id}})" d="M10 150h280"/>
        {{#if npc.look.windedMark}}
        <line class="cs-gn-wmark" x1="{{npc.look.windedMark.x1}}" y1="{{npc.look.windedMark.y1}}" x2="{{npc.look.windedMark.x2}}" y2="{{npc.look.windedMark.y2}}"/>
        <g transform="translate({{npc.look.windedMark.gx}} {{npc.look.windedMark.gy}}) rotate(45)"><rect class="cs-gn-wgem" x="-3.5" y="-3.5" width="7" height="7"/></g>
        {{/if}}
      </svg>
      <div class="cs-gc-dv">
        <label class="cs-field cs-gc-stam">
          {{#if isSingleSquadMinion}}
          <span class="cs-hidden-label">{{localize "TYPES.CombatantGroup.squad"}}</span>
          <input type="number" name="squadStaminaValue" value="{{combatGroup.system.staminaValue}}">
          {{else}}
          <span class="cs-hidden-label">{{systemFields.stamina.fields.value.label}}</span>
          {{formInput systemFields.stamina.fields.value value=system.stamina.value dataset=datasets.notSource}}
          {{/if}}
        </label>
        <span class="cs-gc-of">{{localize "CHRONICLE.HeroSheet.OfStamina" max=(ifThen isSingleSquadMinion combatGroup.system.staminaMax system.stamina.max)}}</span>
        {{#if (eq npc.chronicle.stamina.band "winded")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Winded"}}</strong>{{/if}}
        {{#if (eq npc.chronicle.stamina.band "dying")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Dying"}}</strong>{{/if}}
        {{#if (eq npc.chronicle.stamina.band "dead")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Dead"}}</strong>{{/if}}
      </div>
    </div>
    <div class="cs-gc-dial-foot">
      <label class="cs-field cs-gc-temp">
        <span>{{systemFields.stamina.fields.temporary.label}}</span>
        {{formInput systemFields.stamina.fields.temporary value=system.stamina.temporary dataset=datasets.notSource}}
      </label>
      <span class="cs-gn-wat"><i class="cs-gn-wdot" aria-hidden="true"></i>{{localize "CHRONICLE.HeroSheet.Thresholds" winded=system.stamina.winded dead=system.stamina.min}}</span>
    </div>

    {{#if npc.villain.total}}
    <div class="cs-gc-res cs-gn-va">
      <span class="cs-gc-k">{{localize "CHRONICLE.NpcSheet.Villain.Title"}}</span>
      <span class="cs-gc-pips" role="group" aria-label="{{localize "CHRONICLE.NpcSheet.Villain.Title"}}">
        {{#each npc.villain.marks as |m|}}
        {{#if @root.npc.villain.canMark}}
        <button type="button" class="cs-va-mark {{m.state}}" data-action="csVillain" data-item-id="{{m.id}}" aria-pressed="{{#if (eq m.state "used")}}true{{else}}false{{/if}}" aria-label="{{localize (concat "CHRONICLE.NpcSheet.Villain.State." m.state) name=m.name order=m.order}}" data-tooltip-text="{{localize (concat "CHRONICLE.NpcSheet.Villain.State." m.state) name=m.name order=m.order}}">{{m.order}}</button>
        {{else}}
        <span class="cs-va-mark {{m.state}}" role="img" aria-label="{{localize (concat "CHRONICLE.NpcSheet.Villain.State." m.state) name=m.name order=m.order}}" data-tooltip-text="{{localize (concat "CHRONICLE.NpcSheet.Villain.State." m.state) name=m.name order=m.order}}">{{m.order}}</span>
        {{/if}}
        {{/each}}
      </span>
      <p class="cs-gn-note">{{#if npc.villain.inFight}}{{localize "CHRONICLE.NpcSheet.Villain.Left" left=npc.villain.left total=npc.villain.total}}{{else}}{{localize "CHRONICLE.NpcSheet.Villain.NoFight"}}{{/if}}</p>
    </div>
    {{/if}}

    {{#if showMalice}}
    {{!-- Only the Director sees Malice: the amber edge, the mark and the words. --}}
    <div class="cs-gc-res cs-gn-mal cs-dm-only" data-tooltip="CHRONICLE.NpcSheet.MaliceTip">
      <span class="cs-gc-k"><span class="cs-dm-mark">{{malice.label}}</span></span>
      <small class="cs-dm-words">{{localize "CHRONICLE.NpcSheet.OnlyYou"}}</small>
      <span class="cs-gc-pips" role="presentation">{{#each npc.look.malicePips as |on|}}<i class="{{#if on}}on{{/if}}"></i>{{/each}}</span>
      <span class="cs-gc-n"><label class="cs-field cs-gn-mal-in"><span class="cs-hidden-label">{{malice.label}}, {{localize "CHRONICLE.NpcSheet.OnlyYou"}}</span><input type="number" step="1" data-setting="malice" value="{{malice.value}}"></label></span>
    </div>
    {{/if}}

    <p class="cs-gc-orn" aria-hidden="true"></p>
    <p class="cs-gc-facts cs-gn-facts">
      <span class="cs-gc-fact"{{#if movement.list}} data-tooltip-text="{{movement.list}}"{{/if}}><i>{{systemFields.movement.fields.value.label}}</i><b>{{system.movement.value}}</b></span>
      <span class="cs-gc-fact"{{#if combatTooltip}} data-tooltip-html="{{combatTooltip}}"{{/if}}><i>{{systemFields.combat.fields.stability.label}}</i><b>{{system.combat.stability}}</b></span>
      <span class="cs-gc-fact"><i>{{systemFields.combat.fields.size.label}}</i><b>{{system.combat.size}}</b></span>
      {{#if editable}}
      <button type="button" class="cs-gc-fact cs-gn-fact-btn" data-action="freeStrike" data-tooltip="CHRONICLE.NpcSheet.FreeStrikeTip"><i>{{systemFields.monster.fields.freeStrike.label}}</i><b>{{system.monster.freeStrike}}</b></button>
      {{else}}
      <span class="cs-gc-fact"><i>{{systemFields.monster.fields.freeStrike.label}}</i><b>{{system.monster.freeStrike}}</b></span>
      {{/if}}
    </p>
    <p class="cs-gc-it">
      {{#if movement.list}}<span>{{movement.list}}.</span>{{/if}}
      <span>{{systemFields.damage.fields.immunities.label}}: {{#if damageIW.immunities}}{{{damageIW.immunities}}}{{else}}{{localize "COMMON.None"}}{{/if}}.</span>
      <span>{{systemFields.damage.fields.weaknesses.label}}: {{#if damageIW.weaknesses}}{{{damageIW.weaknesses}}}{{else}}{{localize "COMMON.None"}}{{/if}}.</span>
      <span class="cs-gn-cond">{{localize "CHRONICLE.HeroSheet.Conditions"}}:
        {{#if npc.chronicle.conditions.length}}{{#each npc.chronicle.conditions as |c|}}<b>{{c.name}}</b>{{#unless @last}}, {{/unless}}{{/each}}.{{else}}{{localize "COMMON.None"}}.{{/if}}
      </span>
    </p>
  </div>

  <div class="cs-gc-right">
    <div class="cs-gc-chars">
      {{#each characteristics as |chr key|}}
      <button
        type="button"
        class="cs-gc-row"
        data-metal="{{lookup @root.npc.look.metals key}}"
        style="--i: {{@index}}"
        data-action="roll" data-roll-type="characteristic" data-characteristic="{{key}}"
        data-tooltip-text="{{localize "DRAW_STEEL.ROLL.Prompt" prompt=chr.field.label}}"
        {{disabled (not @root.owner)}}
      >
        <span class="cs-gc-coin" aria-hidden="true"><b>{{numberFormat chr.value sign=true}}</b></span>
        <span class="cs-gc-rt">
          <span class="cs-gc-nm">{{chr.field.label}}</span>
          <i class="cs-gc-rk" aria-hidden="true">{{localize (concat "CHRONICLE.HeroSheet.Suit." (lookup @root.npc.look.metals key))}}</i>
        </span>
        <span class="cs-hidden-label">{{numberFormat chr.value sign=true}}</span>
      </button>
      {{/each}}
    </div>

    {{#if npc.villain.inFight}}{{#each npc.villain.marks as |m|}}{{#if (eq m.state "next")}}
    <p class="cs-gc-orn" aria-hidden="true"></p>
    <div class="cs-gc-skills cs-gn-next">
      <p class="cs-gc-k">{{localize "CHRONICLE.NpcSheet.Villain.Title"}}</p>
      <p class="cs-gn-next-line">{{localize "CHRONICLE.NpcSheet.Villain.State.next" name=m.name order=m.order}}</p>
    </div>
    {{/if}}{{/each}}{{/if}}
  </div>
  {{else}}
  {{> "modules/chronicle-sync/templates/npc-looks/edit-stats.hbs"}}
  {{/if}}
</section>
