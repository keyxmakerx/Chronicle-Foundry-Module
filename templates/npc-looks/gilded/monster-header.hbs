{{!-- Gilded monster header: the card's gold frame, the picture under an arch
with the level on a medal at its foot, then the name, organization and role,
keywords and EV. A Limited viewer sees this part, so it shows only what Draw
Steel's own NPC header shows. Malice and the fight's marks are in the boxes. --}}
<header class="cs-hero-head cs-gc-head cs-npc-head" style="{{#if avatarProperties.objectFit}}--avatar-object-fit: {{avatarProperties.objectFit}};{{/if}}{{#if avatarProperties.objectPosition}} --avatar-object-position: {{avatarProperties.objectPosition}};{{/if}}">
  {{!-- The gold borders, corner flourishes and the foil light lie over the
  whole window, held still while the card scrolls under them. --}}
  <div class="cs-gc-frame" aria-hidden="true">
    <i class="cs-gc-fade"></i>
    <i class="cs-gc-corner cs-gc-tl"></i><i class="cs-gc-corner cs-gc-tr"></i><i class="cs-gc-corner cs-gc-bl"></i><i class="cs-gc-corner cs-gc-br"></i>
    <i class="cs-gc-gem cs-gc-gem-top"></i><i class="cs-gc-gem cs-gc-gem-foot"></i>
    <span class="cs-gc-foilbox"><span class="cs-gc-foil"></span></span>
  </div>

  <div class="cs-gc-mid">
    <div class="cs-gc-arch">
      <div class="cs-gc-archin">
        {{!-- Shown where the creature has no picture of its own. --}}
        <svg class="cs-gc-crest" viewBox="0 0 600 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <g fill="none" stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
            <path d="M300 170c110 30 150 60 150 60v170c0 110-70 180-150 230-80-50-150-120-150-230V230s40-30 150-60z"/>
            <path d="M300 250v270M276 300h48M288 520h24l-12 40z"/>
          </g>
        </svg>
        <button type="button" class="cs-portrait-btn" data-action="csPortraitMenu" aria-haspopup="menu" aria-expanded="false" aria-label="{{localize "CHRONICLE.HeroSheet.Portrait.Menu"}}" data-tooltip="CHRONICLE.HeroSheet.Portrait.Menu">
          <img class="cs-portrait" src="{{document.img}}" alt="{{document.name}}" {{#unless isPlay}}data-edit="img"{{/unless}}>
        </button>
        <div class="cs-gc-veil" aria-hidden="true"></div>
        <div class="cs-gc-crack" aria-hidden="true"></div>
      </div>
    </div>

    <div class="cs-gc-medal" role="img" aria-label="{{localize "CHRONICLE.HeroSheet.LevelN" level=system.monster.level}}">
      <span aria-hidden="true">{{localize "CHRONICLE.HeroSheet.LevelN" level=""}}</span><b aria-hidden="true">{{system.monster.level}}</b>
    </div>

    <div class="cs-gc-plate">
      {{#if isPlay}}
      <h1 class="cs-name">{{document.name}}</h1>
      {{else}}
      <div class="cs-name-edit">
        {{formInput fields.name value=source.name placeholder=(localize "DOCUMENT.FIELDS.name.label")}}
      </div>
      {{/if}}
      <ul class="cs-gc-origins">
        {{#if system.monster.organizationLabel}}<li class="cs-gc-origin"><span class="cs-gc-origin-name">{{system.monster.organizationLabel}}</span></li>{{/if}}
        {{#if system.monster.roleLabel}}<li class="cs-gc-origin"><span class="cs-gc-origin-name">{{system.monster.roleLabel}}</span></li>{{/if}}
        {{#unless isPlay}}
        <li class="cs-gc-origin"><button type="button" class="cs-gc-mini" data-action="editMonsterMetadata" data-tooltip="CHRONICLE.NpcSheet.EditMetadata" aria-label="{{localize "CHRONICLE.NpcSheet.EditMetadata"}}"><i class="fa-solid fa-gear" inert></i></button></li>
        {{/unless}}
      </ul>
      {{#if monsterKeywords.length}}
      <ul class="cs-gc-origins">
        {{#each monsterKeywords as |keyword|}}
        <li class="cs-gc-origin"><span class="cs-gc-kind">{{localize "CHRONICLE.NpcSheet.Keyword"}}</span><span class="cs-gc-origin-name">{{keyword}}</span></li>
        {{/each}}
      </ul>
      {{/if}}
      {{#if npc.villain.inFight}}<p class="cs-gc-sub">{{localize "CHRONICLE.NpcSheet.InFight"}}</p>{{/if}}
      <p class="cs-gc-vic">
        <span>{{localize "DRAW_STEEL.Actor.base.EVLabel.Label"}} <b>{{system.evLabel}}</b></span>
      </p>
    </div>
  </div>
</header>
