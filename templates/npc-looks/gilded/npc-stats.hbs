{{!-- Gilded NPC boxes, left and right of the picture. Play: the negotiation on
the dial (Interest, with the answer the NPC would give now), Patience as
coins, Impression for the Director only, and the motivations and pitfalls the
party has found as a hand of coins, each with its state in words as well as a
look. The stat block, or an honest empty place for one (no made-up numbers),
sits under them. Edit: Draw Steel's own stat editors. --}}
<section class="cs-hero-stats stats cs-npc-stats cs-gc-stats{{#unless isPlay}} cs-gc-stats-edit{{/unless}}">
  {{#if isPlay}}
  <div class="cs-gc-left">
    {{#if npc.negotiation.has}}
    <div class="cs-gc-dial cs-gn-int" data-band="{{npc.look.interestBand}}">
      <svg class="cs-gc-dial-art" viewBox="0 0 300 170" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="cs-gc-npc-gold-{{document.id}}" x1="0" y1="0" x2="1" y2="1">
            <stop class="cs-gc-s0" offset="0"/><stop class="cs-gc-s1" offset="0.35"/><stop class="cs-gc-s2" offset="0.6"/><stop class="cs-gc-s3" offset="1"/>
          </linearGradient>
          {{!-- A foil glint runs along the arc when Interest rises, seen only over the gold. --}}
          <mask id="cs-gc-npc-gmask-{{document.id}}" maskUnits="userSpaceOnUse" x="0" y="0" width="300" height="170">
            <path class="cs-gn-tmask" d="M30 150A120 120 0 0 1 270 150" pathLength="100" stroke-dasharray="{{npc.look.interestFill}} 100"/>
          </mask>
        </defs>
        <g class="cs-gc-rays" stroke="url(#cs-gc-npc-gold-{{document.id}})"><path d="M150 150L290.0 150.0"/><path d="M150 150L288.3 128.1"/><path d="M150 150L283.1 106.7"/><path d="M150 150L274.7 86.4"/><path d="M150 150L263.3 67.7"/><path d="M150 150L249.0 51.0"/><path d="M150 150L232.3 36.7"/><path d="M150 150L213.6 25.3"/><path d="M150 150L193.3 16.9"/><path d="M150 150L171.9 11.7"/><path d="M150 150L150.0 10.0"/><path d="M150 150L128.1 11.7"/><path d="M150 150L106.7 16.9"/><path d="M150 150L86.4 25.3"/><path d="M150 150L67.7 36.7"/><path d="M150 150L51.0 51.0"/><path d="M150 150L36.7 67.7"/><path d="M150 150L25.3 86.4"/><path d="M150 150L16.9 106.7"/><path d="M150 150L11.7 128.1"/><path d="M150 150L10.0 150.0"/></g>
        <path class="cs-gc-track" d="M30 150A120 120 0 0 1 270 150"/>
        <path class="cs-gc-fill" stroke="url(#cs-gc-npc-gold-{{document.id}})" d="M30 150A120 120 0 0 1 270 150" pathLength="100" stroke-dasharray="{{npc.look.interestFill}} 100"/>
        <path class="cs-gn-glint" d="M30 150A120 120 0 0 1 270 150" pathLength="100" stroke-dasharray="7 130" stroke-dashoffset="8" mask="url(#cs-gc-npc-gmask-{{document.id}})"/>
        <path class="cs-gc-base" stroke="url(#cs-gc-npc-gold-{{document.id}})" d="M10 150h280"/>
        {{!-- Notches cut the arc into Draw Steel's five steps of Interest. --}}
        <line class="cs-gn-notch" x1="61" y1="85.3" x2="44.8" y2="73.6"/><line class="cs-gn-notch" x1="116" y1="45.4" x2="109.8" y2="26.4"/><line class="cs-gn-notch" x1="184" y1="45.4" x2="190.2" y2="26.4"/><line class="cs-gn-notch" x1="239" y1="85.3" x2="255.2" y2="73.6"/>
        <text class="cs-gn-step" x="11" y="141">0</text><text class="cs-gn-step" x="289" y="141">5</text>
      </svg>
      <div class="cs-gc-dv">
        <span class="cs-gc-stam cs-gn-big" role="img" aria-label="{{localize "CHRONICLE.NpcSheet.OfFive" n=npc.negotiation.interestText}} {{localize "CHRONICLE.NpcSheet.Interest"}}">{{npc.negotiation.interestText}}</span>
        <span class="cs-gc-of" aria-hidden="true">{{localize "CHRONICLE.NpcSheet.Look.OfInterest"}}</span>
      </div>
    </div>
    <div class="cs-gc-dial-foot">
      <span class="cs-gn-wat"><i class="cs-gn-eye" aria-hidden="true">◉</i>{{localize (concat "CHRONICLE.NpcSheet.Seen." npc.negotiation.source (ifThen npc.negotiation.shown "Shown" "Hidden"))}}</span>
    </div>

    <div class="cs-gc-res cs-gn-pat">
      <span class="cs-gc-k">{{localize "CHRONICLE.NpcSheet.Patience"}}</span>
      <span class="cs-gc-pips" role="img" aria-label="{{localize "CHRONICLE.NpcSheet.OfFive" n=npc.negotiation.patienceText}}">{{#each npc.negotiation.patiencePips as |on|}}<i class="{{#if on}}on{{/if}}"></i>{{/each}}</span>
      <span class="cs-gc-n"><b>{{npc.negotiation.patienceText}}</b><small>/5</small></span>
    </div>

    {{#if npc.isGM}}
    {{!-- Only the Director sees Impression: the amber edge, the mark and the words. --}}
    <div class="cs-gc-res cs-gn-imp cs-dm-only" data-tooltip="CHRONICLE.NpcSheet.ImpressionTip">
      <span class="cs-gc-k"><span class="cs-dm-mark">{{localize "CHRONICLE.NpcSheet.Impression"}}</span></span>
      <small class="cs-dm-words">{{localize "CHRONICLE.NpcSheet.OnlyYou"}}</small>
      <span class="cs-gc-n"><b>{{npc.negotiation.impressionText}}</b></span>
    </div>
    {{/if}}

    {{#if npc.negotiation.answer}}
    <p class="cs-gc-orn" aria-hidden="true"></p>
    <p class="cs-gn-now"><span class="cs-gc-k">{{localize "CHRONICLE.NpcSheet.IfAnswered"}}</span><b>{{localize npc.negotiation.answer}}</b>{{#if npc.negotiation.over}}<small>{{localize "CHRONICLE.NpcSheet.Over"}}</small>{{/if}}</p>
    {{/if}}
    {{else}}
    <div class="cs-gn-vacant">
      <p class="cs-gc-k">{{localize "CHRONICLE.NpcSheet.Negotiation"}}</p>
      <p class="cs-gn-quiet">{{localize "CHRONICLE.NpcSheet.NoNegotiation"}}</p>
      {{#if npc.pageUrl}}<button type="button" class="cs-quiet" data-action="csOpenPage">{{localize "CHRONICLE.NpcSheet.OpenPage"}}</button>{{/if}}
    </div>
    {{/if}}
    {{#if npc.statBlock}}
    <p class="cs-gc-orn" aria-hidden="true"></p>
    <div class="cs-gn-sstam" data-band="{{npc.chronicle.stamina.band}}">
      <span class="cs-gc-k">{{systemFields.stamina.label}}</span>
      <span class="cs-gn-sn">
        <label class="cs-field cs-gn-sval">
          {{#if isSingleSquadMinion}}
          <span class="cs-hidden-label">{{localize "TYPES.CombatantGroup.squad"}}</span>
          <input type="number" name="squadStaminaValue" value="{{combatGroup.system.staminaValue}}">
          {{else}}
          <span class="cs-hidden-label">{{systemFields.stamina.fields.value.label}}</span>
          {{formInput systemFields.stamina.fields.value value=system.stamina.value dataset=datasets.notSource}}
          {{/if}}
        </label>
        <span class="cs-gn-of">/ {{#if isSingleSquadMinion}}{{combatGroup.system.staminaMax}}{{else}}{{system.stamina.max}}{{/if}}</span>
        <label class="cs-field cs-gc-temp">
          <span>{{systemFields.stamina.fields.temporary.label}}</span>
          {{formInput systemFields.stamina.fields.temporary value=system.stamina.temporary dataset=datasets.notSource}}
        </label>
      </span>
      <span class="cs-gn-bar" role="presentation">
        <i style="width: {{npc.chronicle.stamina.fill}}%"></i>{{#if npc.chronicle.stamina.windedAt}}<u style="left: {{npc.chronicle.stamina.windedAt}}%"></u>{{/if}}
      </span>
      <p class="cs-gn-note">
        {{localize "CHRONICLE.HeroSheet.Thresholds" winded=system.stamina.winded dead=system.stamina.min}}
        {{#if (eq npc.chronicle.stamina.band "winded")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Winded"}}</strong>{{/if}}
        {{#if (eq npc.chronicle.stamina.band "dying")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Dying"}}</strong>{{/if}}
        {{#if (eq npc.chronicle.stamina.band "dead")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Dead"}}</strong>{{/if}}
      </p>
    </div>
    <p class="cs-gc-orn" aria-hidden="true"></p>
    <p class="cs-gc-facts cs-gn-facts">
      <span class="cs-gc-fact"{{#if movement.list}} data-tooltip-text="{{movement.list}}"{{/if}}><i>{{systemFields.movement.fields.value.label}}</i><b>{{system.movement.value}}</b></span>
      <span class="cs-gc-fact"{{#if combatTooltip}} data-tooltip-html="{{combatTooltip}}"{{/if}}><i>{{systemFields.combat.fields.stability.label}}</i><b>{{system.combat.stability}}</b></span>
      <span class="cs-gc-fact"><i>{{systemFields.combat.fields.size.label}}</i><b>{{system.combat.size}}</b></span>
      {{#if editable}}
      <button type="button" class="cs-gc-fact cs-gn-fact-btn" data-action="freeStrike" data-tooltip="CHRONICLE.NpcSheet.FreeStrikeTip"><i>{{systemFields.monster.fields.freeStrike.label}}</i><b>{{system.monster.freeStrike}}</b></button>
      {{else}}
      <span class="cs-gc-fact"><i>{{systemFields.monster.fields.freeStrike.label}}</i><b>{{system.monster.freeStrike}}</b></span>
      {{/if}}
    </p>
    {{/if}}
    {{#unless npc.statBlock}}
    <div class="cs-nostat">
      <b>{{localize "CHRONICLE.NpcSheet.NoStats.Title"}}</b>
      <p>{{localize (ifThen editable "CHRONICLE.NpcSheet.NoStats.Body" "CHRONICLE.NpcSheet.NoStats.BodyView")}}</p>
      {{#if editable}}<button type="button" class="cs-quiet" data-action="toggleMode">{{localize "CHRONICLE.NpcSheet.NoStats.Edit"}}</button>{{/if}}
    </div>
    {{/unless}}
  </div>

  <div class="cs-gc-right">
    <p class="cs-gc-k">{{localize "CHRONICLE.NpcSheet.Talk.Motives"}}</p>
    {{#if npc.negotiation.rows.length}}
    <ul class="cs-gn-motives">
      {{#each npc.negotiation.rows as |row|}}
      <li class="cs-gn-motive" data-state="{{row.state}}" data-kind="{{row.kind}}" style="--i: {{@index}}">
        <span class="cs-gc-coin cs-gn-mcoin" aria-hidden="true">
          {{#if (eq row.kind "pitfall")}}
          <svg class="cs-gn-ico" viewBox="0 0 24 24" focusable="false"><path d="M12 4 21 19H3z"/><path d="M12 10v4M12 16.5v.5"/></svg>
          {{else}}
          <svg class="cs-gn-ico" viewBox="0 0 24 24" focusable="false"><path d="M4.5 9.5 8.3 5h7.4l3.8 4.5L12 19.5z"/><path d="M4.5 9.5h15M9.6 9.5 12 19.5l2.4-10M8.3 5l1.3 4.5M15.7 5l-1.3 4.5"/></svg>
          {{/if}}
          <em class="cs-gn-q">?</em>
        </span>
        <span class="cs-gc-rt">
          <b class="cs-gc-nm">{{row.label}}</b>
          <i class="cs-gc-rk">{{localize (concat "CHRONICLE.NpcSheet.Kind." row.kind)}} · {{localize (concat "CHRONICLE.NpcSheet.State." row.state)}}</i>
        </span>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="cs-gn-quiet">{{localize (ifThen npc.isGM "CHRONICLE.NpcSheet.Talk.NoneGM" "CHRONICLE.NpcSheet.Talk.None")}}</p>
    {{/if}}
    {{#if npc.statBlock}}
    <p class="cs-gc-orn" aria-hidden="true"></p>
    <div class="cs-gn-schars">
      {{#each characteristics as |chr key|}}
      <button
        type="button"
        class="cs-gc-row"
        data-metal="{{lookup @root.npc.look.metals key}}"
        data-action="roll" data-roll-type="characteristic" data-characteristic="{{key}}"
        data-tooltip-text="{{localize "DRAW_STEEL.ROLL.Prompt" prompt=chr.field.label}}"
        {{disabled (not @root.owner)}}
      >
        <span class="cs-gc-coin" aria-hidden="true"><b>{{numberFormat chr.value sign=true}}</b></span>
        <span class="cs-gc-nm">{{chr.field.label}}</span>
        <span class="cs-hidden-label">{{numberFormat chr.value sign=true}}</span>
      </button>
      {{/each}}
    </div>
    {{/if}}
  </div>

  {{else}}
  {{> "modules/chronicle-sync/templates/npc-looks/edit-stats.hbs"}}
  {{/if}}
</section>
