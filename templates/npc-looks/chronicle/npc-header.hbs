{{!-- Chronicle NPC sheet header: portrait, name, level and role line, and
on the Director's screen the page's chips, Impression and the Talking switch
(the token's talking glow). A Limited viewer sees this part, so everything
past Draw Steel's own header is for the Director only. --}}
<header class="cs-hero-head cs-npc-head" style="{{#if avatarProperties.objectFit}}--avatar-object-fit: {{avatarProperties.objectFit}};{{/if}}{{#if avatarProperties.objectPosition}} --avatar-object-position: {{avatarProperties.objectPosition}};{{/if}}">
  <button type="button" class="cs-portrait-btn" data-action="csPortraitMenu" aria-haspopup="menu" aria-expanded="false" aria-label="{{localize "CHRONICLE.HeroSheet.Portrait.Menu"}}" data-tooltip="CHRONICLE.HeroSheet.Portrait.Menu">
    <img class="cs-portrait" src="{{document.img}}" alt="{{document.name}}" {{#unless isPlay}}data-edit="img"{{/unless}}>
  </button>

  <div class="cs-id">
    {{#if isPlay}}
    <h1 class="cs-name">{{document.name}}</h1>
    {{else}}
    <div class="cs-name-edit">
      {{formInput fields.name value=source.name placeholder=(localize "DOCUMENT.FIELDS.name.label")}}
    </div>
    {{/if}}
    <p class="cs-line">
      <span class="cs-line-level">{{localize "CHRONICLE.HeroSheet.LevelN" level=system.monster.level}}</span>
      {{#if system.monster.organizationLabel}}<span class="cs-line-item">{{system.monster.organizationLabel}}</span>{{/if}}
      {{#if system.monster.roleLabel}}<span class="cs-line-item">{{system.monster.roleLabel}}</span>{{/if}}
      {{#unless isPlay}}
      <button type="button" class="cs-mini" data-action="editMonsterMetadata" data-tooltip="CHRONICLE.NpcSheet.EditMetadata" aria-label="{{localize "CHRONICLE.NpcSheet.EditMetadata"}}"><i class="fa-solid fa-gear" inert></i></button>
      {{/unless}}
    </p>
    {{#if npc.page.chips.length}}
    <ul class="cs-chips">
      {{#each npc.page.chips as |chip|}}
      <li class="cs-chip"><span class="cs-chip-kind">{{chip.kind}}</span><span class="cs-chip-name">{{chip.name}}</span></li>
      {{/each}}
    </ul>
    {{/if}}
  </div>

  <div class="cs-prog">
    <dl>
      <div class="cs-prog-level">
        <dt>{{systemFields.monster.fields.level.label}}</dt>
        <dd>{{system.monster.level}}</dd>
      </div>
      {{#if npc.isGM}}
      <div class="cs-dm-only" data-tooltip="CHRONICLE.NpcSheet.ImpressionTip">
        <dt><span class="cs-dm-mark">{{localize "CHRONICLE.NpcSheet.Impression"}}</span></dt>
        <dd>{{npc.negotiation.impressionText}}<small class="cs-dm-words">{{localize "CHRONICLE.NpcSheet.OnlyYou"}}</small></dd>
      </div>
      {{/if}}
    </dl>
    {{#if npc.talk.show}}
    <button type="button" class="cs-btn cs-talk-btn" data-action="csTalk" aria-pressed="{{#if npc.talk.pressed}}true{{else}}false{{/if}}" data-tooltip="CHRONICLE.NpcSheet.TalkingTip">{{localize "CHRONICLE.NpcSheet.Talking"}}</button>
    {{/if}}
  </div>
</header>
