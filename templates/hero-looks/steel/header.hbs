{{!-- The steel and banner header: a cloth banner down the left with the hero's
picture in a shield, the level medal, the class and subclass, then the name in
capitals over the origins, XP and victories. A Limited viewer sees this part,
so it shows only what Draw Steel's own header shows. Origins keep Draw Steel's
markup: the item's uuid on the entry, viewDoc on its name, deleteDoc and
addOrigin in Edit. The hairline frame and rivets are decoration. --}}
<header class="cs-hero-head cs-steel-head" style="{{#if avatarProperties.objectFit}}--avatar-object-fit: {{avatarProperties.objectFit}};{{/if}}{{#if avatarProperties.objectPosition}} --avatar-object-position: {{avatarProperties.objectPosition}};{{/if}}">
  {{#*inline "csOrigin"}}
  {{#if originDoc}}
  <li class="cs-steel-origin" data-document-uuid="{{originDoc.uuid}}">
    {{#unless @root.isPlay}}<span class="cs-steel-kind">{{localize (concat "TYPES.Item." originType)}}</span>{{/unless}}
    <a class="cs-steel-origin-name" data-action="viewDoc" data-tooltip="{{localize (concat "TYPES.Item." originType)}}">{{originDoc.name}}</a>
    {{#unless (or @root.isPlay noEdit)}}
    <a class="cs-steel-del" data-action="deleteDoc" aria-label="{{localize "CHRONICLE.HeroSheet.Remove"}}" data-tooltip="CHRONICLE.HeroSheet.Remove"><i class="fa-solid fa-trash-can" inert></i></a>
    {{/unless}}
  </li>
  {{else}}
  {{#unless (and (not @root.isPlay) noEdit)}}
  <li class="cs-steel-origin cs-steel-todo">
    {{#if @root.isPlay}}
    <span>{{localize (concat "TYPES.Item." originType)}}: {{localize "CHRONICLE.HeroSheet.StillToChoose"}}</span>
    {{else}}
    <a data-action="addOrigin" data-type="{{originType}}">{{localize "DRAW_STEEL.SHEET.Add" itemName=(localize (concat "TYPES.Item." originType))}}</a>
    {{/if}}
  </li>
  {{/unless}}
  {{/if}}
  {{/inline}}

  {{!-- The window's hairline and four rivets, held still while the page scrolls. --}}
  <div class="cs-steel-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <div class="cs-steel-banner">
    <div class="cs-steel-hang">
    <div class="cs-steel-cloth">
      <div class="cs-steel-crest">
        {{!-- Shown where the hero has no picture of their own. --}}
        <svg class="cs-steel-emblem" viewBox="0 0 100 124" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <g fill="none" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
            <path d="M50 22v62M36 42h28M44 84h12l-6 14z"/>
            <path d="M24 30c14 4 20 8 26 12 6-4 12-8 26-12"/>
          </g>
        </svg>
        {{!-- The whole picture is the portrait button. Its menu offers the full
        picture, the token and, in Edit mode, Foundry's file picker, which reads
        data-edit off the picture. --}}
        <button type="button" class="cs-portrait-btn" data-action="csPortraitMenu" aria-haspopup="menu" aria-expanded="false" aria-label="{{localize "CHRONICLE.HeroSheet.Portrait.Menu"}}" data-tooltip="CHRONICLE.HeroSheet.Portrait.Menu">
          <img class="cs-portrait" src="{{document.img}}" alt="{{document.name}}" {{#unless isPlay}}data-edit="img"{{/unless}}>
        </button>
      </div>
      {{#if system.advancementReady}}
      <button type="button" class="cs-steel-lvl cs-steel-lvlup" {{disabled (not editable)}} data-action="levelUp" aria-label="{{localize "CHRONICLE.HeroSheet.LevelN" level=system.level}}" data-tooltip="DRAW_STEEL.SHEET.LevelUp">
        <b>{{system.level}}</b><i class="fa-solid fa-up-long" inert></i>
      </button>
      {{else}}
      <p class="cs-steel-lvl" role="img" aria-label="{{localize "CHRONICLE.HeroSheet.LevelN" level=system.level}}"><b>{{system.level}}</b></p>
      {{/if}}
      {{#with document.system.class as |cls|}}
      <p class="cs-steel-cls" data-document-uuid="{{cls.uuid}}"><a data-action="viewDoc">{{cls.name}}</a></p>
      {{/with}}
      <p class="cs-steel-col">
        {{#each document.system.subclasses as |sub|}}
        <span class="cs-steel-subcls" data-document-uuid="{{sub.uuid}}"><a data-action="viewDoc">{{sub.name}}</a></span>
        {{/each}}
      </p>
    </div>
    </div>
  </div>

  <div class="cs-steel-id">
    {{#if isPlay}}
    <h1 class="cs-name">{{document.name}}</h1>
    {{else}}
    <div class="cs-name-edit">
      {{formInput fields.name value=source.name placeholder=(localize "DOCUMENT.FIELDS.name.label")}}
    </div>
    {{/if}}
    <ul class="cs-steel-sub">
      {{> csOrigin originDoc=document.system.ancestry originType="ancestry"}}
      {{> csOrigin originDoc=document.system.culture originType="culture"}}
      {{> csOrigin originDoc=document.system.career originType="career"}}
      {{#unless isPlay}}
      {{> csOrigin originDoc=document.system.class originType="class"}}
      {{#each document.system.subclasses as |subclass|}}
      {{> csOrigin originDoc=subclass originType="subclass" noEdit=true}}
      {{/each}}
      {{/unless}}
      {{#if isPlay}}
      <li class="cs-steel-vit">{{systemFields.hero.fields.xp.label}} <b>{{system.hero.xp}}</b>{{#if system.nextLevelXP}}/{{system.nextLevelXP}}{{/if}}</li>
      <li class="cs-steel-vit">{{systemFields.hero.fields.victories.label}} <b>{{system.hero.victories}}</b>{{#if system.victoriesMax}}/{{system.victoriesMax}}{{/if}}</li>
      {{/if}}
    </ul>
    {{#if isPlay}}
    {{#if editable}}
    <button type="button" class="cs-steel-btn cs-respite" data-action="takeRespite">
      <i class="fa-solid fa-bed" inert></i> {{localize "DRAW_STEEL.Actor.hero.TakeRespite"}}
    </button>
    {{/if}}
    {{else}}
    <div class="cs-steel-prog-edit">
      {{formGroup systemFields.hero.fields.xp value=systemSource.hero.xp classes="xp"}}
      {{formGroup systemFields.hero.fields.victories value=systemSource.hero.victories classes="victories"}}
    </div>
    {{/if}}
  </div>
</header>
