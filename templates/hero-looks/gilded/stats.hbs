{{!-- The gilded card's boxes, left and right of the picture. Play: the
Stamina dial with the temporary figure, recoveries, heroic resource and
surges as rows of round pips, the combat facts and movement, then the five
characteristics as gold medallions and the skills. Inputs and buttons keep
Draw Steel's names, data-source="false" and actions, so its handlers and
active-effect locks work. Edit: Draw Steel's own stat editors. --}}
<section class="cs-gc-stats{{#unless isPlay}} cs-gc-stats-edit{{/unless}} stats">
  {{#if isPlay}}
  <div class="cs-gc-left">
    <div class="cs-gc-dial" data-band="{{chronicle.stamina.band}}">
      <svg class="cs-gc-dial-art" viewBox="0 0 300 170" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="cs-gc-gold" x1="0" y1="0" x2="1" y2="1">
            <stop class="cs-gc-s0" offset="0"/><stop class="cs-gc-s1" offset="0.35"/><stop class="cs-gc-s2" offset="0.6"/><stop class="cs-gc-s3" offset="1"/>
          </linearGradient>
        </defs>
        <g class="cs-gc-rays"><path d="M150 150L290.0 150.0"/><path d="M150 150L288.3 128.1"/><path d="M150 150L283.1 106.7"/><path d="M150 150L274.7 86.4"/><path d="M150 150L263.3 67.7"/><path d="M150 150L249.0 51.0"/><path d="M150 150L232.3 36.7"/><path d="M150 150L213.6 25.3"/><path d="M150 150L193.3 16.9"/><path d="M150 150L171.9 11.7"/><path d="M150 150L150.0 10.0"/><path d="M150 150L128.1 11.7"/><path d="M150 150L106.7 16.9"/><path d="M150 150L86.4 25.3"/><path d="M150 150L67.7 36.7"/><path d="M150 150L51.0 51.0"/><path d="M150 150L36.7 67.7"/><path d="M150 150L25.3 86.4"/><path d="M150 150L16.9 106.7"/><path d="M150 150L11.7 128.1"/><path d="M150 150L10.0 150.0"/></g>
        <path class="cs-gc-track" d="M30 150A120 120 0 0 1 270 150"/>
        <path class="cs-gc-fill" d="M30 150A120 120 0 0 1 270 150" pathLength="100" stroke-dasharray="{{chronicle.stamina.fill}} 100"/>
        <path class="cs-gc-base" d="M10 150h280"/>
      </svg>
      <div class="cs-gc-dv">
        <label class="cs-field cs-gc-stam">
          <span class="cs-hidden-label">{{systemFields.stamina.fields.value.label}}</span>
          {{formInput systemFields.stamina.fields.value value=system.stamina.value dataset=datasets.notSource}}
        </label>
        <span class="cs-gc-of">{{localize "CHRONICLE.HeroSheet.OfStamina" max=system.stamina.max}}</span>
        {{#if (eq chronicle.stamina.band "winded")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Winded"}}</strong>{{/if}}
        {{#if (eq chronicle.stamina.band "dying")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Dying"}}</strong>{{/if}}
        {{#if (eq chronicle.stamina.band "dead")}}<strong class="cs-gc-state">{{localize "CHRONICLE.HeroSheet.Dead"}}</strong>{{/if}}
      </div>
    </div>
    <div class="cs-gc-dial-foot">
      <label class="cs-field cs-gc-temp">
        <span>{{systemFields.stamina.fields.temporary.label}}</span>
        {{formInput systemFields.stamina.fields.temporary value=system.stamina.temporary dataset=datasets.notSource}}
      </label>
      {{#if editable}}
      <button type="button" class="cs-gc-mini" data-action="spendStaminaHeroToken" data-tooltip="DRAW_STEEL.Setting.HeroTokens.RegainStamina.tooltip">
        <i class="fa-solid fa-circle-bolt" inert></i> {{localize "CHRONICLE.HeroSheet.HeroToken"}}
      </button>
      {{/if}}
    </div>

    <div class="cs-gc-res cs-gc-rec">
      {{#if editable}}
      <button type="button" class="cs-gc-k" data-action="spendRecovery" data-tooltip="DRAW_STEEL.Actor.base.SpendRecovery.tooltip" aria-label="{{localize "CHRONICLE.HeroSheet.SpendRecovery"}}">
        {{systemFields.recoveries.label}}
      </button>
      {{else}}
      <span class="cs-gc-k">{{systemFields.recoveries.label}}</span>
      {{/if}}
      <span class="cs-gc-pips" role="presentation">{{#each chronicle.recoveryDots as |on|}}<i class="{{#if on}}on{{/if}}"></i>{{/each}}</span>
      <span class="cs-gc-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{systemFields.recoveries.fields.value.label}}</span>
          {{formInput systemFields.recoveries.fields.value value=system.recoveries.value dataset=datasets.notSource}}
        </label>
        <small>/{{system.recoveries.max}}</small>
      </span>
    </div>

    <div class="cs-gc-res cs-gc-primary">
      <span class="cs-gc-k">{{system.hero.primary.label}}</span>
      <span class="cs-gc-pips" role="presentation">{{#each chronicle.primaryDiamonds}}<i class="on"></i>{{/each}}</span>
      <span class="cs-gc-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{system.hero.primary.label}}</span>
          {{formInput systemFields.hero.fields.primary.fields.value value=system.hero.primary.value dataset=datasets.notSource}}
        </label>
      </span>
    </div>

    <div class="cs-gc-res cs-gc-surges">
      {{#if editable}}
      <button type="button" class="cs-gc-k" data-action="gainSurges" data-tooltip="DRAW_STEEL.Setting.HeroTokens.GainSurges.tooltip" aria-label="{{localize "DRAW_STEEL.Setting.HeroTokens.GainSurges.label"}}">
        {{systemFields.hero.fields.surges.label}}
      </button>
      {{else}}
      <span class="cs-gc-k">{{systemFields.hero.fields.surges.label}}</span>
      {{/if}}
      <span class="cs-gc-pips" role="presentation">{{#each chronicle.surgeDiamonds}}<i class="on"></i>{{/each}}</span>
      <span class="cs-gc-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{systemFields.hero.fields.surges.label}}</span>
          {{formInput systemFields.hero.fields.surges value=system.hero.surges dataset=datasets.notSource}}
        </label>
      </span>
    </div>

    {{#if chronicle.showEpic}}
    <div class="cs-gc-res cs-gc-epic">
      <span class="cs-gc-k">{{system.hero.epic.label}}</span>
      <span class="cs-gc-pips" role="presentation">{{#each chronicle.epicDiamonds}}<i class="on"></i>{{/each}}</span>
      <span class="cs-gc-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{system.hero.epic.label}}</span>
          {{formInput systemFields.hero.fields.epic.fields.value value=system.hero.epic.value dataset=datasets.notSource}}
        </label>
      </span>
    </div>
    {{/if}}

    <p class="cs-gc-orn" aria-hidden="true"></p>
    <p class="cs-gc-facts">
      <span class="cs-gc-fact"><i>{{systemFields.movement.fields.value.label}}</i><b>{{system.movement.value}}</b></span>
      <span class="cs-gc-fact"{{#if combatTooltip}} data-tooltip-html="{{combatTooltip}}"{{/if}}><i>{{systemFields.combat.fields.stability.label}}</i><b>{{system.combat.stability}}</b></span>
      <span class="cs-gc-fact"><i>{{systemFields.combat.fields.size.label}}</i><b>{{system.combat.size}}</b></span>
      <span class="cs-gc-fact"><i>{{systemFields.movement.fields.disengage.label}}</i><b>{{system.movement.disengage}}</b></span>
    </p>
    <p class="cs-gc-it">
      {{#if movement.list}}<span>{{movement.list}}.</span>{{/if}}
      <span>{{localize "CHRONICLE.HeroSheet.RecoveryHeals" n=system.recoveries.recoveryValue}}.</span>
      {{#if damageIW.immunities}}<span>{{systemFields.damage.fields.immunities.label}}: {{{damageIW.immunities}}}.</span>{{/if}}
      {{#if damageIW.weaknesses}}<span>{{systemFields.damage.fields.weaknesses.label}}: {{{damageIW.weaknesses}}}.</span>{{/if}}
    </p>
  </div>

  <div class="cs-gc-right">
    <div class="cs-gc-chars">
      {{#each characteristics as |chr key|}}
      <button
        type="button"
        class="cs-gc-row"
        data-metal="{{lookup @root.chronicle.metals key}}"
        style="--i: {{@index}}"
        data-action="roll" data-roll-type="characteristic" data-characteristic="{{key}}"
        data-tooltip-text="{{localize "DRAW_STEEL.ROLL.Prompt" prompt=chr.field.label}}"
        {{disabled (not @root.owner)}}
      >
        <span class="cs-gc-coin" aria-hidden="true"><b>{{numberFormat chr.value sign=true}}</b></span>
        <span class="cs-gc-rt">
          <span class="cs-gc-nm">{{chr.field.label}}</span>
          <i class="cs-gc-rk" aria-hidden="true">{{localize (concat "CHRONICLE.HeroSheet.Metal." (lookup @root.chronicle.metals key))}}</i>
        </span>
        <span class="cs-hidden-label">{{numberFormat chr.value sign=true}}</span>
      </button>
      {{/each}}
    </div>

    <p class="cs-gc-orn" aria-hidden="true"></p>
    <div class="cs-gc-skills">
      <p class="cs-gc-k">
        {{systemFields.skills.fields.value.label}}
        {{#if unfilledSkill}}
        <button
          type="button"
          class="cs-gc-mini"
          data-action="fillTrait" data-type="skill"
          data-tooltip-text="{{localize "DRAW_STEEL.ADVANCEMENT.FillTrait.button" type=(localize "TYPES.Advancement.skill")}}"
        >
          <i class="fa-solid fa-clipboard-question" inert></i> {{localize "CHRONICLE.HeroSheet.Choose"}}
        </button>
        {{/if}}
      </p>
      {{#if chronicle.skills.length}}
      <ul class="cs-gc-skill-list">{{#each chronicle.skills as |name|}}<li>{{name}}</li>{{/each}}</ul>
      {{else}}
      <p class="cs-gc-none">{{#if skills.list}}{{skills.list}}{{else}}{{localize "COMMON.None"}}{{/if}}</p>
      {{/if}}
    </div>
  </div>
  {{else}}
  <div class="cs-edit standard-form">
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/characteristics.hbs" editCharacteristics=false}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/combat.hbs"}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/movement.hbs"}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/immunities-weaknesses.hbs"}}
    <fieldset class="skills">
      <legend>
        {{systemFields.skills.fields.value.label}}
        {{#if unfilledSkill}}
        <button
          type="button"
          class="icon fa-solid fa-clipboard-question"
          data-tooltip-text="{{localize "DRAW_STEEL.ADVANCEMENT.FillTrait.button" type=(localize "TYPES.Advancement.skill")}}"
          data-action="fillTrait"
          data-type="skill"
        ></button>
        {{/if}}
      </legend>
      {{formInput systemFields.skills.fields.value value=systemSource.skills.value options=skills.options dataset=datasets.isSource}}
    </fieldset>
  </div>
  {{/if}}
</section>
