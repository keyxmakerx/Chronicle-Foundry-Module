{{!-- The portrait hall's boxes, beside the picture and above the tabs.
Play: the Stamina ring with the recoveries inside it, recoveries, heroic
resource and surges as rows of diamonds, the combat line, then the five
characteristics as plaques and the skills. Inputs and buttons keep Draw
Steel's names, data-source="false" and actions, so its handlers and
active-effect locks work. Edit: Draw Steel's own stat editors. --}}
<section class="cs-hall-stats stats">
  {{#if isPlay}}
  <div class="cs-hall-gauges">
    <div class="cs-hall-ring" data-band="{{chronicle.stamina.band}}">
      <svg class="cs-hall-ring-art" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <circle class="cs-hall-ticks" cx="100" cy="100" r="95" pathLength="42"/>
        <circle class="cs-hall-track" cx="100" cy="100" r="82"/>
        <circle class="cs-hall-fill" cx="100" cy="100" r="82" pathLength="100" stroke-dasharray="{{chronicle.stamina.fill}} 100" transform="rotate(-90 100 100)"/>
        {{#each chronicle.ring as |seg|}}
        <circle class="cs-hall-seg{{#if seg.on}} on{{/if}}" cx="100" cy="100" r="65" pathLength="100" stroke-dasharray="{{seg.dash}}" stroke-dashoffset="{{seg.offset}}" transform="rotate(-90 100 100)"/>
        {{/each}}
      </svg>
      <div class="cs-hall-rv">
        <label class="cs-field cs-hall-stam">
          <span class="cs-hidden-label">{{systemFields.stamina.fields.value.label}}</span>
          {{formInput systemFields.stamina.fields.value value=system.stamina.value dataset=datasets.notSource}}
        </label>
        <span class="cs-hall-of">{{localize "CHRONICLE.HeroSheet.OfStamina" max=system.stamina.max}}</span>
        {{#if (eq chronicle.stamina.band "winded")}}<strong class="cs-hall-state">{{localize "CHRONICLE.HeroSheet.Winded"}}</strong>{{/if}}
        {{#if (eq chronicle.stamina.band "dying")}}<strong class="cs-hall-state">{{localize "CHRONICLE.HeroSheet.Dying"}}</strong>{{/if}}
        {{#if (eq chronicle.stamina.band "dead")}}<strong class="cs-hall-state">{{localize "CHRONICLE.HeroSheet.Dead"}}</strong>{{/if}}
      </div>
      <div class="cs-hall-ring-foot">
        <label class="cs-field cs-hall-temp">
          <span>{{systemFields.stamina.fields.temporary.label}}</span>
          {{formInput systemFields.stamina.fields.temporary value=system.stamina.temporary dataset=datasets.notSource}}
        </label>
        {{#if editable}}
        <button type="button" class="cs-hall-mini" data-action="spendStaminaHeroToken" data-tooltip="DRAW_STEEL.Setting.HeroTokens.RegainStamina.tooltip">
          <i class="fa-solid fa-circle-bolt" inert></i> {{localize "CHRONICLE.HeroSheet.HeroToken"}}
        </button>
        {{/if}}
      </div>
    </div>

    <div class="cs-hall-col">
      <div class="cs-hall-res cs-hall-rec">
        {{#if editable}}
        <button type="button" class="cs-hall-k" data-action="spendRecovery" data-tooltip="DRAW_STEEL.Actor.base.SpendRecovery.tooltip" aria-label="{{localize "CHRONICLE.HeroSheet.SpendRecovery"}}">
          <i class="fa-solid fa-heart-pulse" inert></i> {{systemFields.recoveries.label}}
        </button>
        {{else}}
        <span class="cs-hall-k">{{systemFields.recoveries.label}}</span>
        {{/if}}
        <span class="cs-hall-pips" role="presentation">{{#each chronicle.recoveryDots as |on|}}<i class="{{#if on}}on{{/if}}"></i>{{/each}}</span>
        <span class="cs-hall-n">
          <label class="cs-field">
            <span class="cs-hidden-label">{{systemFields.recoveries.fields.value.label}}</span>
            {{formInput systemFields.recoveries.fields.value value=system.recoveries.value dataset=datasets.notSource}}
          </label>
          <small>/{{system.recoveries.max}}</small>
        </span>
      </div>

      <div class="cs-hall-res cs-hall-primary">
        <span class="cs-hall-k">{{system.hero.primary.label}}</span>
        <span class="cs-hall-pips" role="presentation">{{#each chronicle.primaryDiamonds}}<i class="on"></i>{{/each}}</span>
        <span class="cs-hall-n">
          <label class="cs-field">
            <span class="cs-hidden-label">{{system.hero.primary.label}}</span>
            {{formInput systemFields.hero.fields.primary.fields.value value=system.hero.primary.value dataset=datasets.notSource}}
          </label>
        </span>
      </div>

      <div class="cs-hall-res cs-hall-surges">
        {{#if editable}}
        <button type="button" class="cs-hall-k" data-action="gainSurges" data-tooltip="DRAW_STEEL.Setting.HeroTokens.GainSurges.tooltip" aria-label="{{localize "DRAW_STEEL.Setting.HeroTokens.GainSurges.label"}}">
          <i class="fa-solid fa-circle-bolt" inert></i> {{systemFields.hero.fields.surges.label}}
        </button>
        {{else}}
        <span class="cs-hall-k">{{systemFields.hero.fields.surges.label}}</span>
        {{/if}}
        <span class="cs-hall-pips" role="presentation">{{#each chronicle.surgeDiamonds}}<i class="on"></i>{{/each}}</span>
        <span class="cs-hall-n">
          <label class="cs-field">
            <span class="cs-hidden-label">{{systemFields.hero.fields.surges.label}}</span>
            {{formInput systemFields.hero.fields.surges value=system.hero.surges dataset=datasets.notSource}}
          </label>
        </span>
      </div>

      {{#if chronicle.showEpic}}
      <div class="cs-hall-res cs-hall-epic">
        <span class="cs-hall-k">{{system.hero.epic.label}}</span>
        <span class="cs-hall-pips" role="presentation">{{#each chronicle.epicDiamonds}}<i class="on"></i>{{/each}}</span>
        <span class="cs-hall-n">
          <label class="cs-field">
            <span class="cs-hidden-label">{{system.hero.epic.label}}</span>
            {{formInput systemFields.hero.fields.epic.fields.value value=system.hero.epic.value dataset=datasets.notSource}}
          </label>
        </span>
      </div>
      {{/if}}

      <p class="cs-hall-line">
        <span{{#if movement.list}} data-tooltip-text="{{movement.list}}"{{/if}}>{{systemFields.movement.fields.value.label}} <b>{{system.movement.value}}</b></span>
        <span{{#if combatTooltip}} data-tooltip-html="{{combatTooltip}}"{{/if}}>{{systemFields.combat.fields.stability.label}} <b>{{system.combat.stability}}</b></span>
        <span>{{systemFields.combat.fields.size.label}} <b>{{system.combat.size}}</b></span>
        <span>{{systemFields.movement.fields.disengage.label}} <b>{{system.movement.disengage}}</b></span>
      </p>
      <p class="cs-hall-line cs-hall-dim">
        {{#if movement.list}}<span>{{movement.list}}</span>{{/if}}
        <span>{{localize "CHRONICLE.HeroSheet.RecoveryHeals" n=system.recoveries.recoveryValue}}</span>
        {{#if damageIW.immunities}}<span>{{systemFields.damage.fields.immunities.label}}: {{{damageIW.immunities}}}</span>{{/if}}
        {{#if damageIW.weaknesses}}<span>{{systemFields.damage.fields.weaknesses.label}}: {{{damageIW.weaknesses}}}</span>{{/if}}
      </p>
    </div>
  </div>

  <div class="cs-hall-plaques">
    {{#each characteristics as |chr key|}}
    <button
      type="button"
      class="cs-hall-pl"
      data-metal="{{lookup @root.chronicle.metals key}}"
      style="--i: {{@index}}"
      data-action="roll" data-roll-type="characteristic" data-characteristic="{{key}}"
      data-tooltip-text="{{localize "DRAW_STEEL.ROLL.Prompt" prompt=chr.field.label}}"
      {{disabled (not @root.owner)}}
    >
      <i aria-hidden="true">{{localize (concat "CHRONICLE.HeroSheet.Metal." (lookup @root.chronicle.metals key))}}</i>
      <b>{{numberFormat chr.value sign=true}}</b>
      <span>{{chr.field.label}}</span>
    </button>
    {{/each}}
  </div>

  <div class="cs-hall-skills">
    <p class="cs-hall-k">
      {{systemFields.skills.fields.value.label}}
      {{#if unfilledSkill}}
      <button
        type="button"
        class="cs-hall-mini"
        data-action="fillTrait" data-type="skill"
        data-tooltip-text="{{localize "DRAW_STEEL.ADVANCEMENT.FillTrait.button" type=(localize "TYPES.Advancement.skill")}}"
      >
        <i class="fa-solid fa-clipboard-question" inert></i> {{localize "CHRONICLE.HeroSheet.Choose"}}
      </button>
      {{/if}}
    </p>
    {{#if chronicle.skills.length}}
    <ul class="cs-hall-skill-list">{{#each chronicle.skills as |name|}}<li>{{name}}</li>{{/each}}</ul>
    {{else}}
    <p class="cs-hall-none">{{#if skills.list}}{{skills.list}}{{else}}{{localize "COMMON.None"}}{{/if}}</p>
    {{/if}}
  </div>
  {{else}}
  <div class="cs-edit standard-form">
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/characteristics.hbs" editCharacteristics=false}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/combat.hbs"}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/movement.hbs"}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/immunities-weaknesses.hbs"}}
    <fieldset class="skills">
      <legend>
        {{systemFields.skills.fields.value.label}}
        {{#if unfilledSkill}}
        <button
          type="button"
          class="icon fa-solid fa-clipboard-question"
          data-tooltip-text="{{localize "DRAW_STEEL.ADVANCEMENT.FillTrait.button" type=(localize "TYPES.Advancement.skill")}}"
          data-action="fillTrait"
          data-type="skill"
        ></button>
        {{/if}}
      </legend>
      {{formInput systemFields.skills.fields.value value=systemSource.skills.value options=skills.options dataset=datasets.isSource}}
    </fieldset>
  </div>
  {{/if}}
</section>
