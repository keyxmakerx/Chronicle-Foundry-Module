{{!-- The arcane glass boxes. Play: the Stamina ring that wraps the picture
(with the recoveries as arcs inside it), a row of tracker boxes (Stamina,
recoveries, heroic resource, surges, speed, stability), the five
characteristics as hexes, then skills and body. Inputs and buttons keep Draw
Steel's names, data-source="false" and actions, so its handlers and
active-effect locks work. Edit: Draw Steel's own stat editors. The section
takes no box of its own: the look's CSS lays its parts out beside the header's
in one grid. --}}
<section class="cs-glass-stats stats">
  {{#if isPlay}}
  <div class="cs-glass-ring" data-band="{{chronicle.stamina.band}}">
    <svg class="cs-glass-ring-art" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
      <circle class="cs-glass-fill" cx="120" cy="120" r="106" pathLength="100" stroke-dasharray="{{chronicle.stamina.fill}} 100" transform="rotate(-90 120 120)"/>
      {{#each chronicle.ring as |seg|}}
      <circle class="cs-glass-seg{{#if seg.on}} on{{/if}}" cx="120" cy="120" r="95" pathLength="100" stroke-dasharray="{{seg.dash}}" stroke-dashoffset="{{seg.offset}}" transform="rotate(-90 120 120)"/>
      {{/each}}
    </svg>
    <p class="cs-glass-chip">
      <b>{{system.stamina.value}}</b>/<span>{{system.stamina.max}}</span>
      {{#if (eq chronicle.stamina.band "winded")}}<strong class="cs-glass-state">{{localize "CHRONICLE.HeroSheet.Winded"}}</strong>{{/if}}
      {{#if (eq chronicle.stamina.band "dying")}}<strong class="cs-glass-state">{{localize "CHRONICLE.HeroSheet.Dying"}}</strong>{{/if}}
      {{#if (eq chronicle.stamina.band "dead")}}<strong class="cs-glass-state">{{localize "CHRONICLE.HeroSheet.Dead"}}</strong>{{/if}}
    </p>
  </div>

  <div class="cs-glass-trk">
    <div class="cs-glass-box cs-glass-stam" data-band="{{chronicle.stamina.band}}">
      {{#if editable}}
      <button type="button" class="cs-glass-lb" data-action="spendStaminaHeroToken" data-tooltip="DRAW_STEEL.Setting.HeroTokens.RegainStamina.tooltip">
        {{systemFields.stamina.label}}
      </button>
      {{else}}
      <span class="cs-glass-lb">{{systemFields.stamina.label}}</span>
      {{/if}}
      <label class="cs-field cs-glass-n">
        <span class="cs-hidden-label">{{systemFields.stamina.fields.value.label}}</span>
        {{formInput systemFields.stamina.fields.value value=system.stamina.value dataset=datasets.notSource}}
      </label>
      <label class="cs-field cs-glass-temp">
        <span>{{systemFields.stamina.fields.temporary.label}}</span>
        {{formInput systemFields.stamina.fields.temporary value=system.stamina.temporary dataset=datasets.notSource}}
      </label>
    </div>

    <div class="cs-glass-box cs-glass-rec">
      {{#if editable}}
      <button type="button" class="cs-glass-lb" data-action="spendRecovery" data-tooltip="DRAW_STEEL.Actor.base.SpendRecovery.tooltip" aria-label="{{localize "CHRONICLE.HeroSheet.SpendRecovery"}}">
        {{systemFields.recoveries.label}}
      </button>
      {{else}}
      <span class="cs-glass-lb">{{systemFields.recoveries.label}}</span>
      {{/if}}
      <span class="cs-glass-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{systemFields.recoveries.fields.value.label}}</span>
          {{formInput systemFields.recoveries.fields.value value=system.recoveries.value dataset=datasets.notSource}}
        </label>
        <small>/{{system.recoveries.max}}</small>
      </span>
    </div>

    <div class="cs-glass-box cs-glass-primary">
      <span class="cs-glass-lb">{{system.hero.primary.label}}</span>
      <span class="cs-glass-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{system.hero.primary.label}}</span>
          {{formInput systemFields.hero.fields.primary.fields.value value=system.hero.primary.value dataset=datasets.notSource}}
        </label>
      </span>
    </div>

    <div class="cs-glass-box cs-glass-surges">
      {{#if editable}}
      <button type="button" class="cs-glass-lb" data-action="gainSurges" data-tooltip="DRAW_STEEL.Setting.HeroTokens.GainSurges.tooltip" aria-label="{{localize "DRAW_STEEL.Setting.HeroTokens.GainSurges.label"}}">
        {{systemFields.hero.fields.surges.label}}
      </button>
      {{else}}
      <span class="cs-glass-lb">{{systemFields.hero.fields.surges.label}}</span>
      {{/if}}
      <span class="cs-glass-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{systemFields.hero.fields.surges.label}}</span>
          {{formInput systemFields.hero.fields.surges value=system.hero.surges dataset=datasets.notSource}}
        </label>
      </span>
    </div>

    {{#if chronicle.showEpic}}
    <div class="cs-glass-box cs-glass-epic">
      <span class="cs-glass-lb">{{system.hero.epic.label}}</span>
      <span class="cs-glass-n">
        <label class="cs-field">
          <span class="cs-hidden-label">{{system.hero.epic.label}}</span>
          {{formInput systemFields.hero.fields.epic.fields.value value=system.hero.epic.value dataset=datasets.notSource}}
        </label>
      </span>
    </div>
    {{/if}}

    <div class="cs-glass-box cs-glass-plain">
      <span class="cs-glass-lb">{{systemFields.movement.fields.value.label}}</span>
      <b class="cs-glass-n">{{system.movement.value}}</b>
    </div>

    <div class="cs-glass-box cs-glass-plain"{{#if combatTooltip}} data-tooltip-html="{{combatTooltip}}"{{/if}}>
      <span class="cs-glass-lb">{{systemFields.combat.fields.stability.label}}</span>
      <b class="cs-glass-n">{{system.combat.stability}}</b>
    </div>
  </div>

  <div class="cs-glass-const">
    <span class="cs-glass-line" aria-hidden="true"></span>
    {{#each characteristics as |chr key|}}
    <button
      type="button"
      class="cs-glass-hx"
      style="--i: {{@index}}"
      data-action="roll" data-roll-type="characteristic" data-characteristic="{{key}}"
      data-tooltip-text="{{localize "DRAW_STEEL.ROLL.Prompt" prompt=chr.field.label}}"
      {{disabled (not @root.owner)}}
    >
      <span class="cs-glass-glow" aria-hidden="true"></span>
      <b>{{numberFormat chr.value sign=true}}</b>
      <span class="cs-glass-hx-name">{{chr.field.label}}</span>
    </button>
    {{/each}}
  </div>

  <div class="cs-glass-grid">
    <div class="cs-glass-cell cs-glass-skills">
      <p class="cs-glass-k">
        {{systemFields.skills.fields.value.label}}
        {{#if unfilledSkill}}
        <button
          type="button"
          class="cs-glass-mini"
          data-action="fillTrait" data-type="skill"
          data-tooltip-text="{{localize "DRAW_STEEL.ADVANCEMENT.FillTrait.button" type=(localize "TYPES.Advancement.skill")}}"
        >
          <i class="fa-solid fa-clipboard-question" inert></i> {{localize "CHRONICLE.HeroSheet.Choose"}}
        </button>
        {{/if}}
      </p>
      {{#if chronicle.skills.length}}
      <ul class="cs-glass-skill-list">{{#each chronicle.skills as |name|}}<li>{{name}}</li>{{/each}}</ul>
      {{else}}
      <p class="cs-glass-none">{{#if skills.list}}{{skills.list}}{{else}}{{localize "COMMON.None"}}{{/if}}</p>
      {{/if}}
    </div>

    <div class="cs-glass-cell cs-glass-body">
      <p class="cs-glass-k">{{systemFields.combat.label}}</p>
      <p class="cs-glass-t">
        <span>{{systemFields.combat.fields.size.label}} <b>{{system.combat.size}}</b></span>
        <span>{{systemFields.movement.fields.disengage.label}} <b>{{system.movement.disengage}}</b></span>
      </p>
      {{#if movement.list}}<p class="cs-glass-t">{{movement.list}}</p>{{/if}}
      <p class="cs-glass-t">{{localize "CHRONICLE.HeroSheet.RecoveryHeals" n=system.recoveries.recoveryValue}}</p>
      {{#if damageIW.immunities}}<p class="cs-glass-t">{{systemFields.damage.fields.immunities.label}}: {{{damageIW.immunities}}}</p>{{/if}}
      {{#if damageIW.weaknesses}}<p class="cs-glass-t">{{systemFields.damage.fields.weaknesses.label}}: {{{damageIW.weaknesses}}}</p>{{/if}}
    </div>
  </div>
  {{else}}
  <div class="cs-edit standard-form">
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/characteristics.hbs" editCharacteristics=false}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/combat.hbs"}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/movement.hbs"}}
    {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/immunities-weaknesses.hbs"}}
    <fieldset class="skills">
      <legend>
        {{systemFields.skills.fields.value.label}}
        {{#if unfilledSkill}}
        <button
          type="button"
          class="icon fa-solid fa-clipboard-question"
          data-tooltip-text="{{localize "DRAW_STEEL.ADVANCEMENT.FillTrait.button" type=(localize "TYPES.Advancement.skill")}}"
          data-action="fillTrait"
          data-type="skill"
        ></button>
        {{/if}}
      </legend>
      {{formInput systemFields.skills.fields.value value=systemSource.skills.value options=skills.options dataset=datasets.isSource}}
    </fieldset>
  </div>
  {{/if}}
</section>
