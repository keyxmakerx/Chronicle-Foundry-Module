{{!-- Chronicle Sync Dashboard - Main tabbed interface --}}
<div class="chronicle-dashboard-inner">

  {{#unless configured}}
  <div class="cs-state dashboard-empty">
    <i class="fa-solid fa-plug" aria-hidden="true"></i>
    <b>{{localize "CHRONICLE.Dashboard.NotConfigured"}}</b>
    <p>{{localize "CHRONICLE.Dashboard.NotConfiguredHint"}}</p>
    <button type="button" data-action="open-settings" class="dashboard-btn">
      <i class="fa-solid fa-gear"></i> {{localize "CHRONICLE.Dashboard.OpenSettings"}}
    </button>
  </div>
  {{else}}

  {{#if loading}}
  <div class="cs-loading dashboard-loading" role="status" aria-label="{{localize 'CHRONICLE.Dashboard.Common.Loading'}}"><div class="cs-skel"></div><div class="cs-skel"></div><div class="cs-skel"></div></div>
  {{/if}}

  {{!-- What failed to load, above the body; the rest of the dashboard still works. --}}
  {{#if hasLoadErrors}}
  <div class="cs-state is-error dashboard-load-errors" role="alert">
    <i class="fa-solid fa-cloud-bolt" aria-hidden="true"></i>
    <b>{{localize "CHRONICLE.States.LoadFailed"}}</b>
    <p>{{localize "CHRONICLE.Dashboard.Common.LoadFailed"}} {{#each loadErrors}}{{label}}{{#unless @last}}, {{/unless}}{{/each}}</p>
    <button type="button" data-action="refresh" class="dashboard-btn btn-sm">
      <i class="fa-solid fa-arrows-rotate"></i> {{localize "CHRONICLE.States.TryAgain"}}
    </button>
  </div>
  {{/if}}

  {{!-- Body: left category rail + right content pane --}}
  <div class="dashboard-body">

  {{!-- Left rail: vertical nav grouped by how often a GM needs each section --}}
  <nav class="dashboard-tabs dashboard-rail" data-group="primary">
    <a class="item item-overview" data-tab="overview">
      <i class="fa-solid fa-gauge-high"></i> {{localize "CHRONICLE.Dashboard.Rail.Overview"}}
    </a>

    <div class="rail-group-label">{{localize "CHRONICLE.Dashboard.Rail.Everyday"}}</div>
    <a class="item" data-tab="entities">
      <i class="fa-solid fa-book"></i> {{localize "CHRONICLE.Dashboard.Rail.Entities"}}
    </a>
    <a class="item" data-tab="characters">
      <i class="fa-solid fa-users"></i> {{localize "CHRONICLE.Dashboard.Rail.Characters"}}
      {{#if issues.hasIssues}}<span class="member-tab-badge" title="{{localize 'CHRONICLE.Dashboard.Rail.IssuesBadge' count=issues.count}}">{{issues.count}}</span>{{/if}}
    </a>
    <a class="item" data-tab="calendar">
      <i class="fa-solid fa-calendar"></i> {{localize "CHRONICLE.Dashboard.Rail.Calendar"}}
    </a>

    <div class="rail-group-label">{{localize "CHRONICLE.Dashboard.Rail.Library"}}</div>
    <a class="item" data-tab="maps">
      <i class="fa-solid fa-map"></i> {{localize "CHRONICLE.Dashboard.Rail.Maps"}}
    </a>
    <a class="item" data-tab="shops">
      <i class="fa-solid fa-store"></i> {{localize "CHRONICLE.Dashboard.Rail.Shops"}}
    </a>

    <a class="item item-diagnostics" data-tab="diagnostics">
      <i class="fa-solid fa-stethoscope"></i> {{localize "CHRONICLE.Dashboard.Rail.Diagnostics"}}
      {{#if debug.unread}}<span class="member-tab-badge" title="{{localize 'CHRONICLE.Debug.NewBadge' count=debug.unread}}">{{debug.unread}}</span>{{/if}}
    </a>
  </nav>

  {{!-- Tab content --}}
  <section class="dashboard-content">

    {{!-- ================================================================= --}}
    {{!-- OVERVIEW TAB (landing cockpit)                                    --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="overview" data-group="primary">
      {{#with overview}}
      <div class="overview-panel">

        {{!-- Connection banner --}}
        <div class="connection-status overview-connection state-{{connection.state}}">
          <span class="status-dot"></span>
          <div class="overview-connection-text">
            <strong>{{connection.label}}</strong>
            <span class="overview-sub">{{connection.detail}}</span>
          </div>
          {{#unless connection.ok}}
          <button type="button" class="dashboard-btn btn-sm" data-action="reconnect">
            <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.Dashboard.StatusTab.Reconnect"}}
          </button>
          {{/unless}}
        </div>

        {{!-- Headline stats (click to jump to the full tab) --}}
        <div class="overview-stats">
          {{#each stats}}
          <button type="button" class="overview-stat" data-jump-tab="{{tab}}" title="{{localize 'CHRONICLE.Dashboard.Overview.OpenStat' label=label}}">
            <span class="overview-stat-value">{{value}}</span>
            <span class="overview-stat-label">{{label}}</span>
          </button>
          {{/each}}
        </div>

        {{!-- Needs attention — only problems, each routed to the fixing tab --}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Overview.NeedsAttention"}}</h3>
        {{#if attention.length}}
        <div class="overview-attention">
          {{#each attention}}
          <button type="button" class="overview-alert sev-{{severity}}" data-jump-tab="{{tab}}">
            <i class="fa-solid {{icon}}"></i>
            <span class="overview-alert-text">{{text}}</span>
            <i class="fa-solid fa-chevron-right overview-alert-go"></i>
          </button>
          {{/each}}
        </div>
        {{else}}
        <div class="overview-allclear">
          <i class="fa-solid fa-circle-check"></i>
          {{localize "CHRONICLE.Dashboard.Overview.AllClear"}}
        </div>
        {{/if}}

        {{!-- Quick actions --}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Overview.QuickActions"}}</h3>
        <div class="overview-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="resync-everything">
            <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.Dashboard.Overview.SyncEverything"}}
          </button>
          <button type="button" class="dashboard-btn btn-sm" data-jump-tab="diagnostics:health">
            <i class="fa-solid fa-stethoscope"></i> {{localize "CHRONICLE.Dashboard.Rail.Diagnostics"}}
          </button>
          <button type="button" class="dashboard-btn btn-sm" data-action="refresh">
            <i class="fa-solid fa-arrows-rotate"></i> {{localize "CHRONICLE.Dashboard.Common.Refresh"}}
          </button>
        </div>
      </div>
      {{/with}}
      <div class="overview-panel overview-more">
        {{#if dmOnlyHiddenCount}}
        <div class="dashboard-hint dm-only-hint">
          <i class="fa-solid fa-user-secret"></i>
          {{localize "CHRONICLE.Dashboard.StatusTab.DmOnlyHiddenNote" count=dmOnlyHiddenCount}}
        </div>
        {{/if}}

        <div class="last-sync-info">
          {{localize "CHRONICLE.Dashboard.StatusTab.LastSync"}}: <span>{{lastSyncTime}}</span>
        </div>

        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.StatusTab.RecentActivity"}}</h3>
        <div class="activity-log">
          {{#each activityLog}}
          <div class="log-entry log-{{type}}">
            <span class="log-time">{{this.timeFormatted}}</span>
            <span class="log-icon">
              {{#if (eq type "pull")}}<i class="fa-solid fa-download"></i>{{/if}}
              {{#if (eq type "push")}}<i class="fa-solid fa-upload"></i>{{/if}}
              {{#if (eq type "update")}}<i class="fa-solid fa-pen"></i>{{/if}}
              {{#if (eq type "link")}}<i class="fa-solid fa-link"></i>{{/if}}
              {{#if (eq type "unlink")}}<i class="fa-solid fa-unlink"></i>{{/if}}
              {{#if (eq type "connect")}}<i class="fa-solid fa-bolt"></i>{{/if}}
              {{#if (eq type "error")}}<i class="fa-solid fa-triangle-exclamation"></i>{{/if}}
            </span>
            <span class="log-message">{{message}}</span>
          </div>
          {{else}}
          <div class="cs-state"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><b>{{localize "CHRONICLE.Dashboard.StatusTab.NoActivity"}}</b></div>
          {{/each}}
        </div>

        <div class="status-actions">
          <button type="button" data-action="clear-log" class="dashboard-btn btn-sm">
            <i class="fa-solid fa-trash"></i> {{localize "CHRONICLE.Dashboard.StatusTab.ClearLog"}}
          </button>
        </div>

      </div>
    </div>


    {{!-- ================================================================= --}}
    {{!-- ENTITIES TAB                                                      --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="entities" data-group="primary">
      <div class="dashboard-toolbar">
        <div class="toolbar-actions">
          {{#if hasChronicleOnly}}
          <button type="button" data-action="pull-all" class="dashboard-btn btn-sm" title="{{localize 'CHRONICLE.Dashboard.Entities.PullAllHint'}}">
            <i class="fa-solid fa-download"></i> {{localize "CHRONICLE.Dashboard.Entities.PullAll"}}
          </button>
          {{/if}}
          {{#if hasFoundryOnly}}
          <button type="button" data-action="push-all" class="dashboard-btn btn-sm" title="{{localize 'CHRONICLE.Dashboard.Entities.PushAllHint'}}">
            <i class="fa-solid fa-upload"></i> {{localize "CHRONICLE.Dashboard.Entities.PushAll"}}
          </button>
          {{/if}}
          <button type="button" data-action="resync-all-journals" class="dashboard-btn btn-sm"
                  title="{{localize 'CHRONICLE.Dashboard.Entities.ResyncAllJournalsHint'}}">
            <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.Dashboard.Entities.ResyncAllJournals"}}
          </button>
          <button type="button" data-action="create-entity-type" class="dashboard-btn btn-sm"
                  title="{{localize "CHRONICLE.Dashboard.Entities.CreateType"}}">
            <i class="fa-solid fa-plus"></i> {{localize "CHRONICLE.Dashboard.Entities.CreateType"}}
          </button>
          <button type="button" data-action="refresh" class="dashboard-btn btn-sm" title="{{localize 'CHRONICLE.Dashboard.Entities.RefreshData'}}">
            <i class="fa-solid fa-arrows-rotate"></i>
          </button>
        </div>
        <input type="text" class="dashboard-search" placeholder="{{localize 'CHRONICLE.Dashboard.Entities.SearchPlaceholder'}}" value="{{searchFilter}}"/>
      </div>

      {{!-- Bulk actions toolbar (visible when entities are selected) --}}
      <div class="bulk-toolbar {{#if bulkSelectionCount}}visible{{/if}}">
        <div class="bulk-toolbar-left">
          <label class="bulk-select-all-label">
            <input type="checkbox" class="bulk-select-all-checkbox" />
          </label>
          <span class="bulk-count-badge">{{bulkSelectionCount}} {{localize "CHRONICLE.Dashboard.Bulk.Selected"}}</span>
        </div>
        <div class="bulk-toolbar-actions">
          <select class="bulk-type-select" title="{{localize "CHRONICLE.Dashboard.Bulk.ChangeType"}}">
            <option value="">{{localize "CHRONICLE.Dashboard.Bulk.ChangeType"}}</option>
            {{#each entityTypes}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
          <button type="button" class="dashboard-btn btn-xs" data-action="bulk-set-public"
                  title="{{localize "CHRONICLE.Dashboard.Bulk.MakePublic"}}">
            <i class="fa-solid fa-lock-open"></i>
          </button>
          <button type="button" class="dashboard-btn btn-xs" data-action="bulk-set-private"
                  title="{{localize "CHRONICLE.Dashboard.Bulk.MakePrivate"}}">
            <i class="fa-solid fa-lock"></i>
          </button>
          <button type="button" class="dashboard-btn btn-xs btn-danger" data-action="bulk-delete"
                  title="{{localize "CHRONICLE.Dashboard.Bulk.Delete"}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>

      <div class="entity-list">
        {{#each entityGroups}}
        <div class="entity-type-group">
          {{!-- Type header --}}
          <div class="entity-type-header" data-type-id="{{typeId}}">
            <i class="fa-solid {{#if isCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} collapse-icon"></i>
            <i class="{{typeIcon}}" style="color: {{typeColor}}"></i>
            <span class="type-name">{{typeNamePlural}}</span>
            <span class="type-stats">
              {{localize 'CHRONICLE.Dashboard.Entities.SyncedCount' count=syncedCount}}{{#if chronicleOnlyCount}}{{localize 'CHRONICLE.Dashboard.Entities.ChronicleOnlyCount' count=chronicleOnlyCount}}{{/if}}
            </span>
            <button type="button" class="type-sync-toggle dashboard-btn btn-xs" data-type-id="{{typeId}}"
                    title="{{#if isTypeExcluded}}{{localize 'CHRONICLE.Dashboard.Entities.EnableSync'}}{{else}}{{localize 'CHRONICLE.Dashboard.Entities.DisableSync'}}{{/if}}">
              {{#if isTypeExcluded}}
              <i class="fa-solid fa-toggle-off"></i>
              {{else}}
              <i class="fa-solid fa-toggle-on"></i>
              {{/if}}
            </button>
          </div>

          {{!-- Entity rows --}}
          {{#unless isCollapsed}}
          <div class="entity-rows">
            {{#each entities}}
            <div class="entity-row status-{{status}} {{#if isSelected}}bulk-selected{{/if}}">
              <input type="checkbox" class="bulk-entity-checkbox" data-entity-id="{{id}}" {{#if isSelected}}checked{{/if}} />
              <span class="entity-status-dot" title="{{status}}"></span>
              <span class="entity-name">{{name}}</span>

              {{!-- Visibility badge --}}
              {{#if journalId}}
              <button type="button" class="visibility-badge" data-action="toggle-visibility"
                      data-entity-id="{{id}}" data-is-private="{{isPrivate}}"
                      title="{{#if isPrivate}}{{localize 'CHRONICLE.Dashboard.Entities.PrivateClickPublic'}}{{else}}{{localize 'CHRONICLE.Dashboard.Entities.PublicClickPrivate'}}{{/if}}">
                {{#if isPrivate}}<i class="fa-solid fa-lock"></i>{{else}}<i class="fa-solid fa-lock-open"></i>{{/if}}
              </button>
              {{/if}}

              {{!-- Status label --}}
              <span class="entity-status-label">
                {{#if (eq status "synced")}}<i class="fa-solid fa-check"></i> {{localize "CHRONICLE.Dashboard.Entities.Synced"}}{{/if}}
                {{#if (eq status "modified")}}<i class="fa-solid fa-bolt"></i> {{localize "CHRONICLE.Dashboard.Entities.Modified"}}{{/if}}
                {{#if (eq status "chronicle-only")}}{{localize "CHRONICLE.Dashboard.Entities.ChronicleOnly"}}{{/if}}
              </span>

              {{!-- Action --}}
              {{#if (eq status "chronicle-only")}}
              <button type="button" class="dashboard-btn btn-xs btn-pull" data-action="pull-entity" data-entity-id="{{id}}">
                <i class="fa-solid fa-download"></i> {{localize "CHRONICLE.Dashboard.Entities.Pull"}}
              </button>
              {{else}}
              <label class="entity-sync-checkbox" title="{{#if isExcluded}}{{localize 'CHRONICLE.Dashboard.Entities.SyncDisabled'}}{{else}}{{localize 'CHRONICLE.Dashboard.Entities.SyncEnabled'}}{{/if}}">
                <input type="checkbox" class="entity-sync-toggle" data-entity-id="{{id}}" {{#unless isExcluded}}checked{{/unless}}/>
              </label>
              {{/if}}
            </div>
            {{/each}}
          </div>
          {{/unless}}
        </div>
        {{/each}}

        {{!-- Foundry-only journals --}}
        {{#if foundryOnlyJournals.length}}
        <div class="entity-type-group foundry-only-group">
          <div class="entity-type-header">
            <i class="fa-solid fa-chevron-down collapse-icon"></i>
            <i class="fa-solid fa-file-pen" style="color: #fb923c"></i>
            <span class="type-name">{{localize "CHRONICLE.Dashboard.Entities.FoundryOnlyJournals"}}</span>
            <span class="type-stats">{{foundryOnlyJournals.length}} {{localize "CHRONICLE.Dashboard.Entities.Unlinked"}}</span>
          </div>
          <div class="entity-rows">
            {{#each foundryOnlyJournals}}
            <div class="entity-row status-foundry-only">
              <span class="entity-status-dot" title="{{localize 'CHRONICLE.Dashboard.Entities.FoundryOnlyStatus'}}"></span>
              <span class="entity-name">{{name}}</span>
              <span class="entity-status-label">{{localize "CHRONICLE.Dashboard.Entities.FoundryOnly"}}</span>
              <button type="button" class="dashboard-btn btn-xs btn-push" data-action="push-journal" data-journal-id="{{id}}">
                <i class="fa-solid fa-upload"></i> {{localize "CHRONICLE.Dashboard.Entities.Push"}}
              </button>
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}

        {{!-- Empty / no results states --}}
        {{#unless entityGroups.length}}
        {{#unless foundryOnlyJournals.length}}
        <div class="cs-state dashboard-empty-tab">
          {{#if searchFilter}}
          <i class="fa-solid fa-search" aria-hidden="true"></i>
          <b>{{localize "CHRONICLE.Dashboard.Entities.NoMatch" search=searchFilter}}</b>
          {{else}}
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>
          <b>{{localize "CHRONICLE.Dashboard.Entities.EmptyState"}}</b>
          {{/if}}
        </div>
        {{/unless}}
        {{/unless}}
      </div>
    </div>

    {{!-- ================================================================= --}}
    {{!-- SHOPS TAB                                                         --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="shops" data-group="primary">
      {{#if shops.length}}
      <div class="shop-list">
        {{#each shops}}
        <div class="shop-row {{#if synced}}synced{{/if}}">
          <div class="shop-info">
            <span class="shop-row-icon" style="background-color: {{../shopTypeColor}}20; color: {{../shopTypeColor}}">
              <i class="fa-solid {{../shopTypeIcon}}"></i>
            </span>
            <div class="shop-details">
              <span class="shop-name">{{name}}</span>
              {{#if shopType}}
              <span class="shop-subtype">{{shopType}}</span>
              {{/if}}
              {{#if shopKeeper}}
              <span class="shop-keeper"><i class="fa-solid fa-user"></i> {{shopKeeper}}</span>
              {{/if}}
            </div>
          </div>
          <div class="shop-actions">
            {{#if isPrivate}}
            <span class="shop-private-badge" title="{{localize 'CHRONICLE.Dashboard.Shops.PrivateDmOnly'}}">
              <i class="fa-solid fa-lock"></i>
            </span>
            {{/if}}
            {{#if synced}}
            <span class="shop-synced-badge">
              <i class="fa-solid fa-check"></i> {{localize "CHRONICLE.Dashboard.Shops.Synced"}}
            </span>
            {{/if}}
            <button type="button" class="dashboard-btn btn-sm"
                    data-action="open-shop"
                    data-entity-id="{{id}}"
                    data-shop-name="{{name}}">
              <i class="fa-solid fa-door-open"></i> {{localize "CHRONICLE.Dashboard.Shops.Open"}}
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="cs-state dashboard-empty-tab">
        {{#if shopTypeExists}}
        <i class="fa-solid fa-store" aria-hidden="true"></i>
        <b>{{localize "CHRONICLE.Dashboard.Shops.NoShops"}}</b>
        <p>{{localize "CHRONICLE.Dashboard.Shops.NoShopsHint"}}</p>
        {{else}}
        <i class="fa-solid fa-store" aria-hidden="true"></i>
        <b>{{localize "CHRONICLE.Dashboard.Shops.NoShopType"}}</b>
        <p>{{localize "CHRONICLE.Dashboard.Shops.NoShopTypeHint"}}</p>
        {{/if}}
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- MAPS TAB                                                          --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="maps" data-group="primary">
      <div class="dashboard-toolbar">
        <button type="button" data-action="refresh" class="dashboard-btn btn-sm" title="{{localize 'CHRONICLE.Dashboard.Common.Refresh'}}">
          <i class="fa-solid fa-arrows-rotate"></i>
        </button>
        <button type="button" data-action="resync-all-maps" class="dashboard-btn btn-sm"
                title="{{localize 'CHRONICLE.Dashboard.Maps.ResyncAllHint'}}">
          <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.Dashboard.Maps.ResyncAll"}}
        </button>
        {{#if mapsFolderId}}
        <button type="button" data-action="open-maps-folder" class="dashboard-btn btn-sm"
                data-folder-id="{{mapsFolderId}}"
                title="{{localize 'CHRONICLE.Dashboard.Maps.OpenFolderHint'}}">
          <i class="fa-solid fa-folder-tree"></i> {{localize "CHRONICLE.Dashboard.Maps.OpenFolder"}}
        </button>
        {{/if}}
      </div>

      {{#if mapSyncStatus}}
      <div class="map-status-summary">
        <div class="map-status-row">
          <span class="map-status-label">{{localize "CHRONICLE.Dashboard.Maps.Materialized"}}:</span>
          <span class="map-status-value">{{mapSyncStatus.materializedCount}}</span>
          <span class="map-status-divider">·</span>
          <span class="map-status-label">{{localize "CHRONICLE.Dashboard.Maps.OpenViewers"}}:</span>
          <span class="map-status-value">{{mapSyncStatus.openViewers}}</span>
          <span class="map-status-divider">·</span>
          <span class="map-status-label">{{localize "CHRONICLE.Dashboard.Maps.LastSync"}}:</span>
          <span class="map-status-value">
            {{#if mapSyncStatus.lastSyncAt}}{{timeAgo mapSyncStatus.lastSyncAt}}{{else}}{{localize "CHRONICLE.Dashboard.Maps.NeverSynced"}}{{/if}}
          </span>
        </div>
        {{#if mapSyncStatus.hasErrors}}
        <div class="map-status-errors">
          <div class="map-status-errors-header">
            <span><i class="fa-solid fa-triangle-exclamation"></i>
              {{mapSyncStatus.errorCount}} {{localize "CHRONICLE.Dashboard.Maps.RecentErrors"}}</span>
            <button type="button" data-action="dismiss-map-errors" class="dashboard-btn btn-xs"
                    title="{{localize 'CHRONICLE.Dashboard.Maps.DismissErrorsHint'}}">
              {{localize "CHRONICLE.Dashboard.Maps.DismissErrors"}}
            </button>
          </div>
          <ul class="map-error-list">
            {{#each mapSyncStatus.recentErrors}}
            <li class="map-error-item">
              <span class="map-error-time">{{timeFormatted}}</span>
              <span class="map-error-kind">[{{kind}}{{#if status}} {{status}}{{/if}}]</span>
              {{#if mapId}}<span class="map-error-mapid">{{mapId}}</span>{{/if}}
              <span class="map-error-msg">{{message}}</span>
            </li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
      </div>
      {{/if}}

      <div class="map-list">
        {{#if chronicleMaps.length}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Maps.ChronicleMaps"}}</h3>
        {{#each chronicleMaps}}
        <div class="map-row {{#if materialized}}linked{{/if}}">
          <div class="map-info">
            {{#if thumbSrc}}
            <img class="cs-map-thumb" src="{{thumbSrc}}" alt="" loading="lazy">
            {{else}}
            <i class="fa-solid fa-map" style="color: #60a5fa"></i>
            {{/if}}
            <span class="map-name">{{name}}</span>
          </div>
          <div class="map-link-info">
            {{#if materialized}}
              <span class="map-pin-badge" title="{{localize 'CHRONICLE.Dashboard.Maps.CountsTitle' markers=markerCount drawings=drawingCount tokens=tokenCount}}">
                <i class="fa-solid fa-map-pin"></i> {{markerCount}}
                <i class="fa-solid fa-pen-nib"></i> {{drawingCount}}
                <i class="fa-solid fa-chess-pawn"></i> {{tokenCount}}
              </span>
              {{#if journalEntryId}}
              <button type="button" class="dashboard-btn btn-xs"
                      data-action="open-map-journal"
                      data-journal-entry-id="{{journalEntryId}}"
                      title="{{localize 'CHRONICLE.Dashboard.Maps.OpenInFoundryHint'}}">
                <i class="fa-solid fa-folder-open"></i> {{localize "CHRONICLE.Dashboard.Maps.OpenInFoundry"}}
              </button>
              {{/if}}
            {{else}}
              <span class="map-status-pending">{{localize "CHRONICLE.Dashboard.Maps.NotMaterialized"}}</span>
            {{/if}}
            {{#if chronicleUrl}}
            <a href="{{chronicleUrl}}" target="_blank" class="dashboard-btn btn-xs"
               title="{{localize 'CHRONICLE.Dashboard.Maps.OpenInChronicle'}}">
              <i class="fa-solid fa-external-link-alt"></i>
            </a>
            {{/if}}
          </div>
        </div>
        {{/each}}
        {{else}}
        <div class="cs-state dashboard-empty-tab">
          <i class="fa-solid fa-map" aria-hidden="true"></i>
          <b>{{localize "CHRONICLE.Dashboard.Maps.NoMaps"}}</b>
        </div>
        {{/if}}
      </div>
    </div>

    {{!-- ================================================================= --}}
    {{!-- CHARACTERS TAB                                                    --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="characters" data-group="primary">
      {{!-- Characters that couldn't be matched come first: they need the GM. --}}
      {{#if issues.hasIssues}}
      <section class="character-issues">
      <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Characters.NeedMatch"}}</h3>
      <p class="config-hint">{{issues.headline}}</p>
      <div class="character-list">
        {{#each issues.issues}}
        <div class="character-row issue-row" data-actor-id="{{actorId}}">
          <div class="character-info">
            {{#if img}}
            <img class="character-portrait" src="{{img}}" alt="{{name}}" />
            {{else}}
            <span class="character-portrait-placeholder"><i class="fa-solid fa-user"></i></span>
            {{/if}}
            <div class="character-details">
              <span class="character-name">{{name}}</span>
              <span class="character-sync-status unlinked"><i class="fa-solid fa-link-slash"></i> {{label}}</span>
            </div>
          </div>
          <div class="character-actions issue-actions">
            <select class="issue-match-select" title="{{localize 'CHRONICLE.Dashboard.Characters.MatchSelectTitle'}}">
              <option value="">{{localize "CHRONICLE.Dashboard.Characters.MatchOption"}}</option>
              {{#each options}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            <button type="button" class="dashboard-btn btn-xs btn-push"
                    data-action="resolve-match" data-actor-id="{{actorId}}"
                    title="{{localize 'CHRONICLE.Dashboard.Characters.MatchHint'}}">
              <i class="fa-solid fa-link"></i> {{localize "CHRONICLE.Dashboard.Characters.Match"}}
            </button>
            <button type="button" class="dashboard-btn btn-xs"
                    data-action="resolve-create" data-actor-id="{{actorId}}"
                    title="{{localize 'CHRONICLE.Dashboard.Characters.CreateNewHint'}}">
              <i class="fa-solid fa-plus"></i> {{localize "CHRONICLE.Dashboard.Characters.CreateNew"}}
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      </section>
      {{/if}}
      {{#if characterSyncAvailable}}
        {{#if syncCharacters}}
        {{#if pcClaimingHint}}
        <div class="dashboard-hint">
          <i class="fa-solid fa-circle-info"></i>
          {{{localize "CHRONICLE.Dashboard.Characters.ClaimingHint"}}}
        </div>
        {{/if}}
        <div class="dashboard-toolbar">
          <div class="toolbar-actions">
            <span class="system-badge">
              <i class="fa-solid fa-gamepad"></i> {{matchedSystem}}
            </span>
            {{#if hasUnlinkedCharacters}}
            <button type="button" data-action="push-all-actors" class="dashboard-btn btn-sm" title="{{localize 'CHRONICLE.Dashboard.Characters.PushAllHint'}}">
              <i class="fa-solid fa-upload"></i> {{localize "CHRONICLE.Dashboard.Entities.PushAll"}}
            </button>
            {{/if}}
            <button type="button" data-action="refresh" class="dashboard-btn btn-sm" title="{{localize 'CHRONICLE.Dashboard.Common.Refresh'}}">
              <i class="fa-solid fa-arrows-rotate"></i>
            </button>
          </div>
        </div>

        {{#if characters.length}}
        <div class="character-list">
          {{#each characters}}
          <div class="character-row {{#if synced}}synced{{/if}}">
            <div class="character-info">
              {{#if img}}
              <img class="character-portrait" src="{{img}}" alt="{{name}}" />
              {{else}}
              <span class="character-portrait-placeholder">
                <i class="fa-solid fa-user"></i>
              </span>
              {{/if}}
              <div class="character-details">
                <span class="character-name">{{name}}</span>
                {{#if synced}}
                <span class="character-sync-status synced">
                  <i class="fa-solid fa-check"></i> {{localize "CHRONICLE.Dashboard.Characters.Synced"}}
                </span>
                {{else}}
                <span class="character-sync-status unlinked">
                  <i class="fa-solid fa-unlink"></i> {{localize "CHRONICLE.Dashboard.Characters.NotLinked"}}
                </span>
                {{/if}}
              </div>
            </div>
            <div class="character-actions">
              {{#if synced}}
              <span class="character-last-sync" title="{{lastSync}}">
                {{timeAgo lastSync}}
              </span>
              <button type="button" class="dashboard-btn btn-xs"
                      data-action="resolve-repush" data-actor-id="{{id}}"
                      title="{{localize 'CHRONICLE.Dashboard.Characters.ResyncHint'}}">
                <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.Dashboard.Characters.Resync"}}
              </button>
              {{else}}
              <button type="button" class="dashboard-btn btn-xs btn-push"
                      data-action="push-actor" data-actor-id="{{id}}">
                <i class="fa-solid fa-upload"></i> {{localize "CHRONICLE.Dashboard.Characters.Push"}}
              </button>
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="cs-state dashboard-empty-tab">
          <i class="fa-solid fa-users" aria-hidden="true"></i>
          <b>{{localize "CHRONICLE.Dashboard.Characters.NoActors"}}</b>
          <p>{{localize "CHRONICLE.Dashboard.Characters.NoActorsHint"}}</p>
        </div>
        {{/if}}

        {{else}}
        <div class="cs-state dashboard-empty-tab">
          <i class="fa-solid fa-toggle-off" aria-hidden="true"></i>
          <b>{{localize "CHRONICLE.Dashboard.Characters.Disabled"}}</b>
          <p>{{localize "CHRONICLE.Dashboard.Characters.DisabledHint"}}</p>
          <button type="button" data-action="open-settings" class="dashboard-btn">
            <i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CHRONICLE.Dashboard.OpenSettings"}}
          </button>
        </div>
        {{/if}}
      {{else}}
      <div class="cs-state dashboard-empty-tab">
        <i class="fa-solid fa-puzzle-piece" aria-hidden="true"></i>
        <b>{{localize "CHRONICLE.Dashboard.Characters.NoMatchingSystem"}}{{#if foundrySystem}} (<code>{{foundrySystem}}</code>){{/if}}.</b>
        <ul>
          <li>{{localize "CHRONICLE.Dashboard.Characters.PackageHint"}}</li>
          <li>{{localize "CHRONICLE.Dashboard.Characters.EnabledHint"}}</li>
          <li>{{localize "CHRONICLE.Dashboard.Characters.ConsoleHint"}}</li>
        </ul>
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- CALENDAR TAB                                                      --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="calendar" data-group="primary">
      {{#if calendar.available}}
      <div class="calendar-panel">
        <div class="calendar-date-compare">
          <div class="calendar-date-box">
            <div class="date-label">{{localize "CHRONICLE.Dashboard.Calendar.Chronicle"}}</div>
            <div class="date-value">
              {{localize "CHRONICLE.Dashboard.Calendar.DayMonth" day=calendar.chronicleDate.day month=calendar.chronicleDate.month}}
            </div>
            <div class="date-year">{{localize "CHRONICLE.Dashboard.Calendar.Year" year=calendar.chronicleDate.year}}</div>
            <div class="date-time">
              {{calendar.chronicleDate.hour}}:{{#if (lt calendar.chronicleDate.minute 10)}}0{{/if}}{{calendar.chronicleDate.minute}}
            </div>
          </div>
        </div>

        {{!-- FM-SYNC-SUBRESOURCES-P1: Chronicle world state. Weather, season,
              era and moon phases folded from the WebSocket stream this
              session. Read-only. --}}
        <div class="calendar-worldstate">
          <div class="worldstate-title">
            <i class="fa-solid fa-cloud-sun"></i>
            {{localize "CHRONICLE.Dashboard.Calendar.WorldStateTitle"}}
          </div>
          {{#if calendar.worldState.has}}
          <dl class="worldstate-rows">
            {{#if calendar.worldState.weatherLine}}
            <div class="worldstate-row">
              <dt>{{localize "CHRONICLE.Dashboard.Calendar.Weather"}}</dt>
              <dd>{{calendar.worldState.weatherLine}}</dd>
            </div>
            {{/if}}
            {{#if calendar.worldState.seasonName}}
            <div class="worldstate-row">
              <dt>{{localize "CHRONICLE.Dashboard.Calendar.Season"}}</dt>
              <dd>{{calendar.worldState.seasonName}}</dd>
            </div>
            {{/if}}
            {{#if calendar.worldState.eraName}}
            <div class="worldstate-row">
              <dt>{{localize "CHRONICLE.Dashboard.Calendar.Era"}}</dt>
              <dd>{{calendar.worldState.eraName}}</dd>
            </div>
            {{/if}}
            {{#each calendar.worldState.moons}}
            <div class="worldstate-row">
              <dt>{{this.name}}</dt>
              <dd>{{#if this.phase}}{{this.phase}}{{else}}{{localize "CHRONICLE.Dashboard.Calendar.PhaseChanged"}}{{/if}}</dd>
            </div>
            {{/each}}
          </dl>
          {{else}}
          <p class="action-hint">{{localize "CHRONICLE.Dashboard.Calendar.WorldStateEmpty"}}</p>
          {{/if}}
          <p class="action-hint">{{localize "CHRONICLE.Dashboard.Calendar.WorldStateHint"}}</p>
        </div>
      </div>

      {{else}}
      <div class="cs-state dashboard-empty-tab">
        {{#if calendar.calendarRebuilding}}
        <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>
        <b>{{calendar.rebuildingDetail}}</b>
        <p>{{localize "CHRONICLE.Dashboard.Calendar.RebuildingHint"}}</p>
        {{else if calendar.calendarUnreachable}}
        <i class="fa-solid fa-plug-circle-exclamation" aria-hidden="true"></i>
        <b>{{localize "CHRONICLE.Dashboard.Calendar.UnreachableTitle"}}</b>
        <p>{{localize "CHRONICLE.Dashboard.Calendar.UnreachableHint"}}</p>
        {{else if calendar.noCampaignCalendar}}
        <i class="fa-solid fa-calendar-xmark" aria-hidden="true"></i>
        <b>{{localize "CHRONICLE.Dashboard.Calendar.NoCalendar"}}</b>
        {{else}}
        <i class="fa-solid fa-toggle-off" aria-hidden="true"></i>
        <b>{{localize "CHRONICLE.Dashboard.Calendar.Disabled"}}</b>
        <button type="button" data-action="open-settings" class="dashboard-btn">
          <i class="fa-solid fa-gear" aria-hidden="true"></i> {{localize "CHRONICLE.Dashboard.OpenSettings"}}
        </button>
        {{/if}}
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- DIAGNOSTICS TAB: health, player reports and sync history          --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="diagnostics" data-group="primary">
      <div class="cs-seg" role="tablist" aria-label="{{localize "CHRONICLE.Dashboard.Rail.Diagnostics"}}">
        <button type="button" role="tab" data-diag="health">{{localize "CHRONICLE.Dashboard.Diagnostics.Health"}}</button>
        <button type="button" role="tab" data-diag="reports">{{localize "CHRONICLE.Dashboard.Diagnostics.Reports"}}{{#if debug.unread}} <span class="member-tab-badge">{{debug.unread}}</span>{{/if}}</button>
        <button type="button" role="tab" data-diag="history">{{localize "CHRONICLE.Dashboard.Diagnostics.History"}}</button>
      </div>

      <div class="diag-pane" role="tabpanel" data-diag-pane="health">
      <div class="status-panel">
        {{!-- Game system detection --}}
        <div class="system-detection">
          <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.StatusTab.GameSystem"}}</h3>
          <div class="system-info-grid">
            <div class="system-info-row">
              <span class="system-label">{{localize "CHRONICLE.Dashboard.StatusTab.FoundrySystem"}}:</span>
              <span class="system-value">{{#if foundrySystem}}{{foundrySystem}}{{else}}<em>{{localize "CHRONICLE.Dashboard.Health.NoneValue"}}</em>{{/if}}</span>
            </div>
            <div class="system-info-row">
              <span class="system-label">{{localize "CHRONICLE.Dashboard.StatusTab.ChronicleSystem"}}:</span>
              {{#if systemMatched}}
              <span class="system-value system-matched">
                <i class="fa-solid fa-check-circle"></i> {{localize "CHRONICLE.Dashboard.Health.MatchedLine" system=matchedSystem}}
              </span>
              {{else}}
              <span class="system-value system-no-match">
                <i class="fa-solid fa-circle-xmark"></i> {{localize "CHRONICLE.Dashboard.Health.NoMatchLine"}}
              </span>
              {{/if}}
            </div>
            <div class="system-info-row">
              <span class="system-label">{{localize "CHRONICLE.Dashboard.StatusTab.CharacterSync"}}:</span>
              {{#if characterSyncAvailable}}
                {{#if syncCharacters}}
                <span class="system-value system-matched"><i class="fa-solid fa-toggle-on"></i> {{localize "CHRONICLE.Dashboard.StatusTab.CharacterSyncEnabled"}}</span>
                {{else}}
                <span class="system-value"><i class="fa-solid fa-toggle-off"></i> {{localize "CHRONICLE.Dashboard.StatusTab.CharacterSyncDisabled"}}</span>
                {{/if}}
              {{else}}
              <span class="system-value hint">{{localize "CHRONICLE.Dashboard.StatusTab.CharacterSyncNoSystem"}}</span>
              {{/if}}
            </div>
          </div>
        </div>

        {{!-- Diagnostics section (F-QoL) --}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Diagnostics.Connection"}}</h3>
        <div class="diagnostics-grid">
          <div class="stat-box">
            <div class="stat-value">{{healthMetrics.uptimePercent}}%</div>
            <div class="stat-label">{{localize "CHRONICLE.Dashboard.Health.Uptime"}}</div>
          </div>
          <div class="stat-box">
            <div class="stat-value">{{healthMetrics.restSuccessCount}}</div>
            <div class="stat-label">{{localize "CHRONICLE.Dashboard.Health.ApiOk"}}</div>
          </div>
          <div class="stat-box">
            <div class="stat-value {{#if healthMetrics.restErrorCount}}error-value{{/if}}">{{healthMetrics.restErrorCount}}</div>
            <div class="stat-label">{{localize "CHRONICLE.Dashboard.Health.ApiErrors"}}</div>
          </div>
          <div class="stat-box">
            <div class="stat-value">{{healthMetrics.reconnectAttempts}}</div>
            <div class="stat-label">{{localize "CHRONICLE.Dashboard.Health.Reconnects"}}</div>
          </div>
        </div>
        <div class="diagnostics-detail">
          <div class="system-info-row">
            <span class="system-label">{{localize "CHRONICLE.Dashboard.Health.LastSuccess"}}:</span>
            <span class="system-value">{{healthMetrics.lastRestSuccess}}</span>
          </div>
          <div class="system-info-row">
            <span class="system-label">{{localize "CHRONICLE.Dashboard.Health.LastError"}}:</span>
            <span class="system-value {{#if (neq healthMetrics.lastRestError 'None')}}error-text{{/if}}">{{healthMetrics.lastRestError}}</span>
          </div>
          {{#if healthMetrics.retryQueueSize}}
          <div class="system-info-row">
            <span class="system-label">{{localize "CHRONICLE.Dashboard.Health.PendingRetries"}}:</span>
            <span class="system-value error-text">{{localize "CHRONICLE.Dashboard.Health.OperationsQueued" count=healthMetrics.retryQueueSize}}</span>
          </div>
          {{/if}}
        </div>

        {{!-- Field mapping debug info --}}
        {{#if fieldMappingInfo}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Health.FieldMapping"}}</h3>
        <div class="diagnostics-detail">
          <div class="system-info-row">
            <span class="system-label">{{localize "CHRONICLE.Dashboard.Health.Adapter"}}:</span>
            <span class="system-value">{{fieldMappingInfo.adapterType}} ({{fieldMappingInfo.systemId}})</span>
          </div>
          <div class="system-info-row">
            <span class="system-label">{{localize "CHRONICLE.Dashboard.Health.CharacterType"}}:</span>
            <span class="system-value">{{fieldMappingInfo.characterTypeSlug}}</span>
          </div>
        </div>
        {{/if}}

        {{!-- Sync Capability — what CAN pull vs what DOES (WS-4) --}}
        {{#if capability}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Health.SyncCapability"}}</h3>
        {{#if capability.available}}
        <p class="config-hint">{{localize "CHRONICLE.Dashboard.Health.CapabilityIntro"}}{{#if capability.autoPicked}} {{localize "CHRONICLE.Dashboard.Health.AutoPickedLead"}} <strong>{{capability.source.actorName}}</strong> {{localize "CHRONICLE.Dashboard.Health.AutoPickedMid"}} <code>{{capability.source.actorType}}</code> {{localize "CHRONICLE.Dashboard.Health.AutoPickedTail"}}{{else}} {{localize "CHRONICLE.Dashboard.Health.InspectingLead"}} <strong>{{capability.source.actorName}}</strong> {{localize "CHRONICLE.Dashboard.Health.InspectingMid"}} <code>{{capability.source.actorType}}</code>{{localize "CHRONICLE.Dashboard.Health.InspectingTail"}}{{/if}}</p>
        <div class="capability-actor-picker">
          <label for="capability-actor-select">{{localize "CHRONICLE.Dashboard.Health.InspectActor"}}:</label>
          <select id="capability-actor-select" class="config-select capability-actor-select">
            {{#each capability.actors}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if linked}} {{localize "CHRONICLE.Dashboard.Health.SyncedMark"}}{{/if}}</option>
            {{/each}}
          </select>
        </div>
        <div class="diagnostics-detail">
          <div class="system-info-row"><span class="system-label">{{localize "CHRONICLE.Dashboard.Health.Synced"}}:</span><span class="system-value">{{localize "CHRONICLE.Dashboard.Health.SyncedOfDeclared" synced=capability.summary.synced total=capability.summary.totalDeclared}}</span></div>
          <div class="system-info-row"><span class="system-label">{{localize "CHRONICLE.Dashboard.Health.CollectionMapped"}}:</span><span class="system-value">{{capability.summary.collectionMapped}}</span></div>
          <div class="system-info-row"><span class="system-label">{{localize "CHRONICLE.Dashboard.Health.DeclaredUnmapped"}}:</span><span class="system-value">{{capability.summary.declaredUnmapped}}</span></div>
          <div class="system-info-row"><span class="system-label">{{localize "CHRONICLE.Dashboard.Health.MappedMissing"}}:</span><span class="system-value">{{capability.summary.mappedMissing}}</span></div>
          <div class="system-info-row"><span class="system-label">{{localize "CHRONICLE.Dashboard.Health.AvailableUnmapped"}}:</span><span class="system-value">{{capability.summary.availableUnmapped}}</span></div>
          <div class="system-info-row"><span class="system-label">{{localize "CHRONICLE.Dashboard.Health.Collections"}}:</span><span class="system-value">{{capability.summary.collectionsAvailable}}</span></div>
        </div>
        {{#if capability.gaps.length}}
        <div class="capability-gaps diagnostics-detail">
          {{#each capability.gaps}}
          <div class="system-info-row cap-{{status}}">
            <span class="system-label">{{status}}</span>
            <span class="system-value">{{#if detail}}{{localize "CHRONICLE.Dashboard.Health.GapWithDetail" label=label detail=detail}}{{else}}{{label}}{{/if}}</span>
          </div>
          {{/each}}
        </div>
        {{/if}}
        <div class="config-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-capability">
            <i class="fa-solid fa-clipboard-list"></i> {{localize "CHRONICLE.Dashboard.Health.CopyCapability"}}
          </button>
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-capability-json">
            <i class="fa-solid fa-code"></i> {{localize "CHRONICLE.Dashboard.Health.CopyJson"}}
          </button>
          <span class="debug-copy-result" data-capability-result></span>
        </div>
        {{else}}
        <p class="config-hint">{{#if capability.error}}{{localize "CHRONICLE.Dashboard.Health.NoRepresentativeError" error=capability.error}}{{else}}{{localize "CHRONICLE.Dashboard.Health.NoRepresentative"}}{{/if}}</p>
        {{/if}}
        {{/if}}

        {{!-- Error log --}}
        {{#if hasErrors}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Health.ErrorLog"}}</h3>
        <div class="error-log">
          {{#each errorLog}}
          <div class="log-entry log-error">
            <span class="log-time">{{timeFormatted}}</span>
            <span class="log-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <span class="log-message">{{method}} {{path}}{{#if status}} ({{status}}){{/if}}: {{message}}</span>
          </div>
          {{/each}}
        </div>
        {{/if}}

        {{!-- Diagnostic Bundle (troubleshooting — versions, health, logs, capability) --}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Health.DiagnosticBundle"}}</h3>
        <p class="config-hint">{{localize "CHRONICLE.Dashboard.Health.DiagnosticBundleHint"}}</p>
        <div class="config-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-diagnostic-bundle">
            <i class="fa-solid fa-clipboard-check"></i> {{localize "CHRONICLE.Dashboard.Health.CopyDiagnosticBundle"}}
          </button>
          <span class="debug-copy-result" data-bundle-result></span>
        </div>

        {{!-- System Debug Export --}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Health.SystemDebugExport"}}</h3>
        <p class="config-hint">{{localize "CHRONICLE.Dashboard.Health.SystemDebugExportHint"}}</p>
        <div class="config-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-debug">
            <i class="fa-solid fa-clipboard"></i> {{localize "CHRONICLE.Dashboard.Health.CopySystemDebug"}}
          </button>
          <span class="debug-copy-result" data-debug-result></span>
        </div>

      </div>
      </div>

      <div class="diag-pane" role="tabpanel" data-diag-pane="reports">
      <div class="debug-panel">

        <h3 class="section-heading">{{localize "CHRONICLE.Debug.Reported" count=debug.unread}}</h3>
        {{#each debug.reports}}
        {{#if firstDone}}<h4 class="debug-subheading">{{localize "CHRONICLE.Debug.Done"}}</h4>{{/if}}
        <div class="debug-report{{#if isDone}} debug-report-done{{/if}}">
          <div class="debug-report-head">{{headline}}</div>
          <blockquote class="debug-report-text">{{text}}</blockquote>
          <div class="config-hint">{{attached}}</div>
          <div class="config-actions">
            <button type="button" class="dashboard-btn btn-sm" data-action="debug-open-report" data-report-id="{{id}}">{{#if isOpen}}{{localize "CHRONICLE.Debug.Close"}}{{else}}{{localize "CHRONICLE.Debug.Open"}}{{/if}}</button>
            {{#unless isDone}}<button type="button" class="dashboard-btn btn-sm" data-action="debug-done" data-report-id="{{id}}">{{localize "CHRONICLE.Debug.MarkDone"}}</button>{{/unless}}
            <button type="button" class="dashboard-btn btn-sm" data-action="debug-copy-issue" data-report-id="{{id}}"><i class="fa-solid fa-clipboard"></i> {{localize "CHRONICLE.Debug.CopyIssue"}}</button>
            <span class="debug-copy-result" data-debug-copy-result="{{id}}"></span>
          </div>
          {{#if isOpen}}
          <div class="debug-snapshot">
            {{#if snapshot}}
            {{#if snapshot.rows.length}}
            <table class="debug-table">
              <thead><tr><th>{{localize "CHRONICLE.Debug.Thing"}}</th><th>{{localize "CHRONICLE.Debug.InChronicle"}}</th><th>{{localize "CHRONICLE.Debug.InFoundry"}}</th><th></th></tr></thead>
              <tbody>
                {{#each snapshot.rows}}
                <tr class="debug-row debug-{{status}}"><td>{{thing}}</td><td>{{chronicle}}</td><td>{{foundry}}</td><td>{{statusLabel}}</td></tr>
                {{/each}}
              </tbody>
            </table>
            {{/if}}
            {{#if snapshot.moneyLine}}<p class="config-hint">{{snapshot.moneyLine}}</p>{{/if}}
            {{#each snapshot.log}}
            <div class="log-entry log-{{level}}"><span class="log-time">{{time}}</span><span class="log-message">{{text}}</span></div>
            {{/each}}
            {{#each snapshot.info}}
            <div class="system-info-row"><span class="system-label">{{label}}:</span><span class="system-value">{{value}}</span></div>
            {{/each}}
            {{else}}
            <p class="config-hint">{{noSnapshot}}</p>
            {{/if}}
          </div>
          {{/if}}
        </div>
        {{else}}
        <p class="config-hint">{{localize "CHRONICLE.Debug.NoReports"}}</p>
        {{/each}}

        <h3 class="section-heading">{{localize "CHRONICLE.Debug.SideBySide"}}</h3>
        {{#if debug.actors.length}}
        <div class="capability-actor-picker">
          <select class="config-select debug-actor-select" data-debug-actor aria-label="{{localize 'CHRONICLE.Debug.SideBySide'}}">
            <option value="">{{localize "CHRONICLE.Debug.PickCharacter"}}</option>
            {{#each debug.actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
          {{#if debug.sbs.canCheck}}
          <button type="button" class="dashboard-btn btn-sm" data-action="debug-check" {{#if debug.sbs.loading}}disabled{{/if}}>
            <i class="fa-solid fa-rotate"></i> {{#if debug.sbs.loading}}{{localize "CHRONICLE.Debug.Checking"}}{{else}}{{localize "CHRONICLE.Debug.CheckAgain"}}{{/if}}
          </button>
          {{/if}}
        </div>
        {{#if debug.sbs.error}}<p class="config-hint debug-error">{{debug.sbs.error}}</p>{{/if}}
        {{#if debug.sbs.ready}}
        <table class="debug-table">
          <thead>
            <tr><th>{{localize "CHRONICLE.Debug.Thing"}}</th><th>{{localize "CHRONICLE.Debug.InChronicle"}}</th><th>{{localize "CHRONICLE.Debug.InFoundry"}}</th><th></th></tr>
          </thead>
          <tbody>
            {{#each debug.sbs.rows}}
            <tr class="debug-row debug-{{status}}">
              <td>{{thing}}</td>
              <td>{{chronicle}}</td>
              <td>{{foundry}}</td>
              <td>
                <span class="debug-status">{{statusLabel}}</span>
                <a href="#" class="debug-flag" data-action="debug-report-row" data-thing="{{thing}}" title="{{localize 'CHRONICLE.Debug.ReportRow'}}">&#9873; {{localize "CHRONICLE.Debug.ReportRow"}}</a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{#unless debug.sbs.differences}}<p class="config-hint">{{localize "CHRONICLE.Debug.AllMatch"}}</p>{{/unless}}
        <p class="config-hint">{{debug.sbs.moneyLine}}</p>
        {{/if}}
        {{#if debug.selfReport.open}}
        <div class="debug-report-box">
          <label for="debug-self-report">{{localize "CHRONICLE.Debug.Report.Prompt"}}</label>
          <textarea id="debug-self-report" rows="3" maxlength="{{debug.selfReport.max}}" data-debug-self-text>{{debug.selfReport.text}}</textarea>
          <p class="config-hint">{{localize "CHRONICLE.Debug.Report.Hint"}}</p>
          {{#if debug.selfReport.message}}<p class="config-hint debug-error">{{debug.selfReport.message}}</p>{{/if}}
          <div class="config-actions">
            <button type="button" class="dashboard-btn btn-sm" data-action="debug-report-send">{{localize "CHRONICLE.Debug.Report.Send"}}</button>
            <button type="button" class="dashboard-btn btn-sm" data-action="debug-report-cancel">{{localize "CHRONICLE.Debug.Report.Cancel"}}</button>
          </div>
        </div>
        {{else if debug.selfReport.message}}
        <p class="config-hint">{{debug.selfReport.message}}</p>
        {{/if}}
        {{else}}
        <p class="config-hint">{{localize "CHRONICLE.Debug.NoLinked"}}</p>
        {{/if}}

        <h3 class="section-heading">{{localize "CHRONICLE.Debug.SyncLog"}}</h3>
        <div class="error-log">
          {{#each debug.log}}
          <div class="log-entry log-{{level}}">
            <span class="log-time">{{time}}</span>
            <span class="log-message">{{text}}</span>
          </div>
          {{else}}
          <div class="cs-state"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><b>{{localize "CHRONICLE.Debug.NoLog"}}</b></div>
          {{/each}}
        </div>

        <h3 class="section-heading">{{localize "CHRONICLE.Debug.Info"}}</h3>
        <div class="diagnostics-detail">
          {{#each debug.info}}
          <div class="system-info-row"><span class="system-label">{{label}}:</span><span class="system-value">{{value}}</span></div>
          {{/each}}
        </div>

      </div>
      </div>

      {{!-- Chronicle's sync history, both directions (sync-history-tab.mjs) --}}
      <div class="diag-pane" role="tabpanel" data-diag-pane="history">
      <div class="sync-history" data-history-root>
        <form class="sh-bar" data-history-filters>
          <label class="sh-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" name="q" placeholder="{{localize 'CHRONICLE.Dashboard.History.SearchPlaceholder'}}" aria-label="{{localize 'CHRONICLE.Dashboard.History.SearchLabel'}}">
          </label>
          <select name="direction" aria-label="{{localize 'CHRONICLE.Dashboard.History.Direction'}}">
            <option value="">{{localize "CHRONICLE.Dashboard.History.Both"}}</option>
            <option value="to_foundry">{{localize "CHRONICLE.Dashboard.History.ToFoundry"}}</option>
            <option value="to_chronicle">{{localize "CHRONICLE.Dashboard.History.ToChronicle"}}</option>
            <option value="link">{{localize "CHRONICLE.Dashboard.History.Connects"}}</option>
          </select>
          <label class="sh-check"><input type="checkbox" name="failed"> {{localize "CHRONICLE.Dashboard.History.FailuresOnly"}}</label>
          <button type="button" class="dashboard-btn btn-sm sh-refresh" data-history-refresh title="{{localize 'CHRONICLE.Dashboard.Common.Refresh'}}" aria-label="{{localize 'CHRONICLE.Dashboard.Common.Refresh'}}">
            <i class="fa-solid fa-rotate"></i>
          </button>
        </form>
        <div class="sh-list" data-history-rows></div>
      </div>
      </div>
    </div>

  </section>

  </div>{{!-- /.dashboard-body --}}
  {{/unless}}
</div>
