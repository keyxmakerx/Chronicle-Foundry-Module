{{!-- Chronicle Sync Dashboard - Main tabbed interface --}}
<div class="chronicle-dashboard-inner">

  {{#unless configured}}
  <div class="dashboard-empty">
    <i class="fa-solid fa-plug fa-2x"></i>
    <p>Chronicle Sync is not configured.</p>
    <p class="hint">Go to Module Settings to enter your Chronicle URL, API key, and Campaign ID.</p>
    <button type="button" data-action="open-settings" class="dashboard-btn">
      <i class="fa-solid fa-gear"></i> Open Settings
    </button>
  </div>
  {{else}}

  {{#if loading}}
  <div class="dashboard-loading">
    <i class="fa-solid fa-spinner fa-spin"></i> Loading...
  </div>
  {{/if}}

  {{!-- Load error banner (full width, above the body) --}}
  {{#if hasLoadErrors}}
  <div class="dashboard-load-errors">
    <i class="fa-solid fa-triangle-exclamation"></i>
    Some data failed to load from Chronicle:
    {{#each loadErrors}}
    <span class="load-error-item">{{tab}}{{#unless @last}},{{/unless}}</span>
    {{/each}}
    <button type="button" data-action="refresh" class="dashboard-btn btn-xs" title="Retry">
      <i class="fa-solid fa-arrows-rotate"></i> Retry
    </button>
  </div>
  {{/if}}

  {{!-- Body: left category rail + right content pane --}}
  <div class="dashboard-body">

  {{!-- Left rail: vertical nav grouped by how often a GM needs each section --}}
  <nav class="dashboard-tabs dashboard-rail" data-group="primary">
    <a class="item item-overview" data-tab="overview">
      <i class="fa-solid fa-gauge-high"></i> Overview
    </a>

    <div class="rail-group-label">Everyday</div>
    <a class="item" data-tab="entities">
      <i class="fa-solid fa-book"></i> Entities
    </a>
    <a class="item" data-tab="characters">
      <i class="fa-solid fa-users"></i> Characters
    </a>
    <a class="item" data-tab="calendar">
      <i class="fa-solid fa-calendar"></i> Calendar
    </a>
    <a class="item" data-tab="issues">
      <i class="fa-solid fa-link-slash"></i> Issues
      {{#if issues.hasIssues}}<span class="member-tab-badge" title="{{issues.count}} character(s) need attention">{{issues.count}}</span>{{/if}}
    </a>

    <div class="rail-group-label">Library</div>
    <a class="item" data-tab="shops">
      <i class="fa-solid fa-store"></i> Shops
    </a>
    <a class="item" data-tab="maps">
      <i class="fa-solid fa-map"></i> Maps
    </a>
    <a class="item" data-tab="notes">
      <i class="fa-solid fa-sticky-note"></i> Notes
    </a>

    <div class="rail-group-label">Setup</div>
    <a class="item" data-tab="config">
      <i class="fa-solid fa-sliders"></i> Config
    </a>
    <a class="item" data-tab="members">
      <i class="fa-solid fa-user-shield"></i> Members
      {{#if members.hasUnmatched}}<span class="member-tab-badge" title="{{members.unmatchedCount}} unmatched member(s)">{{members.unmatchedCount}}</span>{{/if}}
    </a>

    <div class="rail-group-label">Diagnostics</div>
    <a class="item" data-tab="status">
      <i class="fa-solid fa-signal"></i> Status
    </a>
  </nav>

  {{!-- Tab content --}}
  <section class="dashboard-content">

    {{!-- ================================================================= --}}
    {{!-- OVERVIEW TAB (landing cockpit)                                    --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="overview" data-group="primary">
      {{#with overview}}
      <div class="overview-panel">

        {{!-- Connection banner --}}
        <div class="connection-status overview-connection state-{{connection.state}}">
          <span class="status-dot"></span>
          <div class="overview-connection-text">
            <strong>{{connection.label}}</strong>
            <span class="overview-sub">{{connection.detail}}</span>
          </div>
          {{#unless connection.ok}}
          <button type="button" class="dashboard-btn btn-sm" data-action="reconnect">
            <i class="fa-solid fa-rotate"></i> Reconnect
          </button>
          {{/unless}}
        </div>

        {{!-- Headline stats (click to jump to the full tab) --}}
        <div class="overview-stats">
          {{#each stats}}
          <button type="button" class="overview-stat" data-jump-tab="{{tab}}" title="Open {{label}}">
            <span class="overview-stat-value">{{value}}</span>
            <span class="overview-stat-label">{{label}}</span>
          </button>
          {{/each}}
        </div>

        {{!-- Needs attention — only problems, each routed to the fixing tab --}}
        <h3 class="section-heading">Needs Attention</h3>
        {{#if attention.length}}
        <div class="overview-attention">
          {{#each attention}}
          <button type="button" class="overview-alert sev-{{severity}}" data-jump-tab="{{tab}}">
            <i class="fa-solid {{icon}}"></i>
            <span class="overview-alert-text">{{text}}</span>
            <i class="fa-solid fa-chevron-right overview-alert-go"></i>
          </button>
          {{/each}}
        </div>
        {{else}}
        <div class="overview-allclear">
          <i class="fa-solid fa-circle-check"></i>
          Everything's in sync — nothing needs your attention.
        </div>
        {{/if}}

        {{!-- Quick actions --}}
        <h3 class="section-heading">Quick Actions</h3>
        <div class="overview-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="resync-all-journals">
            <i class="fa-solid fa-rotate"></i> Sync Journals Now
          </button>
          <button type="button" class="dashboard-btn btn-sm" data-jump-tab="status">
            <i class="fa-solid fa-stethoscope"></i> Diagnostics
          </button>
          <button type="button" class="dashboard-btn btn-sm" data-action="refresh">
            <i class="fa-solid fa-arrows-rotate"></i> Refresh
          </button>
        </div>
      </div>
      {{/with}}
    </div>


    {{!-- ================================================================= --}}
    {{!-- CONFIG TAB                                                        --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="config" data-group="primary">
      <div class="config-panel">

        {{!-- Connection Setup --}}
        <div class="config-section">
          <h3 class="section-heading">Connection</h3>
          <div class="connection-status state-{{connectionState}}">
            <span class="status-dot"></span>
            <span>{{connectionLabel}}</span>
          </div>
          <div class="config-field">
            <label class="config-label">Chronicle URL</label>
            <input type="text" class="config-input" data-config-key="apiUrl" value="{{config.apiUrl}}" placeholder="https://chronicle.example.com" />
          </div>
          <div class="config-field">
            <label class="config-label">API Key</label>
            <input type="password" class="config-input" data-config-key="apiKey" value="{{config.apiKey}}" placeholder="Enter API key" autocomplete="off" />
          </div>
          <div class="config-field">
            <label class="config-label">Campaign ID</label>
            <input type="text" class="config-input" data-config-key="campaignId" value="{{config.campaignId}}" placeholder="Campaign UUID" />
          </div>
          <div class="config-actions">
            <button type="button" class="dashboard-btn btn-sm" data-action="test-connection">
              <i class="fa-solid fa-plug"></i> Test Connection
            </button>
            <div class="config-test-result" data-test-result></div>
          </div>
        </div>

        <p class="config-hint config-offline-note">
          <i class="fa-solid fa-triangle-exclamation"></i>
          {{localize "CHRONICLE.Dashboard.OfflineWarning"}}
        </p>

        {{!-- Import Wizard --}}
        <div class="config-wizard-prompt">
          <button type="button" class="dashboard-btn" data-action="open-wizard">
            <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "CHRONICLE.Wizard.OpenWizard"}}
          </button>
          <p class="config-hint">{{localize "CHRONICLE.Wizard.Hint"}}</p>
        </div>

        {{!-- Sync Scope --}}
        <div class="config-section">
          <h3 class="section-heading">Sync Scope</h3>
          <p class="config-hint">Choose what to sync and in which direction.</p>
          <div class="config-scope-grid">
            {{#each config.syncTypes}}
            <div class="config-scope-row">
              <div class="scope-info">
                <i class="fa-solid {{icon}}"></i>
                <span class="scope-label">{{label}}</span>
                {{#if count}}<span class="scope-count">{{count}}</span>{{/if}}
              </div>
              <select class="config-direction-select" data-sync-type="{{key}}">
                <option value="both" {{#if (eq direction "both")}}selected{{/if}}>Bidirectional</option>
                <option value="pull" {{#if (eq direction "pull")}}selected{{/if}}>Pull Only</option>
                <option value="push" {{#if (eq direction "push")}}selected{{/if}}>Push Only</option>
                <option value="off" {{#if (eq direction "off")}}selected{{/if}}>Off</option>
              </select>
            </div>
            {{/each}}
          </div>
        </div>

        {{!-- Permission Mapping --}}
        <div class="config-section">
          <h3 class="section-heading">Permissions</h3>
          <div class="config-toggle-row">
            <label class="config-toggle-label">
              <input type="checkbox" class="config-checkbox" data-config-key="syncPermissions" {{#if config.syncPermissions}}checked{{/if}} />
              Sync visibility to Foundry ownership
            </label>
          </div>
          <div class="config-toggle-row">
            <label class="config-toggle-label">
              <input type="checkbox" class="config-checkbox" data-config-key="dmOnlyHidden" {{#if config.dmOnlyHidden}}checked{{/if}} />
              DM-only entities hidden in Foundry
            </label>
          </div>
          <div class="config-field">
            <label class="config-label">Default ownership for new documents</label>
            <select class="config-select" data-config-key="defaultOwnership">
              <option value="0" {{#if (eq config.defaultOwnership 0)}}selected{{/if}}>None</option>
              <option value="1" {{#if (eq config.defaultOwnership 1)}}selected{{/if}}>Limited</option>
              <option value="2" {{#if (eq config.defaultOwnership 2)}}selected{{/if}}>Observer</option>
              <option value="3" {{#if (eq config.defaultOwnership 3)}}selected{{/if}}>Owner</option>
            </select>
          </div>
        </div>

        {{!-- Sync Behavior --}}
        <div class="config-section">
          <h3 class="section-heading">Behavior</h3>
          <div class="config-field">
            <label class="config-label">Conflict resolution</label>
            <select class="config-select" data-config-key="conflictResolution">
              <option value="chronicle" {{#if (eq config.conflictResolution "chronicle")}}selected{{/if}}>Chronicle wins</option>
              <option value="foundry" {{#if (eq config.conflictResolution "foundry")}}selected{{/if}}>Foundry wins</option>
              <option value="newest" {{#if (eq config.conflictResolution "newest")}}selected{{/if}}>Newest wins</option>
            </select>
          </div>
          <div class="config-toggle-row">
            <label class="config-toggle-label">
              <input type="checkbox" class="config-checkbox" data-config-key="autoSync" {{#if config.autoSync}}checked{{/if}} />
              Auto-sync on change
            </label>
            <span class="config-hint-inline">When disabled, use Pull/Push buttons to sync manually.</span>
          </div>
        </div>

        {{!-- Exclusion Rules --}}
        <div class="config-section">
          <h3 class="section-heading">Exclusion Rules</h3>
          <div class="config-field">
            <label class="config-label">Excluded tags <span class="config-hint-inline">(comma-separated)</span></label>
            <input type="text" class="config-input" data-config-key="excludedTags" value="{{config.excludedTagsText}}" placeholder="draft, wip, test" />
          </div>
          <div class="config-field">
            <label class="config-label">Exclude by name <span class="config-hint-inline">(entities containing this text)</span></label>
            <input type="text" class="config-input" data-config-key="excludedNamePattern" value="{{config.excludedNamePattern}}" placeholder="e.g. [DRAFT]" />
          </div>
          {{#if config.excludedTypeCount}}
          <p class="config-hint">
            <i class="fa-solid fa-circle-info"></i>
            {{config.excludedTypeCount}} entity type(s) and {{config.excludedEntityCount}} individual entity(ies) excluded via the Entities tab.
          </p>
          {{/if}}
        </div>

        {{!-- Save --}}
        <div class="config-save-bar">
          <button type="button" class="dashboard-btn" data-action="save-config">
            <i class="fa-solid fa-floppy-disk"></i> Save Configuration
          </button>
        </div>

      </div>
    </div>

    {{!-- ================================================================= --}}
    {{!-- ENTITIES TAB                                                      --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="entities" data-group="primary">
      <div class="dashboard-toolbar">
        <div class="toolbar-actions">
          {{#if hasChronicleOnly}}
          <button type="button" data-action="pull-all" class="dashboard-btn btn-sm" title="Pull all Chronicle-only entities">
            <i class="fa-solid fa-download"></i> Pull All
          </button>
          {{/if}}
          {{#if hasFoundryOnly}}
          <button type="button" data-action="push-all" class="dashboard-btn btn-sm" title="Push all Foundry-only journals">
            <i class="fa-solid fa-upload"></i> Push All
          </button>
          {{/if}}
          <button type="button" data-action="resync-all-journals" class="dashboard-btn btn-sm"
                  title="{{localize 'CHRONICLE.Dashboard.Entities.ResyncAllJournalsHint'}}">
            <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.Dashboard.Entities.ResyncAllJournals"}}
          </button>
          <button type="button" data-action="create-entity-type" class="dashboard-btn btn-sm"
                  title="{{localize "CHRONICLE.Dashboard.Entities.CreateType"}}">
            <i class="fa-solid fa-plus"></i> {{localize "CHRONICLE.Dashboard.Entities.CreateType"}}
          </button>
          <button type="button" data-action="refresh" class="dashboard-btn btn-sm" title="Refresh data">
            <i class="fa-solid fa-arrows-rotate"></i>
          </button>
        </div>
        <input type="text" class="dashboard-search" placeholder="Search entities..." value="{{searchFilter}}"/>
      </div>

      {{!-- Bulk actions toolbar (visible when entities are selected) --}}
      <div class="bulk-toolbar {{#if bulkSelectionCount}}visible{{/if}}">
        <div class="bulk-toolbar-left">
          <label class="bulk-select-all-label">
            <input type="checkbox" class="bulk-select-all-checkbox" />
          </label>
          <span class="bulk-count-badge">{{bulkSelectionCount}} {{localize "CHRONICLE.Dashboard.Bulk.Selected"}}</span>
        </div>
        <div class="bulk-toolbar-actions">
          <select class="bulk-type-select" title="{{localize "CHRONICLE.Dashboard.Bulk.ChangeType"}}">
            <option value="">{{localize "CHRONICLE.Dashboard.Bulk.ChangeType"}}</option>
            {{#each entityTypes}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
          <button type="button" class="dashboard-btn btn-xs" data-action="bulk-set-public"
                  title="{{localize "CHRONICLE.Dashboard.Bulk.MakePublic"}}">
            <i class="fa-solid fa-lock-open"></i>
          </button>
          <button type="button" class="dashboard-btn btn-xs" data-action="bulk-set-private"
                  title="{{localize "CHRONICLE.Dashboard.Bulk.MakePrivate"}}">
            <i class="fa-solid fa-lock"></i>
          </button>
          <button type="button" class="dashboard-btn btn-xs btn-danger" data-action="bulk-delete"
                  title="{{localize "CHRONICLE.Dashboard.Bulk.Delete"}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>

      <div class="entity-list">
        {{#each entityGroups}}
        <div class="entity-type-group">
          {{!-- Type header --}}
          <div class="entity-type-header" data-type-id="{{typeId}}">
            <i class="fa-solid {{#if isCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}} collapse-icon"></i>
            <i class="{{typeIcon}}" style="color: {{typeColor}}"></i>
            <span class="type-name">{{typeNamePlural}}</span>
            <span class="type-stats">
              {{syncedCount}} synced{{#if chronicleOnlyCount}}, {{chronicleOnlyCount}} Chronicle-only{{/if}}
            </span>
            <button type="button" class="type-sync-toggle dashboard-btn btn-xs" data-type-id="{{typeId}}"
                    title="{{#if isTypeExcluded}}Enable sync for this type{{else}}Disable sync for this type{{/if}}">
              {{#if isTypeExcluded}}
              <i class="fa-solid fa-toggle-off"></i>
              {{else}}
              <i class="fa-solid fa-toggle-on"></i>
              {{/if}}
            </button>
          </div>

          {{!-- Entity rows --}}
          {{#unless isCollapsed}}
          <div class="entity-rows">
            {{#each entities}}
            <div class="entity-row status-{{status}} {{#if isSelected}}bulk-selected{{/if}}">
              <input type="checkbox" class="bulk-entity-checkbox" data-entity-id="{{id}}" {{#if isSelected}}checked{{/if}} />
              <span class="entity-status-dot" title="{{status}}"></span>
              <span class="entity-name">{{name}}</span>

              {{!-- Visibility badge --}}
              {{#if journalId}}
              <button type="button" class="visibility-badge" data-action="toggle-visibility"
                      data-entity-id="{{id}}" data-is-private="{{isPrivate}}"
                      title="{{#if isPrivate}}Private — click to make public{{else}}Public — click to make private{{/if}}">
                {{#if isPrivate}}<i class="fa-solid fa-lock"></i>{{else}}<i class="fa-solid fa-lock-open"></i>{{/if}}
              </button>
              {{/if}}

              {{!-- Status label --}}
              <span class="entity-status-label">
                {{#if (eq status "synced")}}<i class="fa-solid fa-check"></i> Synced{{/if}}
                {{#if (eq status "modified")}}<i class="fa-solid fa-bolt"></i> Modified{{/if}}
                {{#if (eq status "chronicle-only")}}Chronicle{{/if}}
              </span>

              {{!-- Action --}}
              {{#if (eq status "chronicle-only")}}
              <button type="button" class="dashboard-btn btn-xs btn-pull" data-action="pull-entity" data-entity-id="{{id}}">
                <i class="fa-solid fa-download"></i> Pull
              </button>
              {{else}}
              <label class="entity-sync-checkbox" title="{{#if isExcluded}}Sync disabled{{else}}Sync enabled{{/if}}">
                <input type="checkbox" class="entity-sync-toggle" data-entity-id="{{id}}" {{#unless isExcluded}}checked{{/unless}}/>
              </label>
              {{/if}}
            </div>
            {{/each}}
          </div>
          {{/unless}}
        </div>
        {{/each}}

        {{!-- Foundry-only journals --}}
        {{#if foundryOnlyJournals.length}}
        <div class="entity-type-group foundry-only-group">
          <div class="entity-type-header">
            <i class="fa-solid fa-chevron-down collapse-icon"></i>
            <i class="fa-solid fa-file-pen" style="color: #fb923c"></i>
            <span class="type-name">Foundry-Only Journals</span>
            <span class="type-stats">{{foundryOnlyJournals.length}} unlinked</span>
          </div>
          <div class="entity-rows">
            {{#each foundryOnlyJournals}}
            <div class="entity-row status-foundry-only">
              <span class="entity-status-dot" title="Foundry-only"></span>
              <span class="entity-name">{{name}}</span>
              <span class="entity-status-label">Foundry</span>
              <button type="button" class="dashboard-btn btn-xs btn-push" data-action="push-journal" data-journal-id="{{id}}">
                <i class="fa-solid fa-upload"></i> Push
              </button>
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}

        {{!-- Empty / no results states --}}
        {{#unless entityGroups.length}}
        {{#unless foundryOnlyJournals.length}}
        <div class="dashboard-empty-tab">
          {{#if searchFilter}}
          <i class="fa-solid fa-search fa-2x"></i>
          <p>No entities match "{{searchFilter}}".</p>
          {{else}}
          <p>No entities found. Create entities in Chronicle or journals in Foundry to get started.</p>
          {{/if}}
        </div>
        {{/unless}}
        {{/unless}}
      </div>
    </div>

    {{!-- ================================================================= --}}
    {{!-- SHOPS TAB                                                         --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="shops" data-group="primary">
      {{#if shops.length}}
      <div class="shop-list">
        {{#each shops}}
        <div class="shop-row {{#if synced}}synced{{/if}}">
          <div class="shop-info">
            <span class="shop-row-icon" style="background-color: {{../shopTypeColor}}20; color: {{../shopTypeColor}}">
              <i class="fa-solid {{../shopTypeIcon}}"></i>
            </span>
            <div class="shop-details">
              <span class="shop-name">{{name}}</span>
              {{#if shopType}}
              <span class="shop-subtype">{{shopType}}</span>
              {{/if}}
              {{#if shopKeeper}}
              <span class="shop-keeper"><i class="fa-solid fa-user"></i> {{shopKeeper}}</span>
              {{/if}}
            </div>
          </div>
          <div class="shop-actions">
            {{#if isPrivate}}
            <span class="shop-private-badge" title="Private (DM only)">
              <i class="fa-solid fa-lock"></i>
            </span>
            {{/if}}
            {{#if synced}}
            <span class="shop-synced-badge">
              <i class="fa-solid fa-check"></i> Synced
            </span>
            {{/if}}
            <button type="button" class="dashboard-btn btn-sm"
                    data-action="open-shop"
                    data-entity-id="{{id}}"
                    data-shop-name="{{name}}">
              <i class="fa-solid fa-door-open"></i> Open
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="dashboard-empty-tab">
        {{#if shopTypeExists}}
        <i class="fa-solid fa-store fa-2x"></i>
        <p>No shops found in this campaign.</p>
        <p class="hint">Create shop entities in Chronicle to see them here.</p>
        {{else}}
        <i class="fa-solid fa-store fa-2x"></i>
        <p>No shop entity type found.</p>
        <p class="hint">Add a "Shop" entity type to your campaign in Chronicle.</p>
        {{/if}}
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- MAPS TAB                                                          --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="maps" data-group="primary">
      <div class="dashboard-toolbar">
        <button type="button" data-action="refresh" class="dashboard-btn btn-sm" title="Refresh">
          <i class="fa-solid fa-arrows-rotate"></i>
        </button>
        <button type="button" data-action="resync-all-maps" class="dashboard-btn btn-sm"
                title="{{localize 'CHRONICLE.Dashboard.Maps.ResyncAllHint'}}">
          <i class="fa-solid fa-rotate"></i> {{localize "CHRONICLE.Dashboard.Maps.ResyncAll"}}
        </button>
        {{#if mapsFolderId}}
        <button type="button" data-action="open-maps-folder" class="dashboard-btn btn-sm"
                data-folder-id="{{mapsFolderId}}"
                title="{{localize 'CHRONICLE.Dashboard.Maps.OpenFolderHint'}}">
          <i class="fa-solid fa-folder-tree"></i> {{localize "CHRONICLE.Dashboard.Maps.OpenFolder"}}
        </button>
        {{/if}}
      </div>

      {{#if mapSyncStatus}}
      <div class="map-status-summary">
        <div class="map-status-row">
          <span class="map-status-label">{{localize "CHRONICLE.Dashboard.Maps.Materialized"}}:</span>
          <span class="map-status-value">{{mapSyncStatus.materializedCount}}</span>
          <span class="map-status-divider">·</span>
          <span class="map-status-label">{{localize "CHRONICLE.Dashboard.Maps.OpenViewers"}}:</span>
          <span class="map-status-value">{{mapSyncStatus.openViewers}}</span>
          <span class="map-status-divider">·</span>
          <span class="map-status-label">{{localize "CHRONICLE.Dashboard.Maps.LastSync"}}:</span>
          <span class="map-status-value">
            {{#if mapSyncStatus.lastSyncAt}}{{timeAgo mapSyncStatus.lastSyncAt}}{{else}}{{localize "CHRONICLE.Dashboard.Maps.NeverSynced"}}{{/if}}
          </span>
        </div>
        {{#if mapSyncStatus.hasErrors}}
        <div class="map-status-errors">
          <div class="map-status-errors-header">
            <span><i class="fa-solid fa-triangle-exclamation"></i>
              {{mapSyncStatus.errorCount}} {{localize "CHRONICLE.Dashboard.Maps.RecentErrors"}}</span>
            <button type="button" data-action="dismiss-map-errors" class="dashboard-btn btn-xs"
                    title="{{localize 'CHRONICLE.Dashboard.Maps.DismissErrorsHint'}}">
              {{localize "CHRONICLE.Dashboard.Maps.DismissErrors"}}
            </button>
          </div>
          <ul class="map-error-list">
            {{#each mapSyncStatus.recentErrors}}
            <li class="map-error-item">
              <span class="map-error-time">{{timeFormatted}}</span>
              <span class="map-error-kind">[{{kind}}{{#if status}} {{status}}{{/if}}]</span>
              {{#if mapId}}<span class="map-error-mapid">{{mapId}}</span>{{/if}}
              <span class="map-error-msg">{{message}}</span>
            </li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
      </div>
      {{/if}}

      <div class="map-list">
        {{#if chronicleMaps.length}}
        <h3 class="section-heading">{{localize "CHRONICLE.Dashboard.Maps.ChronicleMaps"}}</h3>
        {{#each chronicleMaps}}
        <div class="map-row {{#if materialized}}linked{{/if}}">
          <div class="map-info">
            <i class="fa-solid fa-map" style="color: #60a5fa"></i>
            <span class="map-name">{{name}}</span>
          </div>
          <div class="map-link-info">
            {{#if materialized}}
              <span class="map-pin-badge" title="{{markerCount}} markers / {{drawingCount}} drawings / {{tokenCount}} tokens">
                <i class="fa-solid fa-map-pin"></i> {{markerCount}}
                <i class="fa-solid fa-pen-nib"></i> {{drawingCount}}
                <i class="fa-solid fa-chess-pawn"></i> {{tokenCount}}
              </span>
              {{#if journalEntryId}}
              <button type="button" class="dashboard-btn btn-xs"
                      data-action="open-map-journal"
                      data-journal-entry-id="{{journalEntryId}}"
                      title="{{localize 'CHRONICLE.Dashboard.Maps.OpenInFoundryHint'}}">
                <i class="fa-solid fa-folder-open"></i> {{localize "CHRONICLE.Dashboard.Maps.OpenInFoundry"}}
              </button>
              {{/if}}
            {{else}}
              <span class="map-status-pending">{{localize "CHRONICLE.Dashboard.Maps.NotMaterialized"}}</span>
            {{/if}}
            {{#if chronicleUrl}}
            <a href="{{chronicleUrl}}" target="_blank" class="dashboard-btn btn-xs"
               title="{{localize 'CHRONICLE.Dashboard.Maps.OpenInChronicle'}}">
              <i class="fa-solid fa-external-link-alt"></i>
            </a>
            {{/if}}
          </div>
        </div>
        {{/each}}
        {{else}}
        <div class="dashboard-empty-tab">
          <p>{{localize "CHRONICLE.Dashboard.Maps.NoMaps"}}</p>
        </div>
        {{/if}}
      </div>
    </div>

    {{!-- ================================================================= --}}
    {{!-- CHARACTERS TAB                                                    --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="characters" data-group="primary">
      {{#if characterSyncAvailable}}
        {{#if syncCharacters}}
        {{#if pcClaimingHint}}
        <div class="dashboard-hint">
          <i class="fa-solid fa-circle-info"></i>
          Enable <strong>Player Character Claiming</strong> in Chronicle to sync player claims.
        </div>
        {{/if}}
        <div class="dashboard-toolbar">
          <div class="toolbar-actions">
            <span class="system-badge">
              <i class="fa-solid fa-gamepad"></i> {{matchedSystem}}
            </span>
            {{#if hasUnlinkedCharacters}}
            <button type="button" data-action="push-all-actors" class="dashboard-btn btn-sm" title="Push all unlinked actors to Chronicle">
              <i class="fa-solid fa-upload"></i> Push All
            </button>
            {{/if}}
            <button type="button" data-action="refresh" class="dashboard-btn btn-sm" title="Refresh">
              <i class="fa-solid fa-arrows-rotate"></i>
            </button>
          </div>
        </div>

        {{#if characters.length}}
        <div class="character-list">
          {{#each characters}}
          <div class="character-row {{#if synced}}synced{{/if}}">
            <div class="character-info">
              {{#if img}}
              <img class="character-portrait" src="{{img}}" alt="{{name}}" />
              {{else}}
              <span class="character-portrait-placeholder">
                <i class="fa-solid fa-user"></i>
              </span>
              {{/if}}
              <div class="character-details">
                <span class="character-name">{{name}}</span>
                {{#if synced}}
                <span class="character-sync-status synced">
                  <i class="fa-solid fa-check"></i> Synced
                </span>
                {{else}}
                <span class="character-sync-status unlinked">
                  <i class="fa-solid fa-unlink"></i> Not linked
                </span>
                {{/if}}
              </div>
            </div>
            <div class="character-actions">
              {{#if synced}}
              <span class="character-last-sync" title="{{lastSync}}">
                {{timeAgo lastSync}}
              </span>
              <button type="button" class="dashboard-btn btn-xs"
                      data-action="resolve-repush" data-actor-id="{{id}}"
                      title="Re-push this actor's current data to Chronicle">
                <i class="fa-solid fa-rotate"></i> Re-sync
              </button>
              {{else}}
              <button type="button" class="dashboard-btn btn-xs btn-push"
                      data-action="push-actor" data-actor-id="{{id}}">
                <i class="fa-solid fa-upload"></i> Push
              </button>
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        {{else}}
        <div class="dashboard-empty-tab">
          <i class="fa-solid fa-users fa-2x"></i>
          <p>No character actors found.</p>
          <p class="hint">Create character actors in Foundry or character entities in Chronicle.</p>
        </div>
        {{/if}}

        {{else}}
        <div class="dashboard-empty-tab">
          <i class="fa-solid fa-toggle-off fa-2x"></i>
          <p>Character sync is disabled.</p>
          <p class="hint">Enable "Sync Characters" in Module Settings to sync actors with Chronicle.</p>
          <button type="button" data-action="open-settings" class="dashboard-btn">
            <i class="fa-solid fa-gear"></i> Open Settings
          </button>
        </div>
        {{/if}}
      {{else}}
      <div class="dashboard-empty-tab">
        <i class="fa-solid fa-puzzle-piece fa-2x"></i>
        <p>No Chronicle system matches your Foundry game system{{#if foundrySystem}} (<code>{{foundrySystem}}</code>){{/if}}.</p>
        <ul class="hint" style="text-align: left; margin-top: 0.5rem;">
          <li>Is the game system package installed in Chronicle? (Admin &rarr; Packages)</li>
          <li>Is it enabled for this campaign? (Campaign Settings &rarr; Game System)</li>
          <li>Check the browser console for detailed diagnostics.</li>
        </ul>
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- ISSUES TAB (character link resolver)                              --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="issues" data-group="primary">
      {{#if issues.hasIssues}}
      <div class="dashboard-hint">
        <i class="fa-solid fa-triangle-exclamation"></i> {{issues.headline}}
      </div>
      <div class="character-list">
        {{#each issues.issues}}
        <div class="character-row issue-row" data-actor-id="{{actorId}}">
          <div class="character-info">
            {{#if img}}
            <img class="character-portrait" src="{{img}}" alt="{{name}}" />
            {{else}}
            <span class="character-portrait-placeholder"><i class="fa-solid fa-user"></i></span>
            {{/if}}
            <div class="character-details">
              <span class="character-name">{{name}}</span>
              <span class="character-sync-status unlinked"><i class="fa-solid fa-link-slash"></i> {{label}}</span>
            </div>
          </div>
          <div class="character-actions issue-actions">
            <select class="issue-match-select" title="Match to an existing Chronicle character">
              <option value="">— Match to existing… —</option>
              {{#each options}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
            <button type="button" class="dashboard-btn btn-xs btn-push"
                    data-action="resolve-match" data-actor-id="{{actorId}}"
                    title="Link to the selected character and push this actor's data">
              <i class="fa-solid fa-link"></i> Match
            </button>
            <button type="button" class="dashboard-btn btn-xs"
                    data-action="resolve-create" data-actor-id="{{actorId}}"
                    title="Create a new Chronicle character of the correct type and link it">
              <i class="fa-solid fa-plus"></i> Create new
            </button>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="dashboard-empty-tab">
        <i class="fa-solid fa-circle-check fa-2x"></i>
        <p>No character sync issues.</p>
        <p class="hint">Every character actor is linked to a Chronicle entity. If a linked character's data looks stale, use the <strong>Re-sync</strong> button on the Characters tab.</p>
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- MEMBERS TAB                                                       --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="members" data-group="primary">
      <div class="dashboard-toolbar">
        <div class="toolbar-title">
          <i class="fa-solid fa-user-shield"></i>
          {{localize "CHRONICLE.Dashboard.Members.Title"}}
        </div>
        <div class="toolbar-actions">
          <button type="button" data-action="refresh-members" class="dashboard-btn btn-sm" title="{{localize "CHRONICLE.Dashboard.Members.RefreshHint"}}">
            <i class="fa-solid fa-arrows-rotate"></i> {{localize "CHRONICLE.Dashboard.Members.Refresh"}}
          </button>
        </div>
      </div>

      <p class="config-hint">{{localize "CHRONICLE.Dashboard.Members.Intro"}}</p>

      {{#if members.hasUnmatched}}
      <div class="dashboard-load-errors member-unmatched-banner">
        <i class="fa-solid fa-triangle-exclamation"></i>
        {{localize "CHRONICLE.Dashboard.Members.UnmatchedWarning" count=members.unmatchedCount}}
      </div>
      {{/if}}

      {{#if members.hasMembers}}
      <div class="member-list">
        {{#each members.rows}}
        <div class="member-row {{#if matched}}matched{{else}}unmatched{{/if}}">
          <div class="member-info">
            <span class="member-name">{{name}}</span>
            {{#if role}}<span class="member-role">{{role}}</span>{{/if}}
            {{#if matched}}
            <span class="member-badge matched"><i class="fa-solid fa-check"></i> {{localize "CHRONICLE.Dashboard.Members.Matched"}}</span>
            {{else}}
            <span class="member-badge unmatched"><i class="fa-solid fa-circle-exclamation"></i> {{localize "CHRONICLE.Dashboard.Members.Unmatched"}}</span>
            {{/if}}
          </div>
          <div class="member-actions">
            <label class="member-map-label">{{localize "CHRONICLE.Dashboard.Members.FoundryUser"}}</label>
            <select class="member-map-select" data-member-key="{{key}}">
              {{#each options}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="dashboard-empty-tab">
        <i class="fa-solid fa-user-shield fa-2x"></i>
        <p>{{localize "CHRONICLE.Dashboard.Members.NoMembers"}}</p>
        <p class="hint">{{localize "CHRONICLE.Dashboard.Members.NoMembersHint"}}</p>
        <button type="button" data-action="refresh-members" class="dashboard-btn">
          <i class="fa-solid fa-arrows-rotate"></i> {{localize "CHRONICLE.Dashboard.Members.Refresh"}}
        </button>
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- NOTES TAB                                                         --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="notes" data-group="primary">
      {{#if notes.length}}
      <div class="notes-list">
        {{#each notes}}
        <div class="note-row {{status}}" data-note-id="{{id}}">
          <span class="note-icon"><i class="fa-solid fa-sticky-note" {{#if color}}style="color: {{color}}"{{/if}}></i></span>
          <span class="note-title">{{title}}</span>
          <span class="note-status badge badge-{{status}}">{{status}}</span>
          <span class="note-shared">{{#if is_shared}}<i class="fa-solid fa-users" title="Shared"></i>{{else}}<i class="fa-solid fa-lock" title="Private"></i>{{/if}}</span>
          <span class="note-sync-time">{{#if lastSync}}{{timeAgo lastSync}}{{else}}Never{{/if}}</span>
          {{#if (eq status "chronicle-only")}}
          <button type="button" data-action="pull-note" data-note-id="{{id}}" class="dashboard-btn btn-xs" title="Pull to Foundry">
            <i class="fa-solid fa-download"></i>
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="dashboard-empty-tab">
        <i class="fa-solid fa-sticky-note fa-2x"></i>
        <p>No Chronicle notes found.</p>
        <p class="hint">Notes created in Chronicle will appear here when note sync is enabled.</p>
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- CALENDAR TAB                                                      --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="calendar" data-group="primary">
      {{!-- FM-CAL-DASHBOARD-LINK: surface the Sync Calendar editor. The
           dashboard's Calendar tab is a status panel; the Sync Calendar
           app is the full editor (import / events / moon strip /
           validation). Surface it here so the operator doesn't have to
           dig through Game Settings → Module Settings to find it. --}}
      <div class="calendar-tab-actions">
        <button type="button" data-action="open-sync-calendar" class="dashboard-btn primary-action">
          <i class="fa-solid fa-calendar-days"></i>
          {{localize "CHRONICLE.Dashboard.Calendar.OpenSyncCalendar"}}
        </button>
        <p class="action-hint">{{localize "CHRONICLE.Dashboard.Calendar.OpenSyncCalendarHint"}}</p>
      </div>
      {{#if calendar.available}}
      <div class="calendar-panel">
        <div class="calendar-module-info">
          <i class="fa-solid fa-check-circle" style="color: #4ade80"></i>
          Calendar Module: <strong>{{calendar.module}}</strong>
        </div>

        <div class="calendar-date-compare">
          <div class="calendar-date-box">
            <div class="date-label">Chronicle</div>
            <div class="date-value">
              Day {{calendar.chronicleDate.day}}, Month {{calendar.chronicleDate.month}}
            </div>
            <div class="date-year">Year {{calendar.chronicleDate.year}}</div>
            <div class="date-time">
              {{calendar.chronicleDate.hour}}:{{#if (lt calendar.chronicleDate.minute 10)}}0{{/if}}{{calendar.chronicleDate.minute}}
            </div>
          </div>

          <div class="calendar-date-box">
            <div class="date-label">Foundry</div>
            {{#if calendar.localDate}}
            <div class="date-value">
              Day {{calendar.localDate.day}}, Month {{calendar.localDate.month}}
            </div>
            <div class="date-year">Year {{calendar.localDate.year}}</div>
            <div class="date-time">
              {{calendar.localDate.hour}}:{{#if (lt calendar.localDate.minute 10)}}0{{/if}}{{calendar.localDate.minute}}
            </div>
            {{else}}
            <div class="date-value">Unable to read</div>
            {{/if}}
          </div>
        </div>

        <div class="calendar-status">
          {{#if calendar.inSync}}
          <span class="sync-badge synced"><i class="fa-solid fa-check"></i> In Sync</span>
          {{else}}
          <span class="sync-badge out-of-sync"><i class="fa-solid fa-exclamation-triangle"></i> Out of Sync</span>
          {{/if}}
        </div>

        <div class="calendar-actions">
          <button type="button" data-action="pull-date" class="dashboard-btn">
            <i class="fa-solid fa-download"></i> Pull Date from Chronicle
          </button>
          <button type="button" data-action="push-date" class="dashboard-btn">
            <i class="fa-solid fa-upload"></i> Push Date to Chronicle
          </button>
        </div>
      </div>

      {{else}}
      <div class="dashboard-empty-tab">
        {{#if calendar.noCampaignCalendar}}
        <i class="fa-solid fa-calendar-xmark fa-2x"></i>
        <p>No calendar configured for this campaign in Chronicle.</p>
        {{else if calendar.enabled}}
          {{#unless calendar.module}}
          <i class="fa-solid fa-puzzle-piece fa-2x"></i>
          <p>No calendar module detected.</p>
          <p class="hint">Install <strong>Calendaria</strong> or <strong>Simple Calendar</strong> to enable calendar sync.</p>
          {{/unless}}
        {{else}}
        <i class="fa-solid fa-toggle-off fa-2x"></i>
        <p>Calendar sync is disabled. Enable it in Module Settings.</p>
        <button type="button" data-action="open-settings" class="dashboard-btn">
          <i class="fa-solid fa-gear"></i> Open Settings
        </button>
        {{/if}}
      </div>
      {{/if}}
    </div>

    {{!-- ================================================================= --}}
    {{!-- STATUS TAB                                                        --}}
    {{!-- ================================================================= --}}
    <div class="tab" data-tab="status" data-group="primary">
      <div class="status-panel">
        <div class="connection-status state-{{connectionState}}">
          <span class="status-dot"></span>
          <span>Connection: <strong>{{connectionLabel}}</strong></span>
        </div>

        <div class="sync-stats">
          <div class="stat-box">
            <div class="stat-value">{{syncedEntities}}</div>
            <div class="stat-label">Entities Synced</div>
          </div>
          <div class="stat-box">
            <div class="stat-value">{{linkedScenes}}</div>
            <div class="stat-label">Maps Linked</div>
          </div>
        </div>

        {{!-- DM-only clarification (audit §1A): a private entity that correctly
              lands hidden-from-players is not "didn't sync" — it reached the GM. --}}
        {{#if dmOnlyHiddenCount}}
        <div class="dashboard-hint dm-only-hint">
          <i class="fa-solid fa-user-secret"></i>
          {{localize "CHRONICLE.Dashboard.StatusTab.DmOnlyHiddenNote" count=dmOnlyHiddenCount}}
        </div>
        {{/if}}

        {{!-- Game system detection --}}
        <div class="system-detection">
          <h3 class="section-heading">Game System</h3>
          <div class="system-info-grid">
            <div class="system-info-row">
              <span class="system-label">Foundry System:</span>
              <span class="system-value">{{#if foundrySystem}}{{foundrySystem}}{{else}}<em>None</em>{{/if}}</span>
            </div>
            <div class="system-info-row">
              <span class="system-label">Chronicle System:</span>
              {{#if systemMatched}}
              <span class="system-value system-matched">
                <i class="fa-solid fa-check-circle" style="color: #4ade80"></i> {{matchedSystem}} — Matched
              </span>
              {{else}}
              <span class="system-value system-no-match">
                <i class="fa-solid fa-circle-xmark" style="color: #f87171"></i> No match &mdash; check Packages &amp; Campaign Settings
              </span>
              {{/if}}
            </div>
            <div class="system-info-row">
              <span class="system-label">Character Sync:</span>
              {{#if characterSyncAvailable}}
                {{#if syncCharacters}}
                <span class="system-value"><i class="fa-solid fa-toggle-on" style="color: #4ade80"></i> Enabled</span>
                {{else}}
                <span class="system-value"><i class="fa-solid fa-toggle-off"></i> Disabled</span>
                {{/if}}
              {{else}}
              <span class="system-value hint">Requires matching game system</span>
              {{/if}}
            </div>
          </div>
        </div>

        <div class="last-sync-info">
          Last sync: <span>{{lastSyncTime}}</span>
        </div>

        {{!-- Diagnostics section (F-QoL) --}}
        <h3 class="section-heading">Diagnostics</h3>
        <div class="diagnostics-grid">
          <div class="stat-box">
            <div class="stat-value">{{healthMetrics.uptimePercent}}%</div>
            <div class="stat-label">Uptime</div>
          </div>
          <div class="stat-box">
            <div class="stat-value">{{healthMetrics.restSuccessCount}}</div>
            <div class="stat-label">API OK</div>
          </div>
          <div class="stat-box">
            <div class="stat-value {{#if healthMetrics.restErrorCount}}error-value{{/if}}">{{healthMetrics.restErrorCount}}</div>
            <div class="stat-label">API Errors</div>
          </div>
          <div class="stat-box">
            <div class="stat-value">{{healthMetrics.reconnectAttempts}}</div>
            <div class="stat-label">Reconnects</div>
          </div>
        </div>
        <div class="diagnostics-detail">
          <div class="system-info-row">
            <span class="system-label">Last Success:</span>
            <span class="system-value">{{healthMetrics.lastRestSuccess}}</span>
          </div>
          <div class="system-info-row">
            <span class="system-label">Last Error:</span>
            <span class="system-value {{#if (neq healthMetrics.lastRestError 'None')}}error-text{{/if}}">{{healthMetrics.lastRestError}}</span>
          </div>
          {{#if healthMetrics.retryQueueSize}}
          <div class="system-info-row">
            <span class="system-label">Pending Retries:</span>
            <span class="system-value error-text">{{healthMetrics.retryQueueSize}} operations queued</span>
          </div>
          {{/if}}
        </div>

        {{!-- Field mapping debug info --}}
        {{#if fieldMappingInfo}}
        <h3 class="section-heading">Field Mapping</h3>
        <div class="diagnostics-detail">
          <div class="system-info-row">
            <span class="system-label">Adapter:</span>
            <span class="system-value">{{fieldMappingInfo.adapterType}} ({{fieldMappingInfo.systemId}})</span>
          </div>
          <div class="system-info-row">
            <span class="system-label">Character Type:</span>
            <span class="system-value">{{fieldMappingInfo.characterTypeSlug}}</span>
          </div>
        </div>
        {{/if}}

        {{!-- Sync Capability — what CAN pull vs what DOES (WS-4) --}}
        {{#if capability}}
        <h3 class="section-heading">Sync Capability</h3>
        {{#if capability.available}}
        <p class="config-hint">Compares what a Foundry actor exposes against what Chronicle currently syncs.{{#if capability.autoPicked}} Auto-picked <strong>{{capability.source.actorName}}</strong> (the first <code>{{capability.source.actorType}}</code> actor) — pick a different one below to inspect it.{{else}} Inspecting <strong>{{capability.source.actorName}}</strong> (type <code>{{capability.source.actorType}}</code>).{{/if}}</p>
        <div class="capability-actor-picker">
          <label for="capability-actor-select">Inspect actor:</label>
          <select id="capability-actor-select" class="config-select capability-actor-select">
            {{#each capability.actors}}
            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#if linked}} ✓ synced{{/if}}</option>
            {{/each}}
          </select>
        </div>
        <div class="diagnostics-detail">
          <div class="system-info-row"><span class="system-label">Synced:</span><span class="system-value">{{capability.summary.synced}} / {{capability.summary.totalDeclared}} declared</span></div>
          <div class="system-info-row"><span class="system-label">Collection-mapped (items):</span><span class="system-value">{{capability.summary.collectionMapped}}</span></div>
          <div class="system-info-row"><span class="system-label">Declared, unmapped:</span><span class="system-value">{{capability.summary.declaredUnmapped}}</span></div>
          <div class="system-info-row"><span class="system-label">Mapped, missing on actor:</span><span class="system-value">{{capability.summary.mappedMissing}}</span></div>
          <div class="system-info-row"><span class="system-label">Available, not mapped:</span><span class="system-value">{{capability.summary.availableUnmapped}}</span></div>
          <div class="system-info-row"><span class="system-label">Collections (items/effects):</span><span class="system-value">{{capability.summary.collectionsAvailable}}</span></div>
        </div>
        {{#if capability.gaps.length}}
        <div class="capability-gaps diagnostics-detail">
          {{#each capability.gaps}}
          <div class="system-info-row cap-{{status}}">
            <span class="system-label">{{status}}</span>
            <span class="system-value">{{label}}{{#if detail}} — {{detail}}{{/if}}</span>
          </div>
          {{/each}}
        </div>
        {{/if}}
        <div class="config-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-capability">
            <i class="fa-solid fa-clipboard-list"></i> Copy Capability Report
          </button>
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-capability-json">
            <i class="fa-solid fa-code"></i> Copy JSON
          </button>
          <span class="debug-copy-result" data-capability-result></span>
        </div>
        {{else}}
        <p class="config-hint">No representative actor available to sample{{#if capability.error}} ({{capability.error}}){{/if}}.</p>
        {{/if}}
        {{/if}}

        {{!-- Error log --}}
        {{#if hasErrors}}
        <h3 class="section-heading">Error Log</h3>
        <div class="error-log">
          {{#each errorLog}}
          <div class="log-entry log-error">
            <span class="log-time">{{timeFormatted}}</span>
            <span class="log-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <span class="log-message">{{method}} {{path}}{{#if status}} ({{status}}){{/if}}: {{message}}</span>
          </div>
          {{/each}}
        </div>
        {{/if}}

        <h3 class="section-heading">Recent Activity</h3>
        <div class="activity-log">
          {{#each activityLog}}
          <div class="log-entry log-{{type}}">
            <span class="log-time">{{this.timeFormatted}}</span>
            <span class="log-icon">
              {{#if (eq type "pull")}}<i class="fa-solid fa-download"></i>{{/if}}
              {{#if (eq type "push")}}<i class="fa-solid fa-upload"></i>{{/if}}
              {{#if (eq type "update")}}<i class="fa-solid fa-pen"></i>{{/if}}
              {{#if (eq type "link")}}<i class="fa-solid fa-link"></i>{{/if}}
              {{#if (eq type "unlink")}}<i class="fa-solid fa-unlink"></i>{{/if}}
              {{#if (eq type "connect")}}<i class="fa-solid fa-bolt"></i>{{/if}}
              {{#if (eq type "error")}}<i class="fa-solid fa-triangle-exclamation"></i>{{/if}}
            </span>
            <span class="log-message">{{message}}</span>
          </div>
          {{else}}
          <div class="log-empty">No recent activity.</div>
          {{/each}}
        </div>

        <div class="status-actions">
          <button type="button" data-action="clear-log" class="dashboard-btn btn-sm">
            <i class="fa-solid fa-trash"></i> Clear Log
          </button>
          <button type="button" data-action="open-settings" class="dashboard-btn btn-sm">
            <i class="fa-solid fa-gear"></i> Settings
          </button>
          {{#if (eq connectionState "disconnected")}}
          <button type="button" data-action="reconnect" class="dashboard-btn btn-sm">
            <i class="fa-solid fa-plug"></i> Reconnect
          </button>
          {{/if}}
        </div>

        {{!-- Diagnostic Bundle (troubleshooting — versions, health, logs, capability) --}}
        <h3 class="section-heading">Diagnostic Bundle</h3>
        <p class="config-hint">One copy-paste troubleshooting report — versions, connection health, sync status, capability, and recent activity/errors. Paste into a bug report or the admin AI.</p>
        <div class="config-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-diagnostic-bundle">
            <i class="fa-solid fa-clipboard-check"></i> Copy Diagnostic Bundle
          </button>
          <span class="debug-copy-result" data-bundle-result></span>
        </div>

        {{!-- System Debug Export --}}
        <h3 class="section-heading">System Debug Export</h3>
        <p class="config-hint">Copy a snapshot of your Foundry system data to the clipboard. Paste this into Claude AI to help build a Chronicle system adapter for your game system.</p>
        <div class="config-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-debug">
            <i class="fa-solid fa-clipboard"></i> Copy System Debug to Clipboard
          </button>
          <span class="debug-copy-result" data-debug-result></span>
        </div>

        {{!-- Calendar Diagnostics Export --}}
        <h3 class="section-heading">Calendar Diagnostics</h3>
        <p class="config-hint">{{localize "CHRONICLE.Dashboard.StatusTab.CopyCalendarDiagnosticsHint"}}</p>
        <div class="config-actions">
          <button type="button" class="dashboard-btn btn-sm" data-action="copy-calendar-diagnostics">
            <i class="fa-solid fa-stethoscope"></i> {{localize "CHRONICLE.Dashboard.StatusTab.CopyCalendarDiagnostics"}}
          </button>
          <span class="debug-copy-result" data-cal-diag-result></span>
        </div>
      </div>
    </div>

  </section>

  </div>{{!-- /.dashboard-body --}}
  {{/unless}}
</div>
